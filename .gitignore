# Ignore directories generated by Composer
/drush/contrib/
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/console/

# Ignore directories generated by nodejs
node_modules

# Ignore compiled them dist files
/web/themes/custom/**/dist/*

# Ignore sensitive information
#/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/local.settings.php
/web/sites/*/dev.settings.php
/web/sites/*/stage.settings.php
/web/sites/*/test.settings.php
/web/sites/*/prod.settings.php

# Ignore Drupal's file directories
/web/sites/*/files/
/private/
/tmp
/storage

# Ignore SimpleTest multi-site environment.
/web/sites/simpletest
/phantomjs*

# Ignore files generated by PhpStorm
/.idea/

# Ignore files generated by MacOS
.DS_Store

# Ignore sql exports
*.sql.gz
*.sql

# Ignore editor config file
/.editorconfig

# Ignore files produced by custom scripts
/exports
