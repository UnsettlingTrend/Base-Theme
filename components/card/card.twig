{# mdc Card Container #}
<article {{ attributes.addClass('mdc-card', 'mdc-card--' ~ variant|default('outlined')) }}>

  <a class="mdc-card__link" href="{{ url }}" title="Go to {{ title|render|striptags|trim }} {{ node.bundle|clean_class }}">

    {# Media Block #}
    {% if image %}
        <div class="mdc-card__media">
            {{ image }}
        </div>
    {% endif %}

    {# Content Area #}
    <div class="mdc-card__content">
        <h3 class="mdc-card__title">{{ title|render|striptags|trim }}</h3>

        {% if subhead %}
            <div class="mdc-card__supporting-text">
                {{ body }}
            </div>
        {% endif %}

    </div>

  </a>

</article>
