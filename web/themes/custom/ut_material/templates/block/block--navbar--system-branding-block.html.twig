{#
/**
 * @file
 * Theme override for the branding block in the navbar region.
 *
 * Overrides material_base's version of this same template suggestion to
 * drop the site logo — it's rendered separately, directly in
 * region--navbar.html.twig, next to the main menu's first link instead,
 * appearing only once #site-title-bar (where this block's site name lives)
 * scrolls completely out of view. See navigation.scss / theme.js for that
 * behavior. Keeping this override narrowly scoped to just removing the
 * {% if site_logo %} block (rather than, say, suppressing it with CSS)
 * avoids shipping an unused logo <img> in the title bar's markup.
 *
 * Available variables:
 * - site_logo: Logo for site as defined in Appearance or theme settings.
 * - site_name: Name for site as defined in Site information settings.
 * - site_slogan: Slogan for site as defined in Site information settings.
 */
#}

{% if site_name %}
  <div class="navbar-branding__title site-name">
    <a href="{{ path('<front>') }}" title="{{ 'Home'|t }}" rel="home">{{ site_name }}</a>
  </div>
{% endif %}
{% if site_slogan %}
  <div class="navbar-branding__slogan site-slogan">{{ site_slogan }}</div>
{% endif %}
