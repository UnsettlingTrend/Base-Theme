{# mdc Card Container #}
<article {{ attributes.addClass('mdc-card', 'mdc-card--' ~ variant|default('outlined')) }}>

    {# Media Block #}
    {% if image %}
        <div class="mdc-card__media">
            {{ image }}
        </div>
    {% endif %}

    {# Content Area #}
    <div class="mdc-card__content">
        <header>
            <h3 class="mdc-card__headline">{{ title }}</h3>
            {% if subhead %}
                <p class="mdc-card__subhead">{{ subhead }}</p>
            {% endif %}
        </header>

        {% if subhead %}
            <div class="mdc-card__supporting-text">
                {{ body }}
            </div>
        {% endif %}

        {# Action Area #}
        <footer class="mdc-card__actions">
            <a href="{{ url }}" class="mdc-button mdc-button--text">Read More</a>
        </footer>
    </div>
</article>
