{# tile-bg-image #}

{% set classes = [
  'tile-bg-image',
  modifier_classes ? modifier_classes,
  has_overlay ? 'has-overlay',
]|join(' ')|trim %}

<div class="{{ classes }}"{% if tile_image %} style="background-image: url({{ tile_image }});"{% endif %}{% if tile_image_alt %} role="img" aria-label="{{ tile_image_alt }}"{% endif %}>
  <div class="tile-bg-image__content">
    {% if tile_title %}
      <h1 class="tile-bg-image__title">{{ tile_title }}</h1>
    {% endif %}
    {% if tile_subtitle %}
      <div class="tile-bg-image__summary">{{ tile_subtitle }}</div>
    {% endif %}
  </div>
</div>
