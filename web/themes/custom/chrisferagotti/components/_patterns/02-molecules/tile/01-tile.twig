{#
/**
 * Available variables:
 * - tile_base_class - base classname of the wrapper
 * - tile_modifiers - array of modifiers to add to the base classname of the wrapper
 * - tile_blockname - blockname prepended to the base classname of the wrapper(s) and each component
 *
 * - tile_img_src - the actual image file location
 * - tile_img_alt - (optional) the alt text for screen readers and when the image cannot load
 * - tile_img_url - Url the image should link to. Defaults to tile_link_url
 * - tile_image_output_image_tag: whether to print the picture element or not
 *
 * - tile_copy_base_class - base classname of the copy wrapper - defaults to 'tile__copy'
 * - tile_copy_modifiers - array of modifiers to add to the base classname of the copy wrapper
 * - tile_copy_blockname - blockname prepended to the base classname of the copy wrapper
 *
 * - tile_title - the content of the title component
 * - tile_title_link - (optional) the url the title should link to. Defaults to tile_link_url.
 * - tile_title_base_class - base classname of the title component. Defaults to "title"
 * - tile_title_blockname - blockname to add to the base classname of the title - defaults to tile_base_class
 * - tile_title_modifiers - array of modifiers to add to the base classname of the title
 * - tile_title_link_base_class - base class to add to the title link - defaults to 'title-link'
 *
 * - tile_subtitle - the content of the subtitle component
 * - tile_subtitle_link - (optional) the url the subtitle should link to
 * - tile_subtitle_base_class - base classname of the subtitle component. Defaults to "subtitle"
 * - tile_subtitle_modifiers - array of modifiers to add to the base classname of the subtitle
 *
 * - tile_body - the content of the body component
 * - tile_body_base_class - base classname of the body component. Defaults to "body"
 * - tile_body_modifiers - array of modifiers to add to the base classname of the body
 *
 * - tile_link_text - the content of the link component
 * - tile_link_url - the url the link should link to
 * - tile_link_base_class - base classname of the link component. Defaults to "link"
 * - tile_link_blockname - override link blockname. Defaults to tile_base_class
 * - tile_link_attributes - array of attribute,value pairs for the link attribute
 * - tile_link_modifiers - array of modifiers to add to the base classname of the link
 *
 * - tile_button_content - the content of the button component
 * - tile_button_url - the url the button should link to
 * - tile_button_base_class - base classname of the button component. Defaults to "button"
 * - tile_button_attributes - array of attribute,value pairs for the button attribute
 * - tile_button_modifiers - array of modifiers to add to the base classname of the button
 */
#}
{% set tile_base_class = 'tile' %}

<div {{ bem(tile_base_class, (tile_modifiers), tile_blockname) }}>
  {% block tile_img %}
    {% if tile_img_src %}
      {% include "@atoms/04-images/00-image/responsive-image.twig" with {
        "img_url": tile_img_url|default(tile_link_url),
        "img_src": tile_img_src,
        "img_alt": tile_img_alt,
        "image_link_blockname": tile_base_class,
        "image_blockname": tile_base_class,
        "output_image_tag": tile_image_output_image_tag,
      } %}
    {% endif %}
  {% endblock %}
  <div {{ bem(tile_copy_base_class|default('tile__copy'), (tile_copy_modifiers), tile_copy_blockname) }}>
    {% if tile_title %}
      {{ title_prefix }}
      {% include "@atoms/02-text/00-headings/_heading.twig" with {
        "heading_level": 2,
        "heading": tile_title,
        "heading_url": tile_title_link|default(tile_link_url),
        "heading_blockname": tile_title_blockname|default(tile_base_class),
        "heading_modifiers": tile_title_modifiers,
        "heading_link_base_class": tile_title_link_base_class|default('title-link'),
        "heading_link_blockname": tile_base_class,
        "heading_base_class": tile_title_base_class|default('title'),
      } %}
      {{ title_suffix }}
    {% endif %}

    {% block tile_info %}
    {% endblock %}

    {% if tile_subtitle %}
      {% include "@atoms/02-text/00-headings/_heading.twig" with {
        "heading_level": 3,
        "heading": tile_subtitle,
        "heading_url": tile_subtitle_link,
        "heading_blockname": tile_subtitle_blockname|default(tile_base_class),
        "heading_modifiers": tile_subtitle_modifiers,
        "heading_base_class": tile_subtitle_base_class|default('subtitle'),
      } %}
    {% endif %}
    {% if tile_body %}
      {% include "@atoms/02-text/text/01-paragraph.twig" with {
        "paragraph_content": tile_body,
        "paragraph_blockname": tile_body_base_class|default(tile_base_class),
        "paragraph_modifiers": tile_body_modifiers,
        "paragraph_base_class": tile_body_base_class|default('body'),
      } %}
    {% endif %}
    {% if tile_link_url %}
      {% include "@atoms/01-links/link/link.twig" with {
        "link_content": tile_link_text,
        "link_url": tile_link_url,
        "link_attributes": tile_link_attributes,
        "link_blockname": tile_link_blockname|default(tile_base_class),
        "link_base_class": tile_link_base_class|default('link'),
      } %}
    {% endif %}
    {% if tile_button_url %}
      {% include "@atoms/06-buttons/01-button.twig" with {
        "button_content": tile_button_content,
        "button_url": tile_button_url,
        "button_base_class": tile_button_base_class|default('button'),
        "button_attributes": tile_button_attributes,
        "button_modifiers": tile_button_modifiers,
        "button_blockname": tile_blockname|default(tile_base_class),
      } %}
    {% endif %}
  </div><!-- copy -->
</div>
