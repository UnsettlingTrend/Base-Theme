{% extends "@base/layouts/grid/00-grid.twig" %}

{% block grid_content %}
  {% for tile in tiles %}
    {% include "@molecules/tile/01-tile.twig" with {
      "tile_blockname": tile.blockname,
      "tile_modifiers": tile.tile_modifiers,
      "tile_img_src": tile.tile_img_src,
      "tile_title": tile.tile_title,
      "tile_subtitle": tile.tile_subtitle,
      "tile_body": tile.tile_body,
      "tile_link_url": tile.tile_link_url,
      "tile_image_output_image_tag": tile.tile_image_output_image_tag,
    } %}
  {% endfor %}
{% endblock %}
