{#
/**
 * @file
 * Default theme implementation to display a Robinhood Order entity.
 *
 * Available variables:
 * - robinhood_order: The RobinhoodOrder entity.
 * - content: All rendered field elements, keyed by field name.
 * - view_mode: The current view mode.
 * - page: TRUE if this is the full-page canonical view.
 *
 * @see template_preprocess_robinhood_order()
 *
 * @ingroup themeable
 */
#}
<article{{ attributes.addClass('robinhood-order', 'robinhood-order--' ~ view_mode|clean_class) }}>

  {% if page %}
    {# Title is rendered by the page layout when viewed as a full page. #}
  {% else %}
    <h2 class="robinhood-order__title">
      <a href="{{ robinhood_order.toUrl() }}">
        {{ robinhood_order.get('symbol').value }} — {{ robinhood_order.get('order_side').value|capitalize }}
      </a>
    </h2>
  {% endif %}

  <div class="robinhood-order__content">
    {% for key, field in content %}
      {% if field|render is not empty %}
        <div class="robinhood-order__field robinhood-order__field--{{ key|clean_class }}">
          {{ field }}
        </div>
      {% endif %}
    {% endfor %}
  </div>

</article>
