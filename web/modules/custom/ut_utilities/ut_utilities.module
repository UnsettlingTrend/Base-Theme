<?php

/**
 * @file
 * Primary module hooks for UT Utilities.
 */

/**
 * Implements hook_link_alter().
 *
 * Appends a 'destination' query parameter to every rendered link that points
 * at the login form (menu links, "Log in" links in custom templates, etc.),
 * so that after logging in the user lands back on the page they clicked
 * from, instead of on their profile page (core's default post-login
 * redirect). Anonymous users redirected to the login form by an
 * access-denied page already get this from core; this covers the remaining
 * case of a plain link to /user/login clicked directly.
 *
 * Leaves an already-present destination alone (e.g. a link built with an
 * intentionally different one, like race_day_preprocess_race()'s
 * login_to_register_url) rather than overwriting it.
 *
 * @see ut_utilities_preprocess_menu()
 */
function ut_utilities_link_alter(array &$variables): void {
  $url = $variables['url'];
  if (!$url->isRouted() || $url->getRouteName() !== 'user.login' || isset($variables['options']['query']['destination'])) {
    return;
  }

  $variables['options']['query']['destination'] = \Drupal::destination()->get();
}

/**
 * Implements hook_preprocess_menu().
 *
 * Companion to ut_utilities_link_alter() above. That hook computes the
 * correct per-request 'destination' value, but a rendered menu is cached
 * (block render cache, and internal_page_cache for anonymous users) without
 * varying by the current path — so whichever page happens to prime the cache
 * first would "freeze" its destination into the login link for every other
 * page until the cache is cleared. Verified this actually happens: after a
 * cache clear, /blog and /recipes both served a login link pointing back at
 * "/" (whichever page the account-menu block was first rendered for), not
 * their own path, until the 'url.path' cache context was added here.
 *
 * Declaring 'url.path' forces the cached menu markup to vary per page,
 * matching what the destination value itself depends on.
 */
function ut_utilities_preprocess_menu(array &$variables): void {
  if (_ut_utilities_menu_has_login_link($variables['items'] ?? [])) {
    $variables['#cache']['contexts'][] = 'url.path';
  }
}

/**
 * Recursively checks a menu item tree for a link to the login form.
 */
function _ut_utilities_menu_has_login_link(array $items): bool {
  foreach ($items as $item) {
    $url = $item['url'] ?? NULL;
    if ($url instanceof \Drupal\Core\Url && $url->isRouted() && $url->getRouteName() === 'user.login') {
      return TRUE;
    }
    if (!empty($item['below']) && _ut_utilities_menu_has_login_link($item['below'])) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Implements hook_ENTITY_TYPE_presave() for media.
 *
 * The image media bundle's own field_title (added so every media bundle has
 * a usable "title", not just image) duplicated field_media_image's own
 * built-in Title sub-field (an image field property — the "Title" input
 * that appears alongside "Alt" when a field's title_field setting is
 * enabled, per field.field.media.image.field_media_image.yml). That's two
 * "Title" inputs asking for the same thing on the same form. field_title is
 * now hidden from every image-bundle form display
 * (core.entity_form_display.media.image.{default,race_team_icon}.yml —
 * media_library's already had it hidden); this keeps it populated anyway by
 * mirroring field_media_image's own title onto it on save, so field_title
 * stays usable for image media too (e.g. for code/views that read it
 * generically across bundles) without asking the editor twice.
 */
function ut_utilities_media_presave(\Drupal\media\MediaInterface $media): void {
  if ($media->bundle() !== 'image' || !$media->hasField('field_media_image') || !$media->hasField('field_title')) {
    return;
  }

  $title = $media->get('field_media_image')->title ?? '';
  if ($title !== '') {
    $media->set('field_title', $title);
  }
}

/**
 * Implements hook_element_info_alter().
 *
 * Appends a #process callback to the 'name' render element (contrib "Name"
 * module — provides the site's split first/middle/last name field, used on
 * both /user/register and the user edit form) so its per-component
 * sub-fields are legible at rest, not just once focused.
 *
 * @see _ut_utilities_name_element_persistent_helper_text()
 */
function ut_utilities_element_info_alter(array &$types): void {
  if (isset($types['name'])) {
    $types['name']['#process'][] = '_ut_utilities_name_element_persistent_helper_text';
  }
}

/**
 * #process callback: makes 'name' element sub-field helper text persistent.
 *
 * This site's user name field (core.entity_form_display.user.user.default.yml)
 * is configured with `title_display: description` for every component
 * (Given, Middle name(s), Family, etc.). Per
 * \Drupal\name\Element\Name::applyTitleDisplay()'s 'description' case, that
 * setting hides each sub-field's real <label> (#title_display =>
 * 'invisible') and moves the label text into #description instead. Our
 * theme renders #description as MDC's helper text
 * (material_base_mdc/templates/form/form-element--textfield.html.twig),
 * which by Material Design's own default is *not* persistent — shown only
 * once the field is focused. That's exactly why "Given"/"Middle
 * name(s)"/"Family" were invisible until clicked into: the only thing
 * telling the user what a field is for was hidden at rest.
 *
 * Setting the `helper-text-persistent` attribute is this theme's own
 * opt-in for always-visible helper text —
 * material_base_mdc.theme's template_preprocess_form_element() reads it
 * straight off #attributes, so this only needs to run once the "name"
 * element's own #process callback has expanded #components into actual
 * child form elements (appended after it in ut_utilities_element_info_alter()
 * above, rather than reimplementing the label-substitution logic here).
 */
function _ut_utilities_name_element_persistent_helper_text(array $element, \Drupal\Core\Form\FormStateInterface $form_state, array &$complete_form): array {
  foreach (\Drupal\Core\Render\Element::children($element) as $key) {
    if (($element[$key]['#title_display'] ?? NULL) === 'invisible' && !empty($element[$key]['#description'])) {
      $element[$key]['#attributes']['helper-text-persistent'] = TRUE;
    }
  }
  return $element;
}

/**
 * Returns all area-of-interest definitions collected from every module.
 *
 * Results are sorted by weight then label.
 *
 * @return array<string, array{label: string, roles: string[], weight?: int, description?: string}>
 */
/**
 * Implements hook_form_FORM_ID_alter() for user_register_form.
 *
 * Injects the Areas of Interest checkboxes during account creation only.
 * After registration the dedicated tab (/user/{user}/areas-of-interest) is
 * the canonical place to manage this field.
 */
function ut_utilities_form_user_register_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $areas = ut_utilities_get_areas_of_interest();
  if (empty($areas)) {
    return;
  }

  $options = [];
  foreach ($areas as $key => $info) {
    $options[$key] = $info['label'];
  }
  $default_areas = \Drupal::config('ut_utilities.settings')->get('default_areas_of_interest') ?? [];

  $form['areas_of_interest'] = [
    '#type' => 'checkboxes',
    '#title' => t('Areas of Interest'),
    '#options' => $options,
    '#default_value' => $default_areas,
    '#weight' => 10,
    '#after_build' => ['\Drupal\ut_utilities\Form\AreasOfInterestForm::addOptionDescriptions'],
    '#areas' => $areas,
  ];
  // Must run now, before this element enters Drupal's form build pipeline —
  // see AreasOfInterestForm::applyEditRestrictions() for why #after_build
  // is too late for #disabled to have any effect.
  \Drupal\ut_utilities\Form\AreasOfInterestForm::applyEditRestrictions($areas, $form['areas_of_interest']);

  // Rejects a tampered submission for any permission-restricted area (see
  // AreasOfInterestForm::validateRestrictedAreas()) — shared with the
  // Areas of Interest profile form so the same rule applies wherever these
  // checkboxes appear.
  $form['#validate'][] = ['\Drupal\ut_utilities\Form\AreasOfInterestForm', 'validateRestrictedAreas'];

  // Runs after the entity is saved so the new account already has an ID.
  $form['actions']['submit']['#submit'][] = 'ut_utilities_register_form_submit';
}

/**
 * Implements hook_form_FORM_ID_alter() for user_admin_settings.
 *
 * Adds a config-backed "Default Areas of Interest" field to
 * /admin/config/people/accounts, letting admins choose which Areas of
 * Interest are pre-selected on the new-user form (self-registration and
 * admin-created accounts both use user_register_form).
 */
function ut_utilities_form_user_admin_settings_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $config = \Drupal::config('ut_utilities.settings');

  // "Allow Social API logins to complete registration" — inserted inside the
  // core "Registration and cancellation" details element, between "Who can
  // register accounts?" and "Require email verification...".
  $allow_social_api_registration = $config->get('allow_social_api_registration') ?? FALSE;

  $social_api_element = [
    '#type' => 'checkbox',
    '#title' => t('Allow Social API logins to complete registration'),
    '#description' => t('New user login attempts that use the Social API Single Sign-On options on the site will be allowed to fully register on the site, regardless of what "Who can register accounts?" is set to.'),
    '#default_value' => $allow_social_api_registration,
  ];
  if (isset($form['registration_cancellation'])) {
    $form['registration_cancellation'] = _ut_utilities_array_insert_before(
      $form['registration_cancellation'],
      'user_email_verification',
      'ut_utilities_allow_social_api_registration',
      $social_api_element
    );
  }

  // "Default Areas of Interest" — inserted between the core
  // "Anonymous users" and "Registration and cancellation" details elements.
  $areas = ut_utilities_get_areas_of_interest();
  if (!empty($areas)) {
    $options = [];
    foreach ($areas as $key => $info) {
      $options[$key] = $info['label'];
    }
    $default_areas = $config->get('default_areas_of_interest') ?? [];

    $areas_element = [
      '#type' => 'details',
      '#title' => t('Default Areas of Interest'),
      '#open' => TRUE,
    ];
    $areas_element['default_areas_of_interest'] = [
      '#type' => 'checkboxes',
      '#title' => t('Default Areas of Interest'),
      '#title_display' => 'invisible',
      '#description' => t('Areas of Interest checked here will be automatically selected for new user accounts upon registration.'),
      '#options' => $options,
      '#default_value' => $default_areas,
    ];

    $form = _ut_utilities_array_insert_before(
      $form,
      'registration_cancellation',
      'ut_utilities_default_areas_of_interest',
      $areas_element
    );
  }

  $form['#submit'][] = 'ut_utilities_user_admin_settings_submit';
}

/**
 * Returns a copy of $array with $new_value inserted under $new_key.
 *
 * Inserted directly before $before_key so it lands between two existing
 * elements regardless of #weight, matching Form API's fallback of sorting
 * equal-weight elements by their array order. Appends to the end if
 * $before_key isn't found.
 */
function _ut_utilities_array_insert_before(array $array, string $before_key, string $new_key, array $new_value): array {
  $position = array_search($before_key, array_keys($array), TRUE);
  if ($position === FALSE) {
    $array[$new_key] = $new_value;
    return $array;
  }

  return array_slice($array, 0, $position, TRUE)
    + [$new_key => $new_value]
    + array_slice($array, $position, NULL, TRUE);
}

/**
 * Submit handler for ut_utilities' fields on user_admin_settings.
 */
function ut_utilities_user_admin_settings_submit(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $config = \Drupal::configFactory()->getEditable('ut_utilities.settings');

  if ($form_state->hasValue('default_areas_of_interest')) {
    $raw = $form_state->getValue('default_areas_of_interest') ?? [];
    $selected = array_values(array_keys(array_filter($raw)));
    $config->set('default_areas_of_interest', $selected);
  }

  if ($form_state->hasValue('ut_utilities_allow_social_api_registration')) {
    $config->set('allow_social_api_registration', (bool) $form_state->getValue('ut_utilities_allow_social_api_registration'));
  }

  $config->save();
}

/**
 * Submit handler for the user registration form.
 */
function ut_utilities_register_form_submit(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  $areas = ut_utilities_get_areas_of_interest();

  /** @var \Drupal\user\UserInterface $account */
  $account = $form_state->getFormObject()->getEntity();
  $uid = $account->id();

  $raw = $form_state->getValue('areas_of_interest') ?? [];
  $new_selections = array_values(array_keys(array_filter($raw)));

  \Drupal::service('user.data')->set('ut_utilities', $uid, 'areas_of_interest', $new_selections);

  $changed = FALSE;
  foreach ($new_selections as $key) {
    foreach ($areas[$key]['roles'] ?? [] as $role_id) {
      if (!$account->hasRole($role_id)) {
        $account->addRole($role_id);
        $changed = TRUE;
      }
    }
  }

  if ($changed) {
    $account->save();
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for user.
 *
 * Applies the configured default Areas of Interest (and their associated
 * roles) to every newly created account. This is the only path that applies
 * defaults for accounts created outside user_register_form — most notably
 * Social Auth SSO registration, which creates users directly via
 * \Drupal\social_auth\User\UserManager::createUser() and never touches that
 * form or ut_utilities_register_form_submit(). For accounts created through
 * the form, that handler runs immediately after this and overwrites
 * areas_of_interest with whatever was actually submitted, making this a
 * safe, redundant no-op there.
 */
function ut_utilities_user_insert(\Drupal\Core\Entity\EntityInterface $account): void {
  $defaults = \Drupal::config('ut_utilities.settings')->get('default_areas_of_interest') ?? [];
  if (empty($defaults)) {
    return;
  }

  $areas = ut_utilities_get_areas_of_interest();
  $uid = $account->id();

  \Drupal::service('user.data')->set('ut_utilities', $uid, 'areas_of_interest', $defaults);

  $changed = FALSE;
  foreach ($defaults as $key) {
    foreach ($areas[$key]['roles'] ?? [] as $role_id) {
      if (!$account->hasRole($role_id)) {
        $account->addRole($role_id);
        $changed = TRUE;
      }
    }
  }

  if ($changed) {
    $account->save();
  }
}

/**
 * Returns all area-of-interest definitions collected from every module.
 *
 * Results are sorted by weight then label.
 *
 * @return array<string, array{label: string, roles: string[], weight?: int, description?: string}>
 */
/**
 * Implements hook_menu_local_tasks_alter().
 *
 * Ensures the user profile tabs appear in the desired order:
 * View → Edit → Areas of Interest → Submissions → Social auth profiles → Devel
 */
function ut_utilities_menu_local_tasks_alter(array &$data, string $route_name): void {
  $user_routes = [
    'entity.user.canonical',
    'entity.user.edit_form',
    'ut_utilities.user.areas_of_interest',
    'entity.webform_submission.user',
    'social_auth.user.profiles',
  ];

  if (!in_array($route_name, $user_routes, TRUE)) {
    return;
  }

  // $data['tabs'][0] is keyed by local task plugin ID, which matches the
  // route name for standard tasks.
  $weights = [
    'entity.user.edit_form'               => 1,
    'ut_utilities.user.areas_of_interest' => 2,
    'entity.webform_submission.user'      => 3,
    'social_auth.user.profiles'           => 4,
  ];

  foreach ($weights as $plugin_id => $weight) {
    if (isset($data['tabs'][0][$plugin_id])) {
      $data['tabs'][0][$plugin_id]['#weight'] = $weight;
    }
  }
}

/**
 * Implements hook_ut_utilities_areas_of_interest_info().
 *
 * Checking this grants the 'content_creator' role (config/install/
 * user.role.content_creator.yml) — kept in sync in both directions:
 * selecting/deselecting the area here grants/revokes the role (the existing
 * generic behavior in AreasOfInterestForm::submitForm() /
 * ut_utilities_register_form_submit(), driven by this 'roles' key), and
 * ut_utilities_user_update() below does the reverse — if 'content_creator'
 * is granted or removed some other way (e.g. an admin editing roles
 * directly on /admin/people), the stored area selection is updated to
 * match. Per `edit_permission`, only users with the 'assign content
 * creation area of interest' permission (see ut_utilities.permissions.yml)
 * may change its value for any account; everyone else sees it rendered
 * #disabled, and a tampered submission is rejected in validation. See
 * AreasOfInterestForm::addOptionDescriptions() and ::validateRestrictedAreas(),
 * shared by both the profile form and the registration form.
 */
function ut_utilities_ut_utilities_areas_of_interest_info(): array {
  return [
    'content_creation' => [
      'label'            => t('Content Creation'),
      'description'      => t('Interested in creating content for the site (articles, recipes, and the like).'),
      'roles'            => ['content_creator'],
      'weight'           => 0,
      'edit_permission'  => 'assign content creation area of interest',
    ],
  ];
}

/**
 * Implements hook_ENTITY_TYPE_update() for user.
 *
 * The reverse direction of AreasOfInterestForm::submitForm() /
 * ut_utilities_register_form_submit(): those handle "area selected ->
 * role granted"; this handles "role granted/revoked (by ANY means, not
 * just the Areas of Interest form) -> area selected to match". Generic
 * across every area with a non-empty 'roles' list (not just
 * 'content_creation'), same as the forward direction already is. An area
 * that lists more than one role is treated as selected only once the user
 * holds ALL of them, and deselected as soon as any one is missing.
 *
 * Only writes to the user.data store, never re-saves $account — this hook
 * fires mid-save, and doing so would recurse.
 */
function ut_utilities_user_update(\Drupal\Core\Entity\EntityInterface $account): void {
  $old_roles = $account->original?->getRoles() ?? [];
  $new_roles = $account->getRoles();
  if ($old_roles === $new_roles) {
    return;
  }

  $areas = ut_utilities_get_areas_of_interest();
  $uid = $account->id();
  $user_data = \Drupal::service('user.data');
  $selections = $user_data->get('ut_utilities', $uid, 'areas_of_interest') ?? [];

  $changed = FALSE;
  foreach ($areas as $key => $info) {
    $area_roles = $info['roles'] ?? [];
    if (empty($area_roles)) {
      // Nothing to sync from for an area with no linked roles.
      continue;
    }
    $has_all_roles = !array_diff($area_roles, $new_roles);
    $is_selected = in_array($key, $selections, TRUE);

    if ($has_all_roles && !$is_selected) {
      $selections[] = $key;
      $changed = TRUE;
    }
    elseif (!$has_all_roles && $is_selected) {
      $selections = array_values(array_diff($selections, [$key]));
      $changed = TRUE;
    }
  }

  if ($changed) {
    $user_data->set('ut_utilities', $uid, 'areas_of_interest', $selections);
  }
}

/**
 * Returns all area-of-interest definitions collected from every module.
 *
 * Results are sorted by weight then label.
 *
 * @return array<string, array{label: string, roles: string[], weight?: int, description?: string}>
 */
function ut_utilities_get_areas_of_interest(): array {
  $areas = \Drupal::moduleHandler()->invokeAll('ut_utilities_areas_of_interest_info');
  \Drupal::moduleHandler()->alter('ut_utilities_areas_of_interest_info', $areas);
  uasort($areas, function (array $a, array $b): int {
    $w = ($a['weight'] ?? 0) <=> ($b['weight'] ?? 0);
    return $w !== 0 ? $w : strcmp($a['label'], $b['label']);
  });
  return $areas;
}
