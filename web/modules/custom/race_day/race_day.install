<?php

/**
 * @file
 * Install, update, and uninstall functions for the Race Day module.
 */

/**
 * Implements hook_schema().
 *
 * Additional non-entity tables. Entity tables (race, race_leg, race_assignment)
 * are auto-created by the entity API from baseFieldDefinitions.
 */
function race_day_schema(): array {
  $schema['race_day_location_log'] = [
    'description' => 'Stores a historical log of runner GPS pings for replay and analysis.',
    'fields' => [
      'lid' => [
        'description' => 'Primary key.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'assignment_id' => [
        'description' => 'The race_assignment entity ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'lat' => [
        'description' => 'Latitude.',
        'type' => 'numeric',
        'precision' => 10,
        'scale' => 7,
        'not null' => TRUE,
      ],
      'lng' => [
        'description' => 'Longitude.',
        'type' => 'numeric',
        'precision' => 10,
        'scale' => 7,
        'not null' => TRUE,
      ],
      'speed' => [
        'description' => 'Speed in mph.',
        'type' => 'numeric',
        'precision' => 6,
        'scale' => 2,
        'not null' => FALSE,
      ],
      'recorded' => [
        'description' => 'Unix timestamp of this GPS ping.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['lid'],
    'indexes' => [
      'assignment' => ['assignment_id'],
      'recorded' => ['recorded'],
    ],
  ];

  return $schema;
}

/**
 * Rename 'Race Coordinator' role to 'Race Day Coordinator' and add 'Race Day User' role.
 */
function race_day_update_10001(): void {
  $config_factory = \Drupal::configFactory();

  // Rename race_coordinator → race_day_coordinator, preserving user assignments.
  $old_role = \Drupal::entityTypeManager()->getStorage('user_role')->load('race_coordinator');
  if ($old_role) {
    // Re-assign users before deleting the old role.
    $uids = \Drupal::entityQuery('user')
      ->condition('roles', 'race_coordinator')
      ->accessCheck(FALSE)
      ->execute();

    $old_role->delete();
  }

  // Import new coordinator role from config.
  $coordinator_config = \Drupal::service('config.installer')
    ->installDefaultConfig('module', 'race_day');

  // Create the role directly if installDefaultConfig doesn't cover it.
  if (!\Drupal::entityTypeManager()->getStorage('user_role')->load('race_day_coordinator')) {
    \Drupal\user\Entity\Role::create([
      'id' => 'race_day_coordinator',
      'label' => 'Race Day Coordinator',
      'weight' => 3,
      'permissions' => [
        'administer race_day',
        'manage race day groups',
        'manage race_day races',
        'update race_day location',
        'view all race day groups',
        'view race_day content',
      ],
    ])->save();
  }

  // Re-assign affected users to the renamed role.
  if (!empty($uids)) {
    foreach (\Drupal::entityTypeManager()->getStorage('user')->loadMultiple($uids) as $user) {
      $user->addRole('race_day_coordinator');
      $user->save();
    }
  }

  // Delete old coordinator actions and create new ones.
  foreach (['user_add_role_action.race_coordinator', 'user_remove_role_action.race_coordinator'] as $action_id) {
    $action = $config_factory->getEditable('system.action.' . $action_id);
    if (!$action->isNew()) {
      $action->delete();
    }
  }

  // Create Race Day User role if it doesn't exist.
  if (!\Drupal::entityTypeManager()->getStorage('user_role')->load('race_day_user')) {
    \Drupal\user\Entity\Role::create([
      'id' => 'race_day_user',
      'label' => 'Race Day User',
      'weight' => 4,
      'permissions' => ['view race_day content'],
    ])->save();
  }

  // Import the new action configs.
  $config_path = \Drupal::service('extension.list.module')->getPath('race_day') . '/config/install';
  $source = new \Drupal\Core\Config\FileStorage($config_path);
  $config_storage = \Drupal::service('config.storage');
  foreach ([
    'system.action.user_add_role_action.race_day_coordinator',
    'system.action.user_remove_role_action.race_day_coordinator',
    'system.action.user_add_role_action.race_day_user',
    'system.action.user_remove_role_action.race_day_user',
  ] as $config_name) {
    if ($data = $source->read($config_name)) {
      $config_storage->write($config_name, $data);
    }
  }
}

/**
 * Install the Race teaser view mode and its display configuration.
 */
function race_day_update_10002(): void {
  $config_factory = \Drupal::configFactory();
  $module_path = \Drupal::service('extension.list.module')->getPath('race_day');
  $config_dir = $module_path . '/config/install';

  foreach ([
    'core.entity_view_mode.race.teaser',
    'core.entity_view_display.race.race.teaser',
  ] as $config_name) {
    if ($config_factory->get($config_name)->isNew()) {
      $data = \Symfony\Component\Yaml\Yaml::parse(file_get_contents("$config_dir/$config_name.yml"));
      $config_factory->getEditable($config_name)->setData($data)->save();
    }
  }
}

/**
 * Rename 'Race Day User' role to 'Race Day Runner', preserving user assignments.
 */
function race_day_update_10003(): void {
  $config_factory = \Drupal::configFactory();

  // Capture affected users before deleting the old role.
  $uids = \Drupal::entityQuery('user')
    ->condition('roles', 'race_day_user')
    ->accessCheck(FALSE)
    ->execute();

  $old_role = \Drupal::entityTypeManager()->getStorage('user_role')->load('race_day_user');
  if ($old_role) {
    $old_role->delete();
  }

  // Create the new role directly, in case config sync/install hasn't run yet.
  if (!\Drupal::entityTypeManager()->getStorage('user_role')->load('race_day_runner')) {
    \Drupal\user\Entity\Role::create([
      'id' => 'race_day_runner',
      'label' => 'Race Day Runner',
      'weight' => 4,
      'permissions' => [
        'create race teams',
        'request to join race team',
        'review own race team requests',
        'update race_day location',
        'view all race team names',
        'view race_day content',
        'view race_day races admin listing',
      ],
    ])->save();
  }

  // Re-assign affected users to the renamed role.
  if (!empty($uids)) {
    foreach (\Drupal::entityTypeManager()->getStorage('user')->loadMultiple($uids) as $user) {
      $user->addRole('race_day_runner');
      $user->save();
    }
  }

  // Delete old role actions and create new ones.
  foreach (['user_add_role_action.race_day_user', 'user_remove_role_action.race_day_user'] as $action_id) {
    $action = $config_factory->getEditable('system.action.' . $action_id);
    if (!$action->isNew()) {
      $action->delete();
    }
  }

  // Import the new action configs.
  $config_path = \Drupal::service('extension.list.module')->getPath('race_day') . '/config/install';
  $source = new \Drupal\Core\Config\FileStorage($config_path);
  $config_storage = \Drupal::service('config.storage');
  foreach ([
    'system.action.user_add_role_action.race_day_runner',
    'system.action.user_remove_role_action.race_day_runner',
  ] as $config_name) {
    if ($data = $source->read($config_name)) {
      $config_storage->write($config_name, $data);
    }
  }
}

/**
 * Implements hook_uninstall().
 */
function race_day_uninstall(): void {
  \Drupal::state()->deleteMultiple([
    'race_day.last_cleanup',
  ]);
}
