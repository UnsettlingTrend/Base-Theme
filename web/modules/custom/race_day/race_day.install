<?php

/**
 * @file
 * Install, update, and uninstall functions for the Race Day module.
 */

/**
 * Implements hook_schema().
 *
 * Additional non-entity tables. Entity tables (race, race_leg, race_assignment)
 * are auto-created by the entity API from baseFieldDefinitions.
 */
function race_day_schema(): array {
  $schema['race_day_location_log'] = [
    'description' => 'Stores a historical log of runner GPS pings for replay and analysis.',
    'fields' => [
      'lid' => [
        'description' => 'Primary key.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'assignment_id' => [
        'description' => 'The race_assignment entity ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'lat' => [
        'description' => 'Latitude.',
        'type' => 'numeric',
        'precision' => 10,
        'scale' => 7,
        'not null' => TRUE,
      ],
      'lng' => [
        'description' => 'Longitude.',
        'type' => 'numeric',
        'precision' => 10,
        'scale' => 7,
        'not null' => TRUE,
      ],
      'speed' => [
        'description' => 'Speed in mph.',
        'type' => 'numeric',
        'precision' => 6,
        'scale' => 2,
        'not null' => FALSE,
      ],
      'recorded' => [
        'description' => 'Unix timestamp of this GPS ping.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['lid'],
    'indexes' => [
      'assignment' => ['assignment_id'],
      'recorded' => ['recorded'],
    ],
  ];

  return $schema;
}

/**
 * Rename 'Race Coordinator' role to 'Race Day Coordinator' and add 'Race Day User' role.
 */
function race_day_update_10001(): void {
  $config_factory = \Drupal::configFactory();

  // Rename race_coordinator → race_day_coordinator, preserving user assignments.
  $old_role = \Drupal::entityTypeManager()->getStorage('user_role')->load('race_coordinator');
  if ($old_role) {
    // Re-assign users before deleting the old role.
    $uids = \Drupal::entityQuery('user')
      ->condition('roles', 'race_coordinator')
      ->accessCheck(FALSE)
      ->execute();

    $old_role->delete();
  }

  // Import new coordinator role from config.
  $coordinator_config = \Drupal::service('config.installer')
    ->installDefaultConfig('module', 'race_day');

  // Create the role directly if installDefaultConfig doesn't cover it.
  if (!\Drupal::entityTypeManager()->getStorage('user_role')->load('race_day_coordinator')) {
    \Drupal\user\Entity\Role::create([
      'id' => 'race_day_coordinator',
      'label' => 'Race Day Coordinator',
      'weight' => 3,
      'permissions' => [
        'administer race_day',
        'manage race day groups',
        'manage race_day races',
        'update race_day location',
        'view all race day groups',
        'view race_day content',
      ],
    ])->save();
  }

  // Re-assign affected users to the renamed role.
  if (!empty($uids)) {
    foreach (\Drupal::entityTypeManager()->getStorage('user')->loadMultiple($uids) as $user) {
      $user->addRole('race_day_coordinator');
      $user->save();
    }
  }

  // Delete old coordinator actions and create new ones.
  foreach (['user_add_role_action.race_coordinator', 'user_remove_role_action.race_coordinator'] as $action_id) {
    $action = $config_factory->getEditable('system.action.' . $action_id);
    if (!$action->isNew()) {
      $action->delete();
    }
  }

  // Create Race Day User role if it doesn't exist.
  if (!\Drupal::entityTypeManager()->getStorage('user_role')->load('race_day_user')) {
    \Drupal\user\Entity\Role::create([
      'id' => 'race_day_user',
      'label' => 'Race Day User',
      'weight' => 4,
      'permissions' => ['view race_day content'],
    ])->save();
  }

  // Import the new action configs.
  $config_path = \Drupal::service('extension.list.module')->getPath('race_day') . '/config/install';
  $source = new \Drupal\Core\Config\FileStorage($config_path);
  $config_storage = \Drupal::service('config.storage');
  foreach ([
    'system.action.user_add_role_action.race_day_coordinator',
    'system.action.user_remove_role_action.race_day_coordinator',
    'system.action.user_add_role_action.race_day_user',
    'system.action.user_remove_role_action.race_day_user',
  ] as $config_name) {
    if ($data = $source->read($config_name)) {
      $config_storage->write($config_name, $data);
    }
  }
}

/**
 * Install the Race teaser view mode and its display configuration.
 */
function race_day_update_10002(): void {
  $config_factory = \Drupal::configFactory();
  $module_path = \Drupal::service('extension.list.module')->getPath('race_day');
  $config_dir = $module_path . '/config/install';

  foreach ([
    'core.entity_view_mode.race.teaser',
    'core.entity_view_display.race.race.teaser',
  ] as $config_name) {
    if ($config_factory->get($config_name)->isNew()) {
      $data = \Symfony\Component\Yaml\Yaml::parse(file_get_contents("$config_dir/$config_name.yml"));
      $config_factory->getEditable($config_name)->setData($data)->save();
    }
  }
}

/**
 * Rename 'Race Day User' role to 'Race Day Runner', preserving user assignments.
 */
function race_day_update_10003(): void {
  $config_factory = \Drupal::configFactory();

  // Capture affected users before deleting the old role.
  $uids = \Drupal::entityQuery('user')
    ->condition('roles', 'race_day_user')
    ->accessCheck(FALSE)
    ->execute();

  $old_role = \Drupal::entityTypeManager()->getStorage('user_role')->load('race_day_user');
  if ($old_role) {
    $old_role->delete();
  }

  // Create the new role directly, in case config sync/install hasn't run yet.
  if (!\Drupal::entityTypeManager()->getStorage('user_role')->load('race_day_runner')) {
    \Drupal\user\Entity\Role::create([
      'id' => 'race_day_runner',
      'label' => 'Race Day Runner',
      'weight' => 4,
      'permissions' => [
        'create race teams',
        'request to join race team',
        'review own race team requests',
        'update race_day location',
        'view all race team names',
        'view race_day content',
        'view race_day races admin listing',
      ],
    ])->save();
  }

  // Re-assign affected users to the renamed role.
  if (!empty($uids)) {
    foreach (\Drupal::entityTypeManager()->getStorage('user')->loadMultiple($uids) as $user) {
      $user->addRole('race_day_runner');
      $user->save();
    }
  }

  // Delete old role actions and create new ones.
  foreach (['user_add_role_action.race_day_user', 'user_remove_role_action.race_day_user'] as $action_id) {
    $action = $config_factory->getEditable('system.action.' . $action_id);
    if (!$action->isNew()) {
      $action->delete();
    }
  }

  // Import the new action configs.
  $config_path = \Drupal::service('extension.list.module')->getPath('race_day') . '/config/install';
  $source = new \Drupal\Core\Config\FileStorage($config_path);
  $config_storage = \Drupal::service('config.storage');
  foreach ([
    'system.action.user_add_role_action.race_day_runner',
    'system.action.user_remove_role_action.race_day_runner',
  ] as $config_name) {
    if ($data = $source->read($config_name)) {
      $config_storage->write($config_name, $data);
    }
  }
}

/**
 * Implements hook_update_dependencies().
 */
function race_day_update_dependencies(): array {
  // race_day_update_10004() writes to field_distance on the strava_route
  // paragraph, so that field must exist first.
  return [
    'race_day' => [
      10004 => [
        'strava_api' => 10003,
      ],
    ],
  ];
}

/**
 * Move the 'distance' field from race_leg onto its route paragraph.
 *
 * Distance is now solely owned by the route paragraph (field_distance),
 * whether populated from Strava or entered manually. The 'route' field is
 * also made required as of this update (see RaceLeg::baseFieldDefinitions()),
 * so every leg is guaranteed a paragraph to hold its distance.
 */
function race_day_update_10004(): void {
  $para_storage = \Drupal::entityTypeManager()->getStorage('paragraph');

  // Copy each leg's existing distance onto its route paragraph before the
  // 'distance' column is dropped below. Read raw DB values directly since
  // 'distance' is no longer in RaceLeg::baseFieldDefinitions() by this point,
  // so the entity API can no longer see the field.
  $rows = \Drupal::database()->select('race_leg', 'rl')
    ->fields('rl', ['id', 'distance', 'route__target_id'])
    ->execute()
    ->fetchAll();

  foreach ($rows as $row) {
    if ($row->distance === NULL || $row->route__target_id === NULL) {
      continue;
    }
    $paragraph = $para_storage->load($row->route__target_id);
    if (!$paragraph || !$paragraph->hasField('field_distance')) {
      continue;
    }
    // Update the existing revision in place; a new revision would leave the
    // leg's stored route__target_revision_id pointing at the old one.
    $paragraph->set('field_distance', $row->distance);
    $paragraph->setNewRevision(FALSE);
    $paragraph->save();
  }

  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $storage_definition = $update_manager->getFieldStorageDefinition('distance', 'race_leg');
  if ($storage_definition) {
    $update_manager->uninstallFieldStorageDefinition($storage_definition);
  }
}

/**
 * Backfill field_elev_high/field_elev_low on existing route paragraphs.
 *
 * These fields were added in strava_api_update_10002(), by which point most
 * route paragraphs already had a cached payload/polyline from an earlier
 * fetch. strava_api_entity_presave() skips re-fetching whenever a route's
 * cached payload and polyline already match, so ordinary re-saves never
 * backfill fields introduced after that cache was populated. This fetches
 * each route's elevation stream directly instead, sidestepping that cache.
 *
 * Runs after race_day_update_10004(), which already depends on
 * strava_api_update_10003() (itself after strava_api_update_10002(), where
 * field_elev_high/field_elev_low were created) — so those fields are
 * guaranteed to exist by the time this runs.
 */
function race_day_update_10005(): string {
  if (!\Drupal::hasService('strava_api.route_client')) {
    return 'strava_api.route_client service unavailable; skipped.';
  }

  $client = \Drupal::service('strava_api.route_client');
  $para_storage = \Drupal::entityTypeManager()->getStorage('paragraph');

  $ids = $para_storage->getQuery()
    ->condition('type', 'strava_route')
    ->accessCheck(FALSE)
    ->execute();

  $updated = 0;
  $skipped = 0;
  foreach ($para_storage->loadMultiple($ids) as $paragraph) {
    if (!$paragraph->hasField('field_elev_high') || !$paragraph->hasField('field_elev_low')) {
      continue;
    }
    if (!$paragraph->get('field_elev_high')->isEmpty() && !$paragraph->get('field_elev_low')->isEmpty()) {
      continue;
    }

    $route_id = trim((string) ($paragraph->get('field_strava_route_id')->value ?? ''));
    if (!ctype_digit($route_id)) {
      $skipped++;
      continue;
    }

    $streams = $client->fetchRouteStreams($route_id);
    $bounds = is_array($streams) ? _race_day_extract_elevation_bounds($streams) : NULL;
    if ($bounds === NULL) {
      \Drupal::logger('race_day')->warning('Could not backfill elevation high/low for route @id (paragraph @pid): no altitude data returned.', [
        '@id' => $route_id,
        '@pid' => $paragraph->id(),
      ]);
      $skipped++;
      continue;
    }

    $paragraph->set('field_elev_high', $bounds['high']);
    $paragraph->set('field_elev_low', $bounds['low']);
    // Update the existing revision in place; a new revision would leave any
    // referencing leg's stored route__target_revision_id pointing at the old
    // one.
    $paragraph->setNewRevision(FALSE);
    $paragraph->save();
    $updated++;
  }

  return "Backfilled elevation high/low on $updated route paragraph(s); $skipped skipped.";
}

/**
 * Returns the highest/lowest elevation (in feet) from a route streams response.
 *
 * Duplicated from strava_api.module's _strava_api_extract_elevation_bounds()
 * so this update hook doesn't reach into another module's internal helper.
 *
 * @param array $streams
 *   The decoded response from GET /routes/{id}/streams: a list of stream
 *   objects, each with a "type" (e.g. "altitude") and a "data" array.
 *
 * @return array{high: int, low: int}|null
 */
function _race_day_extract_elevation_bounds(array $streams): ?array {
  $altitude = NULL;
  foreach ($streams as $stream) {
    if (is_array($stream) && ($stream['type'] ?? NULL) === 'altitude' && is_array($stream['data'] ?? NULL)) {
      $altitude = $stream['data'];
      break;
    }
  }

  if (empty($altitude)) {
    return NULL;
  }

  $meters = array_filter($altitude, 'is_numeric');
  if (empty($meters)) {
    return NULL;
  }

  return [
    'high' => (int) round(max($meters) * 3.28084),
    'low' => (int) round(min($meters) * 3.28084),
  ];
}

/**
 * Remove the unused 'difficulty' field from race_leg.
 */
function race_day_update_10006(): void {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $storage_definition = $update_manager->getFieldStorageDefinition('difficulty', 'race_leg');
  if ($storage_definition) {
    $update_manager->uninstallFieldStorageDefinition($storage_definition);
  }
}

/**
 * Add the 'max_runners_per_team' field to race.
 */
function race_day_update_10007(): void {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($update_manager->getFieldStorageDefinition('max_runners_per_team', 'race')) {
    return;
  }
  $entity_type = \Drupal::entityTypeManager()->getDefinition('race');
  $fields = \Drupal\race_day\Entity\Race::baseFieldDefinitions($entity_type);
  $update_manager->installFieldStorageDefinition(
    'max_runners_per_team',
    'race',
    'race_day',
    $fields['max_runners_per_team']
  );
}

/**
 * Remove the unused 'map_data' field from race.
 *
 * Nothing reads or writes it — the race page's map comes from the race_map
 * Views block (base table race_leg), built from each leg's own embedded
 * Strava route, not from anything stored directly on the race.
 */
function race_day_update_10008(): void {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $storage_definition = $update_manager->getFieldStorageDefinition('map_data', 'race');
  if ($storage_definition) {
    $update_manager->uninstallFieldStorageDefinition($storage_definition);
  }
}

/**
 * Adds the 'Precise Datetime' paragraph type.
 *
 * Captures a date (field_precise_date, date-only — no time component) and a
 * time of day (field_precise_time, integer milliseconds since midnight,
 * 0–86399999, meant to be displayed with the time_formatter module).
 *
 * field_date already exists as a paragraph field storage (used by the
 * 'record' bundle) with datetime_type 'datetime', not 'date' — field storage
 * settings are shared across every bundle using that field name, so a
 * genuinely date-only field here needs its own field name instead.
 */
function race_day_update_10009(): void {
  if (!\Drupal\paragraphs\Entity\ParagraphsType::load('precise_datetime')) {
    \Drupal\paragraphs\Entity\ParagraphsType::create([
      'id' => 'precise_datetime',
      'label' => 'Precise Datetime',
      'description' => 'Captures a precise date and time of day, to the millisecond.',
    ])->save();
  }

  if (!\Drupal\field\Entity\FieldStorageConfig::loadByName('paragraph', 'field_precise_date')) {
    \Drupal\field\Entity\FieldStorageConfig::create([
      'field_name' => 'field_precise_date',
      'entity_type' => 'paragraph',
      'type' => 'datetime',
      'settings' => ['datetime_type' => 'date'],
      'cardinality' => 1,
      'translatable' => TRUE,
    ])->save();
  }
  if (!\Drupal\field\Entity\FieldConfig::loadByName('paragraph', 'precise_datetime', 'field_precise_date')) {
    \Drupal\field\Entity\FieldConfig::create([
      'field_name' => 'field_precise_date',
      'entity_type' => 'paragraph',
      'bundle' => 'precise_datetime',
      'label' => 'Date',
      'description' => '',
      'required' => FALSE,
      'translatable' => FALSE,
    ])->save();
  }

  if (!\Drupal\field\Entity\FieldStorageConfig::loadByName('paragraph', 'field_precise_time')) {
    \Drupal\field\Entity\FieldStorageConfig::create([
      'field_name' => 'field_precise_time',
      'entity_type' => 'paragraph',
      'type' => 'integer',
      'settings' => ['unsigned' => TRUE, 'size' => 'normal'],
      'cardinality' => 1,
      'translatable' => TRUE,
    ])->save();
  }
  if (!\Drupal\field\Entity\FieldConfig::loadByName('paragraph', 'precise_datetime', 'field_precise_time')) {
    \Drupal\field\Entity\FieldConfig::create([
      'field_name' => 'field_precise_time',
      'entity_type' => 'paragraph',
      'bundle' => 'precise_datetime',
      'label' => 'Precise Time',
      'description' => 'Milliseconds since midnight (0-86399999), i.e. the time of day down to the millisecond. Use with the time_formatter module to display as HH:MM:SS.mmm.',
      'required' => FALSE,
      'translatable' => FALSE,
      'settings' => ['min' => 0, 'max' => 86399999],
    ])->save();
  }
}

/**
 * Implements hook_uninstall().
 */
function race_day_uninstall(): void {
  \Drupal::state()->deleteMultiple([
    'race_day.last_cleanup',
  ]);
}
