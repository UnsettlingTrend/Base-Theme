<?php

/**
 * @file
 * Primary module hooks for Race Day.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\Element\EntityAutocomplete;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Render\Markup;
use Drupal\Core\Session\AccountInterface;
use Drupal\paragraphs\Entity\Paragraph;
use Drupal\paragraphs\ParagraphInterface;
use Drupal\race_day\Entity\Race;
use Drupal\race_day\Entity\RaceLeg;
use Drupal\Component\Utility\Html;
use Drupal\group\Entity\GroupInterface;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\ViewExecutable;
use Drupal\webform\WebformSubmissionInterface;

/**
 * Implements hook_ut_utilities_areas_of_interest_info().
 */
function race_day_ut_utilities_areas_of_interest_info(): array {
  return [
    'running' => [
      'label'       => t('Running'),
      'description' => t('Sign up for races and other running related activities.'),
      'roles'       => ['race_day_runner'],
      'weight'      => 0,
    ],
  ];
}

/**
 * Implements hook_views_data_alter().
 *
 * Adds a race_team_membership relationship to the groups base table so Views
 * can join group_relationship_field_data directly on groups.id = gid without
 * routing through the virtual groups_field_data.group_relationship_id key.
 */
function race_day_views_data_alter(array &$data): void {
  $data['groups_field_data']['race_team_member_name'] = [
    'title' => t('Race Team member name'),
    'help' => t('Filter race_team groups by member username (subquery, no virtual-key join).'),
    'filter' => [
      'title' => t('Member name'),
      'id' => 'race_team_member_name',
    ],
  ];
  $data['groups_field_data']['race_team_current_user_member'] = [
    'title' => t('Race Team current user member'),
    'help' => t('Filters race_team groups down to ones the current user is a member of (subquery, no virtual-key join).'),
    'filter' => [
      'title' => t('Current user is a member'),
      'id' => 'race_team_current_user_member',
    ],
  ];
  $data['groups_field_data']['race_team_member_count'] = [
    'title' => t('Race Team member count'),
    'help' => t('Number of members in this race_team group (subquery, no virtual-key join).'),
    'field' => [
      'title' => t('Member Count'),
      'id' => 'race_team_member_count',
    ],
  ];
}

/**
 * Implements hook_preprocess_block().
 *
 * Renders the "Team Requests" block on race_team group pages as a
 * collapsible details element, collapsed by default, instead of a plain
 * block with an always-visible table.
 */
function race_day_preprocess_block(array &$variables): void {
  if (($variables['plugin_id'] ?? NULL) !== 'views_block:race_team_requests-block_1') {
    return;
  }

  $variables['content'] = [
    '#type' => 'details',
    '#title' => $variables['label'] ?: t('Team Requests'),
    '#open' => FALSE,
    'content' => $variables['content'],
  ];
  // The details element renders its own summary/title; suppress the block's
  // own heading so the label isn't shown twice.
  $variables['label'] = '';
}

/**
 * Implements hook_preprocess_views_view_field().
 */
function race_day_preprocess_views_view_field(array &$variables): void {
  $view = $variables['view'];

  // -- race_teams view ---------------------------------------------------------
  if ($view->id() === 'race_teams') {
    $group = $variables['row']->_entity ?? NULL;
    if (!($group instanceof GroupInterface)) {
      return;
    }

    // Strip entity link for users who can't view the group entity page.
    if ($variables['field']->options['id'] === 'label') {
      $account = \Drupal::currentUser();
      $can_view_page = $account->hasPermission('view all race day groups')
        || $group->hasPermission('view group', $account);
      if (!$can_view_page) {
        $variables['output'] = ['#markup' => Html::escape($group->label())];
      }
      return;
    }

    // "Request to Join Team" column — only on the block_1 display.
    if ($variables['field']->options['id'] === 'join_team' && $view->current_display === 'block_1') {
      $account = \Drupal::currentUser();

      // Only show for users who can request to join a team.
      if (!$account->hasPermission('request to join race team')) {
        return;
      }

      // Resolve the race ID from the view's contextual argument.
      $race_id = $view->args[0] ?? NULL;
      if (!$race_id) {
        return;
      }

      // Hide if the user is already a member of this specific team.
      if ($group->getMember($account)) {
        return;
      }

      // Hide if the user is already a member of ANY race_team for this race.
      // Uses a static cache so the query runs once per view render, not per row.
      $already_in_race = &drupal_static('race_day_user_in_race_' . $account->id() . '_' . $race_id);
      if (!isset($already_in_race)) {
        $already_in_race = FALSE;
        $teams_for_race = \Drupal::entityTypeManager()
          ->getStorage('group')
          ->getQuery()
          ->accessCheck(FALSE)
          ->condition('type', 'race_team')
          ->condition('field_race', $race_id)
          ->execute();
        foreach ($teams_for_race as $gid) {
          $team = \Drupal::entityTypeManager()->getStorage('group')->load($gid);
          if ($team && $team->getMember($account)) {
            $already_in_race = TRUE;
            break;
          }
        }
      }
      if ($already_in_race) {
        return;
      }

      // Hide if the user has an active (non-denied, non-canceled) request for
      // this race. Denied or canceled requests allow them to try again.
      $already_requested = &drupal_static('race_day_user_requested_' . $account->id() . '_' . $race_id);
      if (!isset($already_requested)) {
        $submissions = \Drupal::entityTypeManager()
          ->getStorage('webform_submission')
          ->loadByProperties([
            'webform_id' => 'race_day_runner_team_request',
            'uid'        => $account->id(),
          ]);
        $already_requested = FALSE;
        $inactive_statuses = ['denied', 'canceled'];
        foreach ($submissions as $submission) {
          if ((string) $submission->getElementData('race') !== (string) $race_id) {
            continue;
          }
          $status = $submission->getElementData('request_status') ?? '';
          if (!in_array($status, $inactive_statuses, TRUE)) {
            $already_requested = TRUE;
            break;
          }
        }
      }
      if ($already_requested) {
        return;
      }

      $url = \Drupal\Core\Url::fromRoute('race_day.runner_team_request', ['race' => $race_id], [
        'query' => ['group' => $group->id()],
      ]);

      $variables['output'] = [
        '#type' => 'link',
        '#title' => t('Request to Join Team'),
        '#url' => $url,
        '#attributes' => ['class' => ['button', 'button--small', 'join-team-link']],
      ];
      return;
    }

    return;
  }

  // -- race_team_members view: inline pace select for a member's own row ------
  // Only on block_1 (the "Team Members" block on race_team group pages) and
  // only for the row belonging to the current user — everyone else's Pace
  // still renders as plain text via the field's default 'string' formatter.
  if ($view->id() === 'race_team_members') {
    if ($view->current_display !== 'block_1' || $variables['field']->options['id'] !== 'field_pace') {
      return;
    }

    $account = \Drupal::currentUser();
    if ($account->isAnonymous()) {
      return;
    }

    $relationship = $variables['row']->_entity ?? NULL;
    if (!$relationship instanceof \Drupal\group\Entity\GroupRelationshipInterface) {
      return;
    }
    if ((int) $relationship->get('entity_id')->target_id !== (int) $account->id()) {
      return;
    }

    $webform = \Drupal::entityTypeManager()->getStorage('webform')->load('race_day_runner_team_request');
    $element = $webform ? $webform->getElement('expected_pace') : NULL;
    if (!$element) {
      return;
    }

    $current = $relationship->get('field_pace')->value ?? '';
    $options = $element['#options'];

    $select_attrs = 'class="member-pace-select" data-relationship-id="' . Html::escape($relationship->id()) . '"';
    $select_html = '<select ' . $select_attrs . '>';
    foreach ($options as $value => $label) {
      $selected = ($value === $current) ? ' selected' : '';
      $select_html .= '<option value="' . Html::escape($value) . '"' . $selected . '>' . Html::escape($label) . '</option>';
    }
    $select_html .= '</select>';

    $endpoint = \Drupal\Core\Url::fromRoute('race_day.update_member_pace')->toString();

    // Set the field output to safe markup directly — see the same note on
    // the race_team_requests status select below re: Markup::create().
    $variables['output'] = Markup::create($select_html);
    $view->element['#attached']['library'][] = 'race_day/member_pace_review';
    $view->element['#attached']['drupalSettings']['race_day']['memberPaceUrl'] = $endpoint;
    return;
  }

  // -- race_team_requests view: inline status select for reviewers ------------
  // Scoped to block_1 ("Team Requests", placed on race_team group pages —
  // see core.entity_view_display.group.race_team.default.yml) only —
  // block_2 ("My Team Requests", on the /admin/race-day/my-teams page)
  // keeps its plain Status text, per request.
  if ($view->id() !== 'race_team_requests'
    || $view->current_display !== 'block_1'
    || $variables['field']->options['id'] !== 'webform_submission_value_1') {
    return;
  }
  $account = \Drupal::currentUser();
  $can_review = $account->hasPermission('review all race team requests')
    || $account->hasPermission('review own race team requests');
  if (!$can_review) {
    return;
  }

  $submission = $variables['row']->_entity ?? NULL;
  if (!$submission) {
    return;
  }

  $webform = \Drupal::entityTypeManager()->getStorage('webform')->load('race_day_runner_team_request');
  $element = $webform ? $webform->getElement('request_status') : NULL;
  if (!$element) {
    return;
  }

  $sid = $submission->id();
  $current = $submission->getElementData('request_status') ?? '';
  $options = $element['#options'];

  $select_attrs = 'class="request-status-select" data-sid="' . Html::escape($sid) . '"';
  $select_html = '<select ' . $select_attrs . '>';
  foreach ($options as $value => $label) {
    $selected = ($value === $current) ? ' selected' : '';
    $select_html .= '<option value="' . Html::escape($value) . '"' . $selected . '>' . Html::escape($label) . '</option>';
  }
  $select_html .= '</select>';

  $endpoint = \Drupal\Core\Url::fromRoute('race_day.update_request_status')->toString();

  // Set the field output to safe markup directly. Render arrays assigned to
  // $variables['output'] can be lost in isolated Twig render contexts; using
  // Markup::create() ensures the HTML is printed as-is.
  $variables['output'] = Markup::create($select_html);

  // Attach the JS library and settings to the view's own render array so they
  // bubble up through the main render context rather than an isolated one.
  $view->element['#attached']['library'][] = 'race_day/request_status_review';
  $view->element['#attached']['drupalSettings']['race_day']['requestStatusUrl'] = $endpoint;
}

/**
 * Implements hook_preprocess_views_view().
 *
 * Gives the Team Members view a predictable wrapper ID so
 * RequestStatusController::update() can target it with a ReplaceCommand
 * after a request's status changes (which adds/removes group membership).
 */
function race_day_preprocess_views_view(array &$variables): void {
  $view = $variables['view'];
  if ($view->id() !== 'race_team_members') {
    return;
  }
  $group_id = $view->args[0] ?? NULL;
  if ($group_id) {
    $variables['attributes']['id'] = 'race-team-members-' . $group_id;
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for webform_submission.
 *
 * If a new submission is created already approved, add the user to the team.
 */
function race_day_webform_submission_insert(EntityInterface $submission): void {
  _race_day_sync_team_membership($submission, NULL, $submission->getElementData('request_status') ?? '');
}

/**
 * Implements hook_ENTITY_TYPE_update() for webform_submission.
 *
 * Syncs group membership when the request_status field changes.
 */
function race_day_webform_submission_update(EntityInterface $submission): void {
  $old_status = $submission->original->getElementData('request_status') ?? '';
  $new_status = $submission->getElementData('request_status') ?? '';
  if ($old_status === $new_status) {
    return;
  }
  _race_day_sync_team_membership($submission, $old_status, $new_status);
}

/**
 * Syncs race_team group membership based on request_status transitions.
 *
 * approved → anything else: remove from group + clear leg slot assignments.
 * anything else → approved: add as group member.
 */
function _race_day_sync_team_membership(EntityInterface $submission, ?string $old_status, string $new_status): void {
  if ($submission->getWebform()->id() !== 'race_day_runner_team_request') {
    return;
  }

  $team_id = (int) $submission->getElementData('race_team');
  if (!$team_id) {
    return;
  }

  $uid = $submission->getOwnerId();
  $storage = \Drupal::entityTypeManager()->getStorage('user');
  $account = $storage->load($uid);
  $group = \Drupal::entityTypeManager()->getStorage('group')->load($team_id);
  if (!$account || !$group) {
    return;
  }

  $was_approved = $old_status === 'approved';
  $is_approved = $new_status === 'approved';

  if ($is_approved && !$was_approved) {
    if (!$group->getMember($account)) {
      // Carry the requested pace over onto the membership itself (field_pace
      // on the group_relationship, config/sync/default/field.field.group_relationship
      // .race_team-group_membership.field_pace.yml) — addMember()'s $values
      // param sets fields on the relationship entity at creation time.
      $group->addMember($account, ['field_pace' => $submission->getElementData('expected_pace')]);
    }
    return;
  }

  if ($was_approved && !$is_approved) {
    // Clear any leg slot assignments (field_runner_legs paragraphs) first.
    foreach ($group->get('field_runner_legs')->referencedEntities() as $paragraph) {
      if ($paragraph->bundle() !== 'race_day_leg_assignment') {
        continue;
      }
      if ((int) $paragraph->get('field_race_day_runner')->target_id === (int) $uid) {
        $paragraph->set('field_race_day_runner', NULL);
        $paragraph->save();
      }
    }
    // Then remove from the group.
    if ($group->getMember($account)) {
      $group->removeMember($account);
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave() for paragraph.
 *
 * Recomputes field_expected_time on race_day_leg_assignment paragraphs on
 * every save (assignment, removal, or an explicit resave triggered by
 * race_day_group_relationship_update() after a pace change), from the
 * assigned leg's distance and the runner's current pace — so the field is
 * always derived fresh rather than needing to be kept in sync by hand at
 * every call site that touches the paragraph. Also cascades a leg assignment
 * being marked Running to the rest of its team's assignments.
 */
function race_day_paragraph_presave(EntityInterface $entity): void {
  if ($entity->bundle() !== 'race_day_leg_assignment') {
    return;
  }
  /** @var \Drupal\paragraphs\ParagraphInterface $entity */
  if ($entity->hasField('field_expected_time')) {
    $entity->set('field_expected_time', _race_day_calculate_expected_time($entity));
  }
  if ($entity->hasField('field_race_day_leg_status') && $entity->get('field_race_day_leg_status')->value === 'running') {
    _race_day_cascade_running_status($entity);
  }
}

/**
 * Cascades a leg assignment's Status becoming Running to the rest of its team.
 *
 * Every earlier leg (lower leg_number) on the same team is marked Finished —
 * by definition, if this leg is now running, the runner reached it by
 * finishing everything before it, whatever those assignments' statuses
 * happened to say. And since only one assignment per team should ever be
 * Running at a time (the same single-selection behavior the old Current
 * Runner checkbox had — Paragraphs has no native way to enforce that across
 * sibling instances of the same paragraph type), any other assignment still
 * marked Running gets reset to Created; this should only happen if a leg
 * out of sequence was marked Running by hand, since normal race progression
 * always moves forward.
 */
function _race_day_cascade_running_status(ParagraphInterface $assignment): void {
  if (!$assignment->hasField('field_race_day_leg') || $assignment->get('field_race_day_leg')->isEmpty()) {
    return;
  }
  $leg = $assignment->get('field_race_day_leg')->entity;
  if (!$leg) {
    return;
  }
  $leg_number = (int) $leg->get('leg_number')->value;

  $group = $assignment->getParentEntity();
  if (!$group instanceof GroupInterface) {
    return;
  }

  foreach (_race_day_team_assignments($group) as $sibling_leg_number => $sibling) {
    if ((int) $sibling->id() === (int) $assignment->id() || !$sibling->hasField('field_race_day_leg_status')) {
      continue;
    }

    if ($sibling_leg_number < $leg_number) {
      if ($sibling->get('field_race_day_leg_status')->value !== 'finished') {
        $sibling->set('field_race_day_leg_status', 'finished');
        $sibling->setNewRevision(FALSE);
        $sibling->save();
      }
    }
    elseif ($sibling->get('field_race_day_leg_status')->value === 'running') {
      $sibling->set('field_race_day_leg_status', 'created');
      $sibling->setNewRevision(FALSE);
      $sibling->save();
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_update() for group_relationship.
 *
 * When a member's expected pace changes, resave every leg assignment they
 * currently hold on that same team so race_day_paragraph_presave() picks up
 * the new pace and recomputes field_expected_time.
 */
function race_day_group_relationship_update(EntityInterface $entity): void {
  if ($entity->bundle() !== 'race_team-group_membership' || !$entity->hasField('field_pace')) {
    return;
  }

  $old_pace = $entity->original?->get('field_pace')->value;
  $new_pace = $entity->get('field_pace')->value;
  if ($old_pace === $new_pace) {
    return;
  }

  /** @var \Drupal\group\Entity\GroupRelationshipInterface $entity */
  $group = $entity->getGroup();
  $uid = (int) $entity->get('entity_id')->target_id;
  if (!$group || !$uid) {
    return;
  }

  foreach (_race_day_team_assignments($group) as $paragraph) {
    if ((int) $paragraph->get('field_race_day_runner')->target_id === $uid) {
      $paragraph->save();
    }
  }

  // The pace change may have altered field_expected_time on one or more of
  // this member's legs, which can shift every subsequent leg's expected
  // start/finish — recompute the whole chain, not just their own legs.
  _race_day_recalculate_team_expected_schedule($group);

  // Only after every downstream time has settled: the schedule shift above
  // can change which leg is actually "out" right now (e.g. reveal that the
  // current leg should already have handed off to the next runner), so
  // Running status has to be re-checked against the new schedule, not the
  // one this pace change just made stale. Same "in_progress races only"
  // scope race_day_cron() uses for this same check, so a pace edit doesn't
  // start flipping Running/Finished status on a race that hasn't started
  // or has already been marked complete.
  $race = $group->hasField('field_race') ? $group->get('field_race')->entity : NULL;
  if ($race instanceof Race && $race->get('status')->value === 'in_progress') {
    _race_day_update_running_status_for_team($group, _race_day_now_epoch_ms());
  }
}

/**
 * Computes a leg assignment's expected finish time, in milliseconds.
 *
 * distance (miles, from the assigned leg's Strava route) × pace
 * (minutes per mile, from the runner's pace on their team membership) ×
 * 60,000. NULL if the assignment has no runner or leg, the leg has no
 * distance yet, or the runner has no parseable pace set.
 */
function _race_day_calculate_expected_time(ParagraphInterface $assignment): ?int {
  if ($assignment->get('field_race_day_runner')->isEmpty() || $assignment->get('field_race_day_leg')->isEmpty()) {
    return NULL;
  }

  /** @var \Drupal\race_day\Entity\RaceLeg|null $leg */
  $leg = $assignment->get('field_race_day_leg')->entity;
  $distance = $leg?->getDistance();
  if ($distance === NULL || !is_numeric($distance)) {
    return NULL;
  }

  $group = $assignment->getParentEntity();
  if (!$group instanceof GroupInterface) {
    return NULL;
  }

  $uid = (int) $assignment->get('field_race_day_runner')->target_id;
  $pace = _race_day_get_member_pace((int) $group->id(), $uid);
  $pace_minutes = $pace !== NULL ? _race_day_parse_pace_minutes($pace) : NULL;
  if ($pace_minutes === NULL) {
    return NULL;
  }

  return (int) round(((float) $distance) * $pace_minutes * 60000);
}

/**
 * Returns a race_team member's expected pace (e.g. "09:30"), or NULL.
 */
function _race_day_get_member_pace(int $group_id, int $uid): ?string {
  $relationships = \Drupal::entityTypeManager()->getStorage('group_relationship')->loadByProperties([
    'gid' => $group_id,
    'entity_id' => $uid,
    'plugin_id' => 'group_membership',
  ]);
  $relationship = $relationships ? reset($relationships) : NULL;
  if (!$relationship || !$relationship->hasField('field_pace')) {
    return NULL;
  }
  $value = $relationship->get('field_pace')->value;
  return $value !== NULL && $value !== '' ? (string) $value : NULL;
}

/**
 * Parses a "MM:SS" pace string into minutes (e.g. "09:30" → 9.5).
 */
function _race_day_parse_pace_minutes(string $pace): ?float {
  if (!preg_match('/^(\d+):([0-5]\d)$/', trim($pace), $matches)) {
    return NULL;
  }
  return ((int) $matches[1]) + ((int) $matches[2]) / 60;
}

/**
 * Implements hook_ENTITY_TYPE_insert() for paragraph.
 *
 * Newly-created assignments don't have an id yet during their own presave
 * (so a nested field_expected_start/finish paragraph can't be parented to
 * them there) — this runs after the insert, once the id exists.
 */
function race_day_paragraph_insert(EntityInterface $entity): void {
  if ($entity->bundle() !== 'race_day_leg_assignment') {
    return;
  }
  $group = $entity->getParentEntity();
  if ($group instanceof GroupInterface) {
    _race_day_recalculate_team_expected_schedule($group);
  }
}

/**
 * Implements hook_ENTITY_TYPE_update() for paragraph.
 *
 * Any change to a leg assignment (runner assigned/removed, re-pointed to a
 * different leg, status change, etc.) can affect its own expected time and
 * everything chained after it, so the whole team's schedule gets recomputed.
 */
function race_day_paragraph_update(EntityInterface $entity): void {
  if ($entity->bundle() !== 'race_day_leg_assignment') {
    return;
  }
  $group = $entity->getParentEntity();
  if ($group instanceof GroupInterface) {
    _race_day_recalculate_team_expected_schedule($group);
  }
}

/**
 * Implements hook_ENTITY_TYPE_update() for race.
 *
 * When a race's date/time changes, every team's expected schedule needs
 * recomputing — leg 1 anchors to it directly, and every later leg chains
 * from leg 1 through each leg's own expected time.
 */
function race_day_race_update(EntityInterface $entity): void {
  if (!$entity->hasField('race_date')) {
    return;
  }
  $old_date = $entity->original?->get('race_date')->value;
  $new_date = $entity->get('race_date')->value;
  if ($old_date === $new_date) {
    return;
  }

  $group_ids = \Drupal::entityQuery('group')
    ->condition('type', 'race_team')
    ->condition('field_race', $entity->id())
    ->accessCheck(FALSE)
    ->execute();
  if (!$group_ids) {
    return;
  }

  $group_storage = \Drupal::entityTypeManager()->getStorage('group');
  foreach ($group_storage->loadMultiple($group_ids) as $group) {
    _race_day_recalculate_team_expected_schedule($group);
  }
}

/**
 * Implements hook_cron().
 *
 * For every race currently marked "In Progress", updates which leg
 * assignment is marked Running on each of its teams.
 */
function race_day_cron(): void {
  $race_ids = \Drupal::entityQuery('race')
    ->condition('status', 'in_progress')
    ->accessCheck(FALSE)
    ->execute();
  if (!$race_ids) {
    return;
  }

  $race_storage = \Drupal::entityTypeManager()->getStorage('race');
  foreach ($race_storage->loadMultiple($race_ids) as $race) {
    _race_day_update_running_status_for_race($race);
  }
}

/**
 * Updates the Running status on every team's leg assignments for a race.
 */
function _race_day_update_running_status_for_race(Race $race): void {
  $group_ids = \Drupal::entityQuery('group')
    ->condition('type', 'race_team')
    ->condition('field_race', $race->id())
    ->accessCheck(FALSE)
    ->execute();
  if (!$group_ids) {
    return;
  }

  $now_ms = _race_day_now_epoch_ms();
  $group_storage = \Drupal::entityTypeManager()->getStorage('group');
  foreach ($group_storage->loadMultiple($group_ids) as $group) {
    _race_day_update_running_status_for_team($group, $now_ms);
  }
}

/**
 * Marks whichever of a team's leg assignments is "out" right now as Running.
 *
 * A leg assignment is "out" when $now_ms falls within its start/finish
 * window (_race_day_leg_assignment_window()) — start inclusive, finish
 * exclusive, so the instant one leg finishes belongs to the next leg's
 * window, not both at once. Setting a Status of Running triggers
 * race_day_paragraph_presave()'s cascade, which finishes every earlier leg
 * and clears Running from anything else that still had it — so nothing
 * further needs doing here beyond finding the one leg that should become
 * Running (never regressing a leg that's already Running or Finished).
 *
 * If no leg's window contains $now_ms because time has passed the last
 * leg's own finish, there's no later leg left to trigger that cascade for
 * it — so that last leg is marked Finished directly here instead.
 */
function _race_day_update_running_status_for_team(GroupInterface $group, int $now_ms): void {
  $assignments = _race_day_team_assignments($group);
  if (!$assignments) {
    return;
  }

  foreach ($assignments as $assignment) {
    if (!$assignment->hasField('field_race_day_leg_status')) {
      continue;
    }
    $window = _race_day_leg_assignment_window($assignment);
    if ($window['start'] === NULL || $window['finish'] === NULL
      || $now_ms < $window['start'] || $now_ms >= $window['finish']) {
      continue;
    }
    if ($assignment->get('field_race_day_leg_status')->value === 'created') {
      $assignment->set('field_race_day_leg_status', 'running');
      $assignment->setNewRevision(FALSE);
      $assignment->save();
    }
    return;
  }

  $last = end($assignments);
  if (!$last->hasField('field_race_day_leg_status') || $last->get('field_race_day_leg_status')->value === 'finished') {
    return;
  }
  $last_window = _race_day_leg_assignment_window($last);
  if ($last_window['finish'] !== NULL && $now_ms >= $last_window['finish']) {
    $last->set('field_race_day_leg_status', 'finished');
    $last->setNewRevision(FALSE);
    $last->save();
  }
}

/**
 * Returns every race_day_leg_assignment paragraph belonging to a team.
 *
 * Queries directly by the paragraphs' own composite-parent fields (set via
 * setParentEntity() when each assignment was created) rather than through
 * $group->get('field_runner_legs')->referencedEntities() — the latter
 * resolves each item via the group's own stored target_revision_id, which
 * can go stale the moment an assignment is resaved without the group itself
 * being resaved (the normal case here: assignments are saved directly, not
 * through the group's own paragraphs widget). Querying by parent id instead
 * always finds each assignment's true latest revision.
 *
 * @return array<int, \Drupal\paragraphs\ParagraphInterface>
 *   Assignment paragraphs, keyed by paragraph id, in no particular order.
 */
function _race_day_group_leg_assignments(GroupInterface $group): array {
  $ids = \Drupal::entityQuery('paragraph')
    ->condition('type', 'race_day_leg_assignment')
    ->condition('parent_id', $group->id())
    ->condition('parent_type', 'group')
    ->condition('parent_field_name', 'field_runner_legs')
    ->accessCheck(FALSE)
    ->execute();
  return $ids ? \Drupal::entityTypeManager()->getStorage('paragraph')->loadMultiple($ids) : [];
}

/**
 * Returns a race_team's leg assignment paragraphs, keyed by leg number.
 *
 * Only includes assignments that have a leg assigned — use
 * _race_day_group_leg_assignments() instead if you need every assignment on
 * the team regardless of whether a leg has been picked yet.
 *
 * @return array<int, \Drupal\paragraphs\ParagraphInterface>
 *   Assignment paragraphs keyed by their leg's leg_number, ascending.
 */
function _race_day_team_assignments(GroupInterface $group): array {
  $assignments = [];
  foreach (_race_day_group_leg_assignments($group) as $paragraph) {
    $leg = $paragraph->get('field_race_day_leg')->isEmpty() ? NULL : $paragraph->get('field_race_day_leg')->entity;
    if ($leg) {
      $assignments[(int) $leg->get('leg_number')->value] = $paragraph;
    }
  }
  ksort($assignments);
  return $assignments;
}

/**
 * Recalculates the expected start/finish chain for every leg on a team.
 *
 * Leg 1's expected start is the race's own date/time
 * (_race_day_race_date_time_parts()). Every other leg's expected start is
 * the previous leg's expected finish, and every leg's expected finish is
 * its own expected start plus its expected time
 * (_race_day_calculate_expected_time()).
 *
 * If a leg's expected time isn't available (no runner assigned, no leg
 * distance yet, no parseable pace, etc.), the chain breaks there: that leg
 * keeps whatever expected start was already computed for it (it's still
 * fully determined by the previous leg, independent of this leg's own
 * runner), but its expected finish — and every subsequent leg's expected
 * start and finish — gets wiped, since none of that is derivable anymore.
 */
function _race_day_recalculate_team_expected_schedule(GroupInterface $group): void {
  if ($group->bundle() !== 'race_team' || !$group->hasField('field_race') || $group->get('field_race')->isEmpty()) {
    return;
  }
  $race = $group->get('field_race')->entity;
  if (!$race instanceof Race) {
    return;
  }

  $assignments = _race_day_team_assignments($group);
  if (!$assignments) {
    return;
  }

  $next_start = _race_day_race_date_time_parts($race);
  foreach ($assignments as $assignment) {
    if (!$assignment->hasField('field_expected_start') || !$assignment->hasField('field_expected_finish')) {
      continue;
    }

    $start_parts = $next_start;
    $expected_time_ms = $start_parts !== NULL ? _race_day_calculate_expected_time($assignment) : NULL;
    $finish_parts = $expected_time_ms !== NULL ? _race_day_add_ms_to_parts($start_parts, $expected_time_ms) : NULL;

    $needs_save = _race_day_set_leg_moment($assignment, 'field_expected_start', $start_parts);
    $needs_save = _race_day_set_leg_moment($assignment, 'field_expected_finish', $finish_parts) || $needs_save;
    if ($needs_save) {
      // Update the existing revision in place — a new revision here would
      // leave the group's own stored target_revision_id for this leg
      // assignment (in field_runner_legs) stale, since the group itself
      // isn't being resaved.
      $assignment->setNewRevision(FALSE);
      $assignment->save();
    }

    // Once broken, every subsequent leg gets NULL parts, wiping both fields.
    $next_start = $finish_parts;
  }
}

/**
 * Sets, updates, or clears one of a leg assignment's date/time fields.
 *
 * Creates the nested precise_datetime paragraph if none exists yet, updates
 * it in place if one does, or deletes it and clears the field if $parts is
 * NULL. Never saves $assignment itself — the caller does that once after
 * both field_expected_start and field_expected_finish have been set, so a
 * single save covers both.
 *
 * @return bool
 *   TRUE if $assignment's own field value changed (a new paragraph got
 *   attached, or an existing reference got cleared) and so needs saving.
 *   FALSE if nothing changed, or if only the nested paragraph's own values
 *   changed (that's saved here directly, since its revision id — and so
 *   $assignment's reference to it — doesn't change).
 */
function _race_day_set_leg_moment(ParagraphInterface $assignment, string $field_name, ?array $parts): bool {
  if (!$assignment->hasField($field_name)) {
    return FALSE;
  }
  $field = $assignment->get($field_name);
  $existing = $field->isEmpty() ? NULL : $field->get(0)->entity;

  if ($parts === NULL) {
    if (!$existing) {
      return FALSE;
    }
    $existing_id = $existing->id();
    $assignment->set($field_name, NULL);
    $orphan = \Drupal::entityTypeManager()->getStorage('paragraph')->load($existing_id);
    if ($orphan) {
      $orphan->delete();
    }
    return TRUE;
  }

  if ($existing) {
    if ($existing->get('field_precise_date')->value === $parts['date']
      && (int) $existing->get('field_precise_time')->value === $parts['time_ms']) {
      return FALSE;
    }
    $existing->set('field_precise_date', $parts['date']);
    $existing->set('field_precise_time', $parts['time_ms']);
    $existing->setNewRevision(FALSE);
    $existing->save();
    return FALSE;
  }

  $new_paragraph = Paragraph::create([
    'type' => 'precise_datetime',
    'field_precise_date' => $parts['date'],
    'field_precise_time' => $parts['time_ms'],
  ]);
  $new_paragraph->setParentEntity($assignment, $field_name);
  $new_paragraph->save();
  $assignment->set($field_name, [
    ['target_id' => $new_paragraph->id(), 'target_revision_id' => $new_paragraph->getRevisionId()],
  ]);
  return TRUE;
}

/**
 * Adds a millisecond duration to a date/time_ms pair, rolling over days.
 *
 * @param array{date: string, time_ms: int} $parts
 * @param int $add_ms
 *
 * @return array{date: string, time_ms: int}
 */
function _race_day_add_ms_to_parts(array $parts, int $add_ms): array {
  $total_ms = $parts['time_ms'] + $add_ms;
  $day_offset = intdiv($total_ms, 86400000);
  $time_ms = $total_ms % 86400000;

  $date = new \DateTime($parts['date']);
  if ($day_offset !== 0) {
    $date->modify(($day_offset > 0 ? '+' : '') . $day_offset . ' days');
  }

  return [
    'date' => $date->format('Y-m-d'),
    'time_ms' => $time_ms,
  ];
}

/**
 * Splits a race's date/time into local-timezone date + ms-since-midnight.
 *
 * race_date is stored in UTC (core datetime field convention); this converts
 * to the site's default timezone first so, e.g., a race entered as starting
 * at 1pm Eastern comes back as time_ms for 13:00, not whatever 1pm UTC
 * happens to be locally.
 *
 * @return array{date: string, time_ms: int}|null
 */
function _race_day_race_date_time_parts(Race $race): ?array {
  $item = $race->get('race_date');
  if ($item->isEmpty()) {
    return NULL;
  }

  /** @var \Drupal\Core\Datetime\DrupalDateTime $date */
  $date = clone $item->date;
  $timezone = \Drupal::config('system.date')->get('timezone.default') ?: date_default_timezone_get();
  $date->setTimezone(new \DateTimeZone($timezone));

  $time_ms = ((int) $date->format('H')) * 3600000
    + ((int) $date->format('i')) * 60000
    + ((int) $date->format('s')) * 1000;

  return [
    'date' => $date->format('Y-m-d'),
    'time_ms' => $time_ms,
  ];
}

/**
 * Formats a precise_datetime paragraph's time as 12-hour "g:i A", or '' if unset.
 */
function _race_day_format_precise_datetime(?ParagraphInterface $moment): string {
  if (!$moment || $moment->get('field_precise_date')->isEmpty() || $moment->get('field_precise_time')->isEmpty()) {
    return '';
  }
  $ms = (int) $moment->get('field_precise_time')->value;
  return gmdate('g:i A', intdiv($ms, 1000));
}

/**
 * Resolves a leg assignment's actual (or, absent that, expected) moment.
 *
 * The shared "prefer actual, fall back to expected" lookup behind both
 * _race_day_leg_assignment_moment() (display) and
 * _race_day_leg_assignment_window() (current-runner detection) — kept in one
 * place so both always agree on which moment is authoritative.
 *
 * @param \Drupal\paragraphs\ParagraphInterface $assignment
 *   A race_day_leg_assignment paragraph.
 * @param string $actual_field
 *   'field_actual_start' or 'field_actual_finish'.
 * @param string $expected_field
 *   'field_expected_start' or 'field_expected_finish'.
 *
 * @return array{moment: \Drupal\paragraphs\ParagraphInterface|null, type: string}
 *   'type' is 'actual' or 'expected' depending on which field the moment
 *   came from, or '' (with a NULL 'moment') if neither field has one.
 */
function _race_day_resolve_leg_assignment_moment(ParagraphInterface $assignment, string $actual_field, string $expected_field): array {
  foreach ([$actual_field => 'actual', $expected_field => 'expected'] as $field_name => $type) {
    if (!$assignment->hasField($field_name) || $assignment->get($field_name)->isEmpty()) {
      continue;
    }
    $moment = $assignment->get($field_name)->get(0)->entity;
    if ($moment && !$moment->get('field_precise_date')->isEmpty() && !$moment->get('field_precise_time')->isEmpty()) {
      return ['moment' => $moment, 'type' => $type];
    }
  }
  return ['moment' => NULL, 'type' => ''];
}

/**
 * Formats a leg assignment's actual (or, absent that, expected) start/finish.
 *
 * @return array{value: string, type: string}
 *   'type' is 'actual' or 'expected' depending on which field the value came
 *   from, or '' (with an empty 'value') if neither field has one.
 */
function _race_day_leg_assignment_moment(ParagraphInterface $assignment, string $actual_field, string $expected_field): array {
  $resolved = _race_day_resolve_leg_assignment_moment($assignment, $actual_field, $expected_field);
  if (!$resolved['moment']) {
    return ['value' => '', 'type' => ''];
  }
  return ['value' => _race_day_format_precise_datetime($resolved['moment']), 'type' => $resolved['type']];
}

/**
 * Converts a precise_datetime paragraph to milliseconds since the Unix epoch.
 *
 * Used only to diff two moments against each other, so the choice of epoch
 * doesn't matter as long as both sides use it consistently.
 */
function _race_day_moment_epoch_ms(?ParagraphInterface $moment): ?int {
  if (!$moment || $moment->get('field_precise_date')->isEmpty() || $moment->get('field_precise_time')->isEmpty()) {
    return NULL;
  }
  $date = $moment->get('field_precise_date')->value;
  $time_ms = (int) $moment->get('field_precise_time')->value;
  $day_ms = (new \DateTime($date, new \DateTimeZone('UTC')))->getTimestamp() * 1000;
  return $day_ms + $time_ms;
}

/**
 * Returns "now" on the same synthetic epoch _race_day_moment_epoch_ms() uses
 * (a local wall-clock date/time re-expressed as ms-since-UTC-midnight of
 * that date), so it can be compared directly against a leg assignment's
 * start/finish moments.
 */
function _race_day_now_epoch_ms(): int {
  $timezone = \Drupal::config('system.date')->get('timezone.default') ?: date_default_timezone_get();
  $now = (new \DateTime('now'))->setTimezone(new \DateTimeZone($timezone));

  $time_ms = ((int) $now->format('H')) * 3600000
    + ((int) $now->format('i')) * 60000
    + ((int) $now->format('s')) * 1000;
  $day_ms = (new \DateTime($now->format('Y-m-d'), new \DateTimeZone('UTC')))->getTimestamp() * 1000;
  return $day_ms + $time_ms;
}

/**
 * Returns a leg assignment's start/finish window, in the same synthetic
 * epoch as _race_day_now_epoch_ms(), using actual times where recorded and
 * falling back to expected times otherwise — the exact same resolution
 * _race_day_leg_assignment_moment() uses for the Runner Assignments table,
 * so "current runner" always agrees with what that table displays.
 *
 * @return array{start: int|null, finish: int|null}
 */
function _race_day_leg_assignment_window(ParagraphInterface $assignment): array {
  $start = _race_day_resolve_leg_assignment_moment($assignment, 'field_actual_start', 'field_expected_start')['moment'];
  $finish = _race_day_resolve_leg_assignment_moment($assignment, 'field_actual_finish', 'field_expected_finish')['moment'];
  return [
    'start' => _race_day_moment_epoch_ms($start),
    'finish' => _race_day_moment_epoch_ms($finish),
  ];
}

/**
 * Formats a millisecond duration as "H:i:s.uuu" (hours:minutes:seconds.ms).
 */
function _race_day_format_duration_ms(int $duration_ms): string {
  $hours = intdiv($duration_ms, 3600000);
  $remainder = $duration_ms % 3600000;
  $minutes = intdiv($remainder, 60000);
  $remainder %= 60000;
  $seconds = intdiv($remainder, 1000);
  $millis = $remainder % 1000;
  return sprintf('%d:%02d:%02d.%03d', $hours, $minutes, $seconds, $millis);
}

/**
 * Formats a leg assignment's elapsed time.
 *
 * Once both an actual start and actual finish are recorded, this is the
 * measured difference between them; until then, it falls back to the
 * paragraph's own expected/estimated time.
 *
 * @return array{value: string, type: string}
 *   'type' is 'actual' or 'expected' depending on the source, or '' (with an
 *   empty 'value') if neither is available.
 */
function _race_day_leg_assignment_time(ParagraphInterface $assignment): array {
  if (!$assignment->get('field_actual_start')->isEmpty() && !$assignment->get('field_actual_finish')->isEmpty()) {
    $start_ms = _race_day_moment_epoch_ms($assignment->get('field_actual_start')->get(0)->entity);
    $finish_ms = _race_day_moment_epoch_ms($assignment->get('field_actual_finish')->get(0)->entity);
    if ($start_ms !== NULL && $finish_ms !== NULL) {
      return ['value' => _race_day_format_duration_ms($finish_ms - $start_ms), 'type' => 'actual'];
    }
  }

  if (!$assignment->hasField('field_expected_time') || $assignment->get('field_expected_time')->isEmpty()) {
    return ['value' => '', 'type' => ''];
  }
  return ['value' => _race_day_format_duration_ms((int) $assignment->get('field_expected_time')->value), 'type' => 'expected'];
}

/**
 * Implements hook_views_pre_render().
 */
function race_day_views_pre_render(ViewExecutable $view): void {
  // race_teams block_1: cache per user so join-link visibility is correct.
  if ($view->id() === 'race_teams' && $view->current_display === 'block_1') {
    $view->element['#cache']['contexts'][] = 'user';
    $view->element['#cache']['tags'][] = 'webform_submission_list';
    return;
  }

  // race_team_requests block_1: require 'review all race team requests' or,
  // for 'review own race team requests', being the team captain or admin of
  // the current group (not just any member).
  if ($view->id() === 'race_team_requests' && $view->current_display === 'block_1') {
    $account = \Drupal::currentUser();

    if ($account->hasPermission('review all race team requests')) {
      return;
    }

    if ($account->hasPermission('review own race team requests')) {
      $gid = $view->args[0] ?? NULL;
      if ($gid) {
        $group = \Drupal::entityTypeManager()->getStorage('group')->load($gid);
        if ($group && _race_day_is_team_captain_or_admin($group, $account)) {
          return;
        }
      }
    }

    // No access — suppress all results so the block renders empty.
    $view->result = [];
    $view->total_rows = 0;
  }
}

/**
 * Checks whether the account is a team captain or admin of the given group.
 */
function _race_day_is_team_captain_or_admin(GroupInterface $group, AccountInterface $account): bool {
  $membership = $group->getMember($account);
  if (!$membership) {
    return FALSE;
  }
  foreach ($membership->getRoles() as $role) {
    if (in_array($role->id(), ['race_team-admin', 'race_team-team_captain'], TRUE)) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Implements hook_views_query_alter().
 *
 * Group 3.x moves itself to the end of the views_query_alter list and skips
 * its membership restriction when disable_sql_rewrite is set. By setting that
 * flag here (race_day runs before Group), users with 'manage race day groups'
 * see all race_team groups in the race_teams view.
 */
function race_day_views_query_alter(ViewExecutable $view, QueryPluginBase $query): void {
  $account = \Drupal::currentUser();
  if ($view->id() === 'race_teams' && (
    $account->hasPermission('manage race day groups') ||
    $account->hasPermission('view all race team names')
  )) {
    $query->options['disable_sql_rewrite'] = TRUE;
    // Restrict to race_team bundle — enforced here so the view has no
    // schema-problematic bundle filter that breaks on UI save.
    $query->addWhere(0, 'groups_field_data.type', 'race_team', '=');
  }

  // race_team_requests reaches groups_field_data via a relationship rather
  // than as the base table, which Group's membership-based SQL rewrite can't
  // resolve — it defensively appends a "1 = 0" condition and the view always
  // returns zero rows. Access is already enforced by
  // race_day_views_pre_render(), so disable Group's redundant rewrite here.
  if ($view->id() === 'race_team_requests') {
    $query->options['disable_sql_rewrite'] = TRUE;
  }
}

/**
 * Implements hook_entity_type_alter().
 *
 * Replaces Group's list builder with our own so that users with
 * 'view all race day groups' can bypass Group's membership-only query filter.
 */
function race_day_entity_type_alter(array &$entity_types): void {
  if (isset($entity_types['group'])) {
    $entity_types['group']->setListBuilderClass(\Drupal\race_day\Entity\Controller\RaceDayGroupListBuilder::class);
  }
}

/**
 * Implements hook_entity_create_access().
 *
 * The Group module's /group/add/{type} route uses _entity_create_access, which
 * calls createAccess() → hook_entity_create_access(), not hook_entity_access().
 */
function race_day_entity_create_access(AccountInterface $account, array $context, ?string $entity_bundle): AccessResult {
  if (($context['entity_type_id'] ?? NULL) !== 'group') {
    return AccessResult::neutral();
  }
  $bundle = $entity_bundle ?? ($context['bundle'] ?? NULL);
  if ($bundle !== 'race_team') {
    return AccessResult::neutral();
  }
  return AccessResult::allowedIfHasPermission($account, 'create race teams')
    ->cachePerPermissions();
}

/**
 * Implements hook_webform_element_alter().
 *
 * Restricts the race_team field's options to teams belonging to the race
 * this form was opened for. Users with 'view all race team names' get the
 * race_day plugin so they see all published teams for that race without the
 * Group module's membership restrictions filtering the list; everyone else
 * keeps the normal access-checked behavior, just scoped to the same race.
 */
function race_day_webform_element_alter(array &$element, FormStateInterface $form_state, array $context): void {
  if (
    ($element['#webform_key'] ?? NULL) !== 'race_team' ||
    ($element['#target_type'] ?? NULL) !== 'group'
  ) {
    return;
  }

  $race = \Drupal::request()->attributes->get('race');
  $race_id = $race instanceof Race ? $race->id() : NULL;

  if (\Drupal::currentUser()->hasPermission('view all race team names')) {
    $element['#selection_handler'] = 'race_day:race_team_name';
    $element['#selection_settings'] = $race_id ? ['race_id' => $race_id] : [];
    return;
  }

  if ($race_id) {
    $element['#selection_handler'] = 'race_day:race_team_by_race';
    $element['#selection_settings']['race_id'] = $race_id;
  }
}

/**
 * Implements hook_entity_access().
 *
 * Group 3.x's access handler only checks group-level role permissions and
 * ignores Drupal-level permissions entirely. This hook grants view/manage
 * access to race_team groups based on race_day's own permissions.
 */
function race_day_entity_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResult {
  if ($entity->getEntityTypeId() !== 'group' || $entity->bundle() !== 'race_team') {
    return AccessResult::neutral();
  }
  if ($operation === 'view') {
    return AccessResult::allowedIfHasPermission($account, 'view all race day groups')
      ->orIf(AccessResult::allowedIfHasPermission($account, 'view all race team names'))
      ->cachePerPermissions();
  }
  if (in_array($operation, ['update', 'delete'], TRUE)) {
    return AccessResult::allowedIfHasPermission($account, 'manage race day groups')
      ->cachePerPermissions();
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_ENTITY_TYPE_access() for webform_submission.
 *
 * The race_day_runner_team_request webform has no view_any/view_own access
 * configured, so by default only full webform admins can view its
 * submissions — not the team captains/admins who can already see them via
 * the race_team_requests view/block (race_day_views_pre_render()), nor the
 * runner who submitted it in the first place (e.g. the Pace/Status columns
 * of their own row in the "My Team Requests" block on /admin/race-day/my-teams
 * otherwise render blank, since Views' webform submission value field checks
 * this same entity access). This grants matching 'view' access for all three
 * cases: reviewers with 'review all race team requests', team captains/admins
 * (with 'review own race team requests') viewing a submission for their own
 * team, or the submission's own owner.
 */
function race_day_webform_submission_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResult {
  if ($operation !== 'view' || $entity->getWebform()->id() !== 'race_day_runner_team_request') {
    return AccessResult::neutral();
  }

  if ($account->hasPermission('review all race team requests')) {
    return AccessResult::allowed()->cachePerPermissions();
  }

  if ((int) $entity->getOwnerId() === (int) $account->id() && !$account->isAnonymous()) {
    return AccessResult::allowed()->cachePerUser()->addCacheableDependency($entity);
  }

  if ($account->hasPermission('review own race team requests')) {
    $team_id = (int) $entity->getElementData('race_team');
    if ($team_id) {
      $group = \Drupal::entityTypeManager()->getStorage('group')->load($team_id);
      if ($group && _race_day_is_team_captain_or_admin($group, $account)) {
        return AccessResult::allowed()->cachePerPermissions()->cachePerUser()->addCacheableDependency($entity);
      }
    }
  }

  return AccessResult::neutral();
}

/**
 * Determines whether an account may cancel a race team request.
 *
 * Anyone who can already view the submission (the submitter, a reviewer, or
 * the team's captain/admin — see race_day_webform_submission_access())
 * may cancel it, but only while it's still active (not already denied or
 * canceled — the same "active request" definition used elsewhere, e.g.
 * _race_day_runner_team_request_ineligibility_reason()).
 */
function _race_day_can_cancel_team_request(WebformSubmissionInterface $submission, AccountInterface $account): bool {
  if ($submission->getWebform()->id() !== 'race_day_runner_team_request') {
    return FALSE;
  }
  $status = $submission->getElementData('request_status') ?? '';
  if (in_array($status, ['denied', 'canceled'], TRUE)) {
    return FALSE;
  }
  return race_day_webform_submission_access($submission, 'view', $account)->isAllowed();
}

/**
 * Implements hook_entity_operation().
 *
 * Adds a "Cancel" operation to race_day_runner_team_request webform
 * submissions in the "Team Requests"/"My Team Requests" views (both use the
 * entity_operations Views field, which already surfaces webform's own
 * "View" operation here — this hook is the standard way to add another
 * alongside it, no Views config changes needed). Opens as a confirmation
 * modal (CancelTeamRequestForm) rather than acting immediately.
 */
function race_day_entity_operation(EntityInterface $entity): array {
  if (!$entity instanceof WebformSubmissionInterface) {
    return [];
  }
  if (!_race_day_can_cancel_team_request($entity, \Drupal::currentUser())) {
    return [];
  }

  return [
    'cancel' => [
      'title' => t('Cancel'),
      'weight' => 20,
      'url' => \Drupal\Core\Url::fromRoute('race_day.cancel_team_request', ['webform_submission' => $entity->id()]),
      'attributes' => [
        'class' => ['use-ajax'],
        'data-dialog-type' => 'modal',
        'data-dialog-options' => \Drupal\Component\Serialization\Json::encode(['width' => 400]),
      ],
    ],
  ];
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for race templates.
 *
 * Adds a per-view-mode suggestion so Drupal looks for race--{view_mode}.html.twig
 * (e.g. race--card.html.twig) before falling back to race.html.twig.
 */
function race_day_theme_suggestions_race_alter(array &$suggestions, array $variables): void {
  $view_mode = $variables['elements']['#view_mode'] ?? NULL;
  if ($view_mode) {
    $suggestions[] = 'race__' . strtr($view_mode, '-', '_');
  }
}

/**
 * Implements hook_token_info().
 */
function race_day_token_info(): array {
  return [
    'tokens' => [
      'webform_submission' => [
        'team-captain-emails' => [
          'name' => t('Team captain email addresses'),
          'description' => t("Comma-separated email addresses of every user with the 'Team Captain' role on the race_team group referenced by this submission's race_team field."),
        ],
      ],
    ],
  ];
}

/**
 * Implements hook_tokens().
 */
function race_day_tokens($type, $tokens, array $data, array $options, \Drupal\Core\Render\BubbleableMetadata $bubbleable_metadata): array {
  $replacements = [];

  if ($type !== 'webform_submission' || empty($data['webform_submission'])) {
    return $replacements;
  }

  if (isset($tokens['team-captain-emails'])) {
    $replacements[$tokens['team-captain-emails']] = _race_day_team_captain_emails($data['webform_submission']);
  }

  return $replacements;
}

/**
 * Returns a comma-separated list of Team Captain emails for the race_team
 * group referenced by a webform submission's 'race_team' element.
 *
 * Uses a direct query against group_relationship_field_data rather than
 * Group module's virtual relationship chain, for the same reason as
 * RaceTeamMemberFilter/RaceTeamCurrentUserMemberFilter: that chain produces
 * invalid SQL (empty column alias) on DISTINCT queries.
 */
function _race_day_team_captain_emails(\Drupal\webform\WebformSubmissionInterface $submission): string {
  $gid = $submission->getElementData('race_team');
  if (empty($gid)) {
    return '';
  }

  $query = \Drupal::database()->select('group_relationship_field_data', 'gr');
  $query->fields('gr', ['entity_id']);
  $query->innerJoin('group_relationship__group_roles', 'roles', 'roles.entity_id = gr.id');
  $query->condition('gr.gid', $gid);
  $query->condition('gr.plugin_id', 'group_membership');
  $query->condition('roles.group_roles_target_id', 'race_team-team_captain');
  $query->distinct();
  $uids = $query->execute()->fetchCol();

  if (empty($uids)) {
    return '';
  }

  $addresses = [];
  foreach (\Drupal::entityTypeManager()->getStorage('user')->loadMultiple($uids) as $user) {
    if ($mail = $user->getEmail()) {
      $addresses[] = $mail;
    }
  }

  return implode(',', $addresses);
}

/**
 * Implements hook_theme().
 */
function race_day_theme(): array {
  return [
    'race' => [
      'render element' => 'elements',
      'template' => 'race',
