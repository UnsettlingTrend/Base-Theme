    'field__field_runner_legs' => [
      'base hook' => 'field',
      'template' => 'field--field-runner-legs',
      'path' => \Drupal::service('extension.list.module')->getPath('race_day') . '/templates/field',
    ],
    'views_view_field__race_admin__status' => [
      'base hook' => 'views_view_field',
      'template' => 'views-view-field--race-admin--status',
      'path' => \Drupal::service('extension.list.module')->getPath('race_day') . '/templates/views',
    ],
  ];
}

/**
 * Implements hook_entity_extra_field_info().
 *
 * Registers the "Race Info" pseudo-field so it appears as a placeable block
 * in Layout Builder for race entities.
 */
function race_day_entity_extra_field_info(): array {
  return [
    'race' => [
      'race' => [
        'display' => [
          'race_info_group' => [
            'label' => t('Race Info'),
            'description' => t('Race Date, Total Distance, and Race Status grouped together.'),
            'weight' => 10,
            'visible' => FALSE,
          ],
        ],
      ],
    ],
  ];
}

/**
 * Implements hook_preprocess_field().
 *
 * Uses the base hook rather than suggestion-specific hooks because Drupal's
 * module handler does not reliably discover suggestion-specific preprocess
 * functions in modules.
 */
function race_day_preprocess_field(array &$variables): void {
  if ($variables['field_name'] === 'field_race') {
    $variables['#attached']['library'][] = 'race_day/race_info_group';
  }

  if ($variables['field_name'] === 'field_runner_legs') {
    _race_day_preprocess_field_runner_legs($variables);
  }
}

/**
 * Combines a leg's distance and elevation gain into one display string for
 * the Runner Assignments table's merged Distance/Elevation column, e.g.
 * "5.20 mi, +320 ft". Either half is dropped if not (yet) available —
 * elevation gain in particular can lag behind distance while a leg's
 * Strava route data is still syncing (see strava_api_entity_presave()).
 */
function _race_day_format_leg_stats(string $distance, string $elevation_gain): string {
  $parts = [];
  if ($distance !== '' && is_numeric($distance)) {
    $parts[] = number_format((float) $distance, 2) . ' mi';
  }
  if ($elevation_gain !== '' && is_numeric($elevation_gain)) {
    $parts[] = '+' . number_format((float) $elevation_gain, 0) . ' ft';
  }
  return $parts ? implode(', ', $parts) : '—';
}

/**
 * Preprocess helper for field_runner_legs on race_team group pages.
 */
function _race_day_preprocess_field_runner_legs(array &$variables): void {
  /** @var \Drupal\group\Entity\GroupInterface $group */
  $group = $variables['element']['#object'];

  // Styles the current-runner row highlight; loaded for every viewer, not
  // just members, since the highlight is informational rather than
  // interactive (unlike race_day/runner_assignment below, which is only
  // useful — and so only attached — for members who can act on the table).
  $variables['#attached']['library'][] = 'race_day/runner_legs_display';

  $current_user = \Drupal::currentUser();
  $membership = $group->getMember($current_user);

  $is_member = (bool) $membership;
  $is_captain_or_admin = FALSE;
  $members = [];

  if ($membership) {
    $is_captain_or_admin = _race_day_is_team_captain_or_admin($group, $current_user);

    if ($is_captain_or_admin) {
      foreach ($group->getMembers() as $group_membership) {
        $member = $group_membership->getUser();
        $members[$member->id()] = $member->getDisplayName();
      }
      asort($members);
    }
  }

  $assign_url = '';
  $csrf_token = '';
  $remove_url = '';
  $remove_csrf_token = '';
  if ($is_member) {
    $assign_url = \Drupal\Core\Url::fromRoute('race_day.assign_runner', ['group' => $group->id()])->toString();
    $csrf_token = \Drupal::csrfToken()->get('assign-runner-' . $group->id());
    $remove_url = \Drupal\Core\Url::fromRoute('race_day.remove_runner', ['group' => $group->id()])->toString();
    $remove_csrf_token = \Drupal::csrfToken()->get('remove-runner-' . $group->id());
    $variables['#attached']['library'][] = 'race_day/runner_assignment';
  }

  $rows = [];
  foreach ($variables['element']['#items'] as $item) {
    /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
    $paragraph = $item->entity;
    if (!$paragraph) {
      continue;
    }

    $leg_number = '';
    $leg_name = '';
    $leg_url = '';
    $leg_distance = '';
    $leg_elevation_gain = '';
    if ($paragraph->hasField('field_race_day_leg') && !$paragraph->get('field_race_day_leg')->isEmpty()) {
      /** @var \Drupal\race_day\Entity\RaceLeg $leg */
      $leg = $paragraph->get('field_race_day_leg')->entity;
      if ($leg) {
        $leg_number = $leg->get('leg_number')->value;
        $leg_name = $leg->label();
        $leg_url = $leg->toUrl('canonical')->toString();
        $leg_distance = $leg->getDistance() ?? '';
        $leg_elevation_gain = $leg->getElevationGain() ?? '';
      }
    }

    $leg_start = _race_day_leg_assignment_moment($paragraph, 'field_actual_start', 'field_expected_start');
    $leg_finish = _race_day_leg_assignment_moment($paragraph, 'field_actual_finish', 'field_expected_finish');
    $leg_time = _race_day_leg_assignment_time($paragraph);

    $runner_name = '';
    $runner_id = NULL;
    $has_runner = FALSE;
    if ($paragraph->hasField('field_race_day_runner') && !$paragraph->get('field_race_day_runner')->isEmpty()) {
      /** @var \Drupal\user\Entity\User $runner */
      $runner = $paragraph->get('field_race_day_runner')->entity;
      if ($runner) {
        $runner_name = $runner->getDisplayName();
        $runner_id = (int) $runner->id();
        $has_runner = TRUE;
      }
    }

    $can_remove = FALSE;
    if ($has_runner && $is_captain_or_admin) {
      $can_remove = TRUE;
    }
    elseif ($has_runner && $is_member && $runner_id === (int) $current_user->id()) {
      $can_remove = TRUE;
    }

    $current_runner = $paragraph->hasField('field_race_day_leg_status') && $paragraph->get('field_race_day_leg_status')->value === 'running';

    $rows[] = [
      'paragraph_id'       => $paragraph->id(),
      'leg_number'         => $leg_number,
      'leg_name'           => $leg_name,
      'leg_url'            => $leg_url,
      'leg_distance'       => $leg_distance,
      'leg_elevation_gain' => $leg_elevation_gain,
      'leg_stats'          => _race_day_format_leg_stats($leg_distance, $leg_elevation_gain),
      'leg_start'          => $leg_start,
      'leg_finish'         => $leg_finish,
      'leg_time'           => $leg_time,
      'runner'             => $runner_name,
      'runner_id'          => $runner_id,
      'has_runner'         => $has_runner,
      'can_remove'         => $can_remove,
      'current_runner'     => $current_runner,
    ];
  }

  usort($rows, fn($a, $b) => $a['leg_number'] <=> $b['leg_number']);

  $variables['group_id']              = $group->id();
  $variables['runner_assignment_rows'] = $rows;
  $variables['is_member']             = $is_member;
  $variables['is_captain_or_admin']   = $is_captain_or_admin;
  $variables['members']               = $members;
  $variables['current_user_id']       = $current_user->id();
  $variables['assign_url']            = $assign_url;
  $variables['csrf_token']            = $csrf_token;
  $variables['remove_url']            = $remove_url;
  $variables['remove_csrf_token']     = $remove_csrf_token;
}

/**
 * Implements hook_ENTITY_TYPE_view() for race_leg.
 */
function race_day_race_leg_view(array &$build, RaceLeg $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  $build['#attached']['library'][] = 'race_day/race_leg_fields';
}

/**
 * Implements hook_preprocess_views_view_table().
 *
 * Adds data-leg-number to each row of the race_leg view table so the map
 * highlight behavior can match rows to polylines.
 */
function race_day_preprocess_views_view_table(array &$variables): void {
  if ($variables['view']->id() !== 'race_leg') {
    return;
  }

  foreach ($variables['rows'] as $index => &$row) {
    $result_row = $variables['view']->result[$index] ?? NULL;
    if (!$result_row) {
      continue;
    }
    /** @var \Drupal\race_day\Entity\RaceLeg|null $entity */
    $entity = $result_row->_entity ?? NULL;
    if (!$entity || !$entity->hasField('leg_number')) {
      continue;
    }
    $row['attributes']->setAttribute('data-leg-number', $entity->get('leg_number')->value);
  }
}

/**
 * Implements hook_ENTITY_TYPE_view() for race.
 *
 * Renders the "Race Info" pseudo-field when it is present in the display.
 */
function race_day_race_view(array &$build, Race $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('race');

  $field_labels = [
    'race_date'      => t('Date'),
    'total_distance' => t('Total Distance'),
    'status'         => t('Status'),
  ];

  // Formatter options per field — mirrors what the Layout Builder blocks used.
  $formatter_options = [
    'race_date'      => ['type' => 'datetime_default', 'settings' => ['format_type' => 'article_date_and_time']],
    'total_distance' => ['type' => 'number_decimal', 'settings' => ['scale' => 2, 'prefix_suffix' => TRUE]],
    'status'         => ['type' => 'list_default', 'settings' => []],
  ];

  $group = [
    '#type' => 'container',
    '#attributes' => ['class' => ['race-info-group']],
    '#attached' => ['library' => ['race_day/race_info_group']],
    'heading' => [
      '#type' => 'html_tag',
      '#tag' => 'h2',
      '#value' => t('Race Info'),
    ],
  ];

  foreach ($field_labels as $field_name => $label_text) {
    $options = $formatter_options[$field_name] + ['label' => 'hidden', 'weight' => 0];

    $group[$field_name] = [
      '#type' => 'container',
      '#attributes' => ['class' => ['race-info-field']],
      'field_label' => [
        '#type' => 'html_tag',
        '#tag' => 'span',
        '#value' => $label_text,
        '#attributes' => ['class' => ['race-info-field__label']],
      ],
      'value' => $view_builder->viewField($entity->get($field_name), $options),
    ];
  }

  $build['race_info_group'] = $group;
}

/**
 * Implements hook_form_alter().
 */
function race_day_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof EntityFormInterface) {
    return;
  }
  $entity = $form_object->getEntity();

  if ($entity->getEntityTypeId() === 'group' && $entity->bundle() === 'race_team') {
    if ($form_object->getOperation() === 'delete') {
      // Cancel should return to the team's own page, not core's
      // ContentEntityDeleteForm::getCancelUrl() default of
      // $entity->toUrl('collection') — Group's "collection" link template
      // is /admin/group (see the #[ContentEntityType] handlers in
      // Drupal\group\Entity\Group), a generic admin listing rather than
      // anywhere related to the team someone was just looking at.
      if (isset($form['actions']['cancel'])) {
        $form['actions']['cancel']['#url'] = $entity->toUrl();
      }
      return;
    }

    if ($entity->isNew()) {
      $race_id = \Drupal::request()->query->get('race_id');

      if (isset($form['field_race'])) {
        // Validate that the chosen race has open registration.
        // NOTE: hook_form_alter runs before doBuildForm applies element info
        // defaults, so #element_validate doesn't exist yet. Setting it here
        // (rather than appending) means we must explicitly include the core
        // EntityAutocomplete validator so it is not skipped.
        $form['field_race']['widget'][0]['target_id']['#element_validate'] = [
          [EntityAutocomplete::class, 'validateEntityAutocomplete'],
          'race_day_field_race_validate_open_registration',
        ];

        // Pre-populate and lock the field when race_id is in the URL.
        if ($race_id) {
          $race = \Drupal::entityTypeManager()->getStorage('race')->load((int) $race_id);
          if ($race) {
            $form['field_race']['widget'][0]['target_id']['#default_value'] = $race;
            // Disable the widget so the user cannot change the value.
            // Drupal's form API keeps #default_value as the submitted value
            // for disabled elements, so the race is still saved correctly.
            $form['field_race']['widget'][0]['target_id']['#disabled'] = TRUE;
          }
        }
      }
      $form['revision_information']['#access'] = FALSE;
      $form['path']['#access'] = FALSE;
      // Leg assignments are created after save; hide the field on the add form.
      $form['field_runner_legs']['#access'] = FALSE;
      // Add our post-save handler to every submit button in the actions group.
      // The Group form's Save button has its own #submit array, so appending to
      // $form['#submit'] alone would be ignored.
      $actions = $form['actions'] ?? [];
      foreach (Element::children($actions) as $action) {
        if (($form['actions'][$action]['#type'] ?? '') === 'submit') {
          $form['actions'][$action]['#submit'][] = 'race_day_race_team_create_submit';
        }
      }
    }
    else {
      // Race is locked to whatever was chosen at creation — not editable on
      // the edit form. Hide the real widget (#access = FALSE keeps its
      // already-correct #default_value, the current field_race entity,
      // from being processed as input — same mechanism the add form above
      // relies on for its own URL-driven lock, and the same reason
      // #access = FALSE elements are skipped during validation, so the
      // field being required doesn't block this form even though nothing
      // here submits a value for it) and show the race's label as plain
      // text instead — a disabled/greyed-out input would still look like
      // an editable field, not "regular text".
      if (isset($form['field_race']['widget'][0]['target_id'])) {
        $form['field_race']['widget'][0]['target_id']['#access'] = FALSE;

        /** @var \Drupal\race_day\Entity\Race|null $race */
        $race = $entity->get('field_race')->entity;
        $form['field_race_display'] = [
          '#type' => 'item',
          '#title' => $entity->getFieldDefinition('field_race')->getLabel(),
          '#markup' => $race ? $race->label() : t('— None —'),
          '#weight' => $form['field_race']['#weight'] ?? 0,
        ];
      }

      // On the edit form, show existing assignments but lock add/remove
      // controls — restricted to users with the 'edit runner assignments on
      // race team edit form' permission (race_day.permissions.yml); anyone
      // without it doesn't see the field on this form at all, same as the
      // add form above always hides it.
      if (\Drupal::currentUser()->hasPermission('edit runner assignments on race team edit form')) {
        if (isset($form['field_runner_legs']['widget'])) {
          $widget = &$form['field_runner_legs']['widget'];
          $widget['add_more']['#access'] = FALSE;
          foreach (Element::children($widget) as $delta) {
            if (is_numeric($delta) && isset($widget[$delta]['top']['links'])) {
              $widget[$delta]['top']['links']['#access'] = FALSE;
            }
          }
        }
      }
      else {
        $form['field_runner_legs']['#access'] = FALSE;
      }
    }
  }

  if (!$entity instanceof Race) {
    return;
  }
  if (isset($form['total_distance']['widget'][0]['value'])) {
    $form['total_distance']['widget'][0]['value']['#disabled'] = TRUE;
    $form['total_distance']['widget'][0]['value']['#description'] = t('Automatically calculated from the sum of all race leg distances.');
  }
}

/**
 * Implements hook_query_race_access_alter().
 *
 * In entity reference contexts (autocomplete suggestions and ValidReference
 * constraint), limit the selectable races to those with registration open for
 * unprivileged users. Without this filter the autocomplete could suggest a
 * race that is not registration_open, and the subsequent ValidReference check
 * would reject it with a confusing "does not exist" error.
 */
function race_day_query_race_access_alter(\Drupal\Core\Database\Query\AlterableInterface $query): void {
  // Only restrict in entity reference queries (autocomplete + ValidReference).
  if (!$query->hasTag('entity_reference')) {
    return;
  }
  // Administrators and coordinators may reference races of any status.
  $account = \Drupal::currentUser();
  if ($account->hasPermission('administer race_day') || $account->hasPermission('manage race_day races')) {
    return;
  }
  $query->condition('base_table.status', 'registration_open');
}

/**
 * Element validate callback for field_race on the race_team add form.
 *
 * Rejects races whose registration is not open. Runs after
 * EntityAutocomplete::validateEntityAutocomplete, which resolves the
 * autocomplete string to an entity ID in form state.
 */
function race_day_field_race_validate_open_registration(array &$element, FormStateInterface $form_state): void {
  $race_id = $form_state->getValue($element['#parents']);
  if (empty($race_id)) {
    return;
  }

  $race = \Drupal::entityTypeManager()->getStorage('race')->load((int) $race_id);
  if ($race && $race->get('status')->value !== 'registration_open') {
    $form_state->setError($element, t('Registration for %race is not currently open.', ['%race' => $race->label()]));
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for race_leg.
 */
function race_day_race_leg_insert(RaceLeg $leg): void {
  $race_id = $leg->get('race_id')->target_id;
  if ($race_id) {
    _race_day_recalculate_total_distance((int) $race_id);
  }
}

/**
 * Implements hook_ENTITY_TYPE_update() for race_leg.
 */
function race_day_race_leg_update(RaceLeg $leg): void {
  $race_id = $leg->get('race_id')->target_id;
  if ($race_id) {
    _race_day_recalculate_total_distance((int) $race_id);
  }
  // Recalculate the old race too if the leg was moved to a different race.
  $original_race_id = $leg->original?->get('race_id')->target_id;
  if ($original_race_id && $original_race_id !== $race_id) {
    _race_day_recalculate_total_distance((int) $original_race_id);
  }
}

/**
 * Implements hook_ENTITY_TYPE_delete() for race_leg.
 */
function race_day_race_leg_delete(RaceLeg $leg): void {
  $race_id = $leg->get('race_id')->target_id;
  if ($race_id) {
    _race_day_recalculate_total_distance((int) $race_id);
  }
}

/**
 * Sums all race leg distances for the given race and saves the total.
 */
function _race_day_recalculate_total_distance(int $race_id): void {
  $storage = \Drupal::entityTypeManager()->getStorage('race');
  $race = $storage->load($race_id);
  if (!$race instanceof Race) {
    return;
  }

  $leg_ids = \Drupal::entityQuery('race_leg')
    ->condition('race_id', $race_id)
    ->accessCheck(FALSE)
    ->execute();

  $total = 0.0;
  if ($leg_ids) {
    $legs = \Drupal::entityTypeManager()->getStorage('race_leg')->loadMultiple($leg_ids);
    foreach ($legs as $leg) {
      $total += (float) ($leg->getDistance() ?? 0);
    }
  }

  $race->set('total_distance', round($total, 2));
  $race->save();
}

/**
 * Submit handler for the race_team add form.
 *
 * Fires after the new group entity has been saved and has a real ID. Creates
 * one race_day_leg_assignment paragraph per race leg, fills in field_race_day_leg,
 * then re-saves the group to attach them via field_runner_legs.
 */
function race_day_race_team_create_submit(array &$form, FormStateInterface $form_state): void {
  // Reload the entity from storage so we have clean state after the initial save.
  $id = $form_state->getFormObject()->getEntity()->id();
  /** @var \Drupal\group\Entity\GroupInterface $race_team */
  $race_team = \Drupal::entityTypeManager()->getStorage('group')->load($id);
  if (!$race_team) {
    return;
  }

  $race = $race_team->get('field_race')->entity;
  if (!$race) {
    return;
  }

  $leg_ids = \Drupal::entityQuery('race_leg')
    ->condition('race_id', $race->id())
    ->sort('leg_number', 'ASC')
    ->accessCheck(FALSE)
    ->execute();

  if (empty($leg_ids)) {
    return;
  }

  // Delete any stray empty paragraphs the widget may have auto-created.
  foreach ($race_team->get('field_runner_legs')->referencedEntities() as $existing) {
    $existing->delete();
  }

  // loadMultiple keys by entity ID; restore the leg_number sort order.
  $legs_by_id = \Drupal::entityTypeManager()->getStorage('race_leg')->loadMultiple($leg_ids);
  $legs = array_map(fn($id) => $legs_by_id[$id], $leg_ids);

  $items = $race_team->get('field_runner_legs');
  $items->setValue([]);
  foreach ($legs as $leg) {
    $paragraph = Paragraph::create([
      'type' => 'race_day_leg_assignment',
      'field_race_day_leg' => $leg,
    ]);
    $paragraph->setParentEntity($race_team, 'field_runner_legs');
    $paragraph->save();
    $items->appendItem($paragraph);
  }

  $race_team->save();
}

/**
 * Implements hook_page_attachments().
 */
function race_day_page_attachments(array &$attachments): void {
  // Gin is a THEME, not a module — moduleExists('gin') is always FALSE and
  // silently short-circuited this hook on every page load.
  if (!\Drupal::service('theme_handler')->themeExists('gin')) {
    return;
  }
  try {
    $icon_path = \Drupal::service('extension.list.theme')->getPath('ut_material') . '/dist/images/races-run.svg';
  }
  catch (\Exception $e) {
    return;
  }
  // A standalone SVG file, not a #fragment reference into Gin's shared
  // sprite.svg: mask-image support for URL fragments pointing at a <symbol>
  // inside an external SVG is inconsistent across browsers (notably Chrome),
  // even when the symbol ID genuinely exists in the sprite — the icon simply
  // fails to resolve and Gin's fallback square shows instead.
  $icon_url = base_path() . $icon_path;
  // 23px = Gin's own --gin-icon-size-toolbar (20px) at +15%. The size/
  // position rule below needs to beat Gin's own
  // #toolbar-item-administration-tray .toolbar-icon::before (an ID
  // selector — see styles/layout/toolbar.scss), so it repeats that same ID
  // to tie its specificity rather than losing to it; the !important is
  // extra insurance rather than relying solely on this <style> tag's late
  // position in <head> to win that tie on source order (same reasoning as
  // .gin-secondary-toolbar--frontend's override in admin_toolbar.scss).
  // inset-inline-start recreates Gin's own centering formula
  // (styles/layout/toolbar.scss) for the new size instead of the old 20px.
  $css = '.toolbar .toolbar-bar .toolbar-icon-race-day-admin::before { --icon: url("' . $icon_url . '"); }'
    . '@media (min-width: 976px) {'
    . '#toolbar-item-administration-tray .toolbar-icon-race-day-admin::before {'
    . 'width: 23px !important;'
    . 'height: 23px !important;'
    . 'inset-inline-start: calc((var(--gin-toolbar-width-collapsed) - 23px) / 2 - 9px) !important;'
    . '}'
    . '}';
  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'style',
      '#value' => $css,
      '#attributes' => ['data-race-day-toolbar' => ''],
    ],
    'race_day_toolbar_icon',
  ];
}

function template_preprocess_race(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];
  $variables['race'] = $variables['elements']['#race'];
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }

  $variables['url'] = $variables['race']->toUrl('canonical')->toString();

  $variables['#attached']['library'][] = 'race_day/race_display';

  $variables['register_team_url'] = NULL;
  $variables['join_team_url'] = NULL;
  if ($variables['view_mode'] === 'full' && $variables['race']->get('status')->value === 'registration_open') {
    $race = $variables['race'];
    $team_count = _race_day_count_teams_for_race((int) $race->id());

    $group_type_storage = \Drupal::entityTypeManager()->getStorage('group_type');
    if ($group_type_storage->load('race_team')) {
      $max_teams = $race->get('max_teams')->value;
      $under_cap = $max_teams === NULL || $team_count < (int) $max_teams;

      if ($under_cap) {
        $add_url = \Drupal\Core\Url::fromRoute('entity.group.add_form', ['group_type' => 'race_team'], [
          'query' => ['race_id' => $race->id()],
        ]);
        if ($add_url->access()) {
          $variables['register_team_url'] = $add_url;
        }
      }
    }

    if ($team_count > 0) {
      $join_url = \Drupal\Core\Url::fromRoute('race_day.runner_team_request', ['race' => $race->id()]);
      if ($join_url->access()) {
        $variables['join_team_url'] = $join_url;
      }
    }
  }

  // Anonymous users never pass the access checks above (no 'create race
  // teams' or 'request to join race team' permission), so they'd otherwise
  // see no call to action at all. Point them at login/registration instead,
  // landing back on this race afterward.
  $variables['login_to_register_url'] = NULL;
  if ($variables['view_mode'] === 'full'
    && $variables['race']->get('status')->value === 'registration_open'
    && \Drupal::currentUser()->isAnonymous()
    && !$variables['register_team_url']
    && !$variables['join_team_url']) {
    $variables['login_to_register_url'] = \Drupal\Core\Url::fromRoute('user.login', [], [
      'query' => ['destination' => $variables['url']],
    ]);
  }
}

/**
 * Returns the number of race_team groups that reference the given race.
 */
function _race_day_count_teams_for_race(int $race_id): int {
  $ids = \Drupal::entityQuery('group')
    ->condition('type', 'race_team')
    ->condition('field_race', $race_id)
    ->accessCheck(FALSE)
    ->execute();
  return count($ids);
}

/**
 * Determines whether a race_team group has reached its race's runner cap.
 *
 * max_runners_per_team lives on the race, not the team, so every team for a
 * given race shares the same cap. NULL (or a team with no linked race) means
 * unlimited.
 */
function _race_day_team_is_full(GroupInterface $team): bool {
  $race = $team->hasField('field_race') ? $team->get('field_race')->entity : NULL;
  if (!$race) {
    return FALSE;
  }
  $max_runners = $race->get('max_runners_per_team')->value;
  if ($max_runners === NULL) {
    return FALSE;
  }
  return count($team->getMembers()) >= (int) $max_runners;
}

/**
 * Implements hook_webform_submission_form_alter().
 *
 * When the waiver form is submitted from the race registration modal, override
 * the webform's configured confirmation redirect so the user lands on the team
 * registration form instead.
 */
function race_day_webform_submission_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $request = \Drupal::request();
  $route = $request->attributes->get('_route');
  /** @var \Drupal\race_day\Entity\Race|null $race */
  $race = $request->attributes->get('race');

  if (!$race instanceof Race) {
    return;
  }

  // Waiver form: override confirmation redirect based on where the user came from.
  if ($route === 'race_day.waiver_modal') {
    $return_route = $request->query->get('return_route');
    if ($return_route === 'race_day.runner_team_request') {
      // Carry the pre-selected team back through — WaiverGateSubscriber
      // forwards it onto this request's query string as ?group= (see that
      // class), which is what this same function's own
      // race_day.runner_team_request branch below reads to pre-fill and
      // lock the Race Team field. Without this, a user who clicked
      // "Request to Join Team" for a specific team, then had to fill out a
      // waiver first, would land back on this form with no memory of which
      // team they'd originally chosen.
      $query = [];
      $group_id = $request->query->get('group');
      if ($group_id) {
        $query['group'] = $group_id;
      }
      $destination = \Drupal\Core\Url::fromRoute('race_day.runner_team_request', ['race' => $race->id()], [
        'query' => $query,
      ])->toString();
    }
    else {
      $destination = \Drupal\Core\Url::fromRoute('entity.group.add_form', ['group_type' => 'race_team'], [
        'query' => ['race_id' => $race->id()],
      ])->toString();
    }

    $form_state->set('race_register_destination', $destination);

    if (!empty($form['actions'])) {
      foreach (Element::children($form['actions']) as $key) {
        if (($form['actions'][$key]['#type'] ?? '') === 'submit') {
          $form['actions'][$key]['#submit'][] = '_race_day_waiver_post_submit';
        }
      }
    }
  }

  // Runner team request form: pre-fill and lock the race field.
  if ($route === 'race_day.runner_team_request') {
    $account = \Drupal::currentUser();
    if (_race_day_runner_team_request_ineligibility_reason($account, (string) $race->id())) {
      // Ineligible up front (already on a team for this race, or already has
      // an active request in) — disable the whole form rather than letting
      // the user fill it out only to be rejected by
      // _race_day_runner_team_request_validate_unique_race() on submit.
      // Setting #disabled here isn't enough on its own: webform's own
      // entity-select elements (e.g. race_team) rebuild their #options and
      // #disabled in their own #process callbacks, which run after this
      // alter and clobber whatever we set here. A #pre_render callback runs
      // last, right before rendering, so it has the final say.
      // #pre_render callbacks must be a class method on a
      // TrustedCallbackInterface implementation or an anonymous function —
      // a bare function name string isn't allowed — so wrap it in a closure.
      $form['#disabled'] = TRUE;
      $form['#pre_render'][] = function (array $element): array {
        return _race_day_runner_team_request_force_disable($element);
      };
      \Drupal::messenger()->addError(t('You\'re either already a member of a team for this race, or have an outstanding request to join a team. Check your Team status at <a href=":url">My Teams</a>.', [
        ':url' => \Drupal\Core\Url::fromRoute('race_day.my_teams')->toString(),
      ]));
    }

    if (isset($form['elements']['race'])) {
      $form['elements']['race']['#default_value'] = $race->id();
      $form['elements']['race']['#disabled'] = TRUE;
    }

    // Restrict the Race Team options to teams belonging to this race, and
    // exclude any team already at its race's max_runners_per_team cap. The
    // #selection_handler swap in race_day_webform_element_alter() runs
    // before WebformElementManager::buildElement() resolves #options (it
    // only affects server-side validation), so the rendered option list has
    // to be pruned here instead, once #options already reflects the
    // unfiltered handler.
    if (isset($form['elements']['race_team']['#options']) && is_array($form['elements']['race_team']['#options'])) {
      $group_storage = \Drupal::entityTypeManager()->getStorage('group');
      foreach ($form['elements']['race_team']['#options'] as $key => $label) {
        if ($key === '') {
          continue;
        }
        $team = $group_storage->load($key);
        if (!$team || (string) $team->get('field_race')->target_id !== (string) $race->id() || _race_day_team_is_full($team)) {
          unset($form['elements']['race_team']['#options'][$key]);
        }
      }
    }

    // If a specific team was linked from the race_teams block, pre-fill and
    // lock the race_team field too.
    $group_id = (int) $request->query->get('group');
    if ($group_id && isset($form['elements']['race_team'])) {
      $form['elements']['race_team']['#default_value'] = $group_id;
      $form['elements']['race_team']['#disabled'] = TRUE;
    }

    // Block duplicate submissions for the same race.
    $form['#validate'][] = '_race_day_runner_team_request_validate_unique_race';

    // After a successful request, land the user back on the team's own
    // page (e.g. to see their pending request reflected in its roster)
    // instead of the webform's generic default confirmation page. Appended
    // to the submit button's own #submit array — same reasoning as
    // _race_day_waiver_post_submit() above: Webform's submit button
    // carries its own #submit handlers, which would shadow a form-level
    // $form['#submit'][] append.
    if (!empty($form['actions'])) {
      foreach (Element::children($form['actions']) as $key) {
        if (($form['actions'][$key]['#type'] ?? '') === 'submit') {
          $form['actions'][$key]['#submit'][] = '_race_day_runner_team_request_redirect_to_team';
        }
      }
    }
  }
}

/**
 * Submit handler for the runner team request webform.
 *
 * Redirects to the race team's own page after a successful request. Runs
 * after Webform's own submission handling (which is what sets its
 * configured default-confirmation-page redirect), so this simply
 * overwrites that with the team's URL — last write to
 * $form_state->setRedirectUrl() wins.
 */
function _race_day_runner_team_request_redirect_to_team(array &$form, FormStateInterface $form_state): void {
  $team_id = (int) $form_state->getValue('race_team');
  if (!$team_id) {
    return;
  }

  $team = \Drupal::entityTypeManager()->getStorage('group')->load($team_id);
  if ($team) {
    $form_state->setRedirectUrl($team->toUrl());
  }
}

/**
 * #pre_render callback that force-disables every input element in a form.
 *
 * Runs immediately before rendering, after all #process callbacks (including
 * webform's own, which rebuild entity-select elements like race_team and
 * would otherwise silently re-enable them if we only set #disabled earlier
 * in hook_webform_submission_form_alter()).
 */
function _race_day_runner_team_request_force_disable(array $element): array {
  foreach (Element::children($element) as $key) {
    $element[$key] = _race_day_runner_team_request_force_disable($element[$key]);
  }
  if (!empty($element['#input'])) {
    $element['#disabled'] = TRUE;
    $element['#attributes']['disabled'] = 'disabled';
  }
  return $element;
}

/**
 * Validation callback for the runner team request webform.
 *
 * Prevents a user from submitting a request for a race they're already
 * racing in — either as a standing member of one of its teams, or via an
 * awaiting-review/approved request for one of its teams that hasn't been
 * denied or canceled. This is a defense-in-depth backstop: the same check
 * already disables the form up front in race_day_webform_submission_form_alter(),
 * but this still runs server-side in case the request outraces that (e.g. a
 * stale cached form render, or a direct POST).
 */
function _race_day_runner_team_request_validate_unique_race(array &$form, FormStateInterface $form_state): void {
  $account = \Drupal::currentUser();
  if ($account->isAnonymous()) {
    return;
  }

  // The race field is disabled and pre-filled, so read from the route, not
  // form state (disabled fields are excluded from submitted values).
  $race = \Drupal::request()->attributes->get('race');
  if (!$race instanceof Race) {
    return;
  }

  switch (_race_day_runner_team_request_ineligibility_reason($account, (string) $race->id())) {
    case 'member':
      $form_state->setErrorByName('race', t('You are already on a team for this race.'));
      break;

    case 'request':
      $form_state->setErrorByName('race', t('You have already submitted a request to join a team for this race.'));
      break;
  }
}

/**
 * Determines whether an account is ineligible to request to join a team.
 *
 * @return string|null
 *   'member' if already a standing member of a race_team group for this
 *   race, 'request' if there's already an awaiting-review/approved request
 *   in for this race, or NULL if eligible.
 */
function _race_day_runner_team_request_ineligibility_reason(AccountInterface $account, string $race_id): ?string {
  if ($account->isAnonymous()) {
    return NULL;
  }

  // Criterion 1: already a member of a race_team group for this race.
  // Direct query rather than Group module's virtual relationship chain, for
  // the same reason as RaceTeamMemberFilter/RaceTeamCurrentUserMemberFilter:
  // that chain produces invalid SQL (empty column alias) on DISTINCT queries.
  $membership_query = \Drupal::database()->select('group_relationship_field_data', 'gr');
  $membership_query->fields('gr', ['gid']);
  $membership_query->innerJoin('group__field_race', 'gf', 'gf.entity_id = gr.gid AND gf.deleted = 0');
  $membership_query->condition('gr.entity_id', $account->id());
  $membership_query->condition('gr.plugin_id', 'group_membership');
  $membership_query->condition('gf.field_race_target_id', $race_id);
  $membership_query->range(0, 1);
  if ($membership_query->execute()->fetchField()) {
    return 'member';
  }

  // Criterion 2: an existing awaiting-review or approved request for this race.
  $existing = \Drupal::entityTypeManager()
    ->getStorage('webform_submission')
    ->loadByProperties([
      'webform_id' => 'race_day_runner_team_request',
      'uid'        => $account->id(),
    ]);

  $inactive_statuses = ['denied', 'canceled'];
  foreach ($existing as $submission) {
    if ((string) $submission->getElementData('race') !== $race_id) {
      continue;
    }
    $status = $submission->getElementData('request_status') ?? '';
    if (!in_array($status, $inactive_statuses, TRUE)) {
      return 'request';
    }
  }

  return NULL;
}

/**
 * Submit handler appended to waiver forms opened from the registration modal.
 *
 * Overrides webform's confirmation redirect so the user proceeds to the team
 * registration form after signing the waiver.
 */
function _race_day_waiver_post_submit(array &$form, FormStateInterface $form_state): void {
  $destination = $form_state->get('race_register_destination');
  if (!$destination) {
    return;
  }
  // Only redirect when the submission was actually saved (not a wizard
  // page-transition where the entity has no ID yet).
  $entity = $form_state->getFormObject()->getEntity();
  if (!$entity->id()) {
    return;
  }
  $form_state->setRedirectUrl(\Drupal\Core\Url::fromUserInput($destination));
}
