{#
/**
 * @file
 * Template for the Runner Assignments field on race_team groups.
 *
 * 5 columns, not the original 8 — Distance/Elevation Gain and
 * Start/Finish/Time were each folded into one combined column
 * (leg_stats, and the Start/Finish/Time markup below) so there's less to
 * scan at any width, and fewer columns for the mobile card layout (see
 * css/runner-legs-table.css) to stack. data-label attributes below are
 * that layout's hook — it turns each <td> into a label:value block below
 * the css/runner-legs-table.css breakpoint, reading them via ::before.
 */
#}
<div{{ attributes.setAttribute('id', 'runner-assignments-' ~ group_id) }}>
  <div class="runner-assignments-heading">
    {% if not label_hidden %}
      <h2 class="field__label">{{ label }}</h2>
    {% endif %}
    <p class="runner-assignments-note">Times in <strong>bold</strong> based off expected paces</p>
  </div>
  <table class="runner-assignments">
    <thead>
      <tr>
        <th>#</th>
        <th>Leg Name</th>
        <th>Distance / Elevation</th>
        <th>Schedule</th>
        <th>Runner</th>
      </tr>
    </thead>
    <tbody>
      {% for row in runner_assignment_rows %}
        <tr{% if row.current_runner %} class="current-runner"{% endif %}>
          <td data-label="#">{{ row.leg_number }}</td>
          <td data-label="Leg Name">
            {% if row.leg_url %}
              <a href="{{ row.leg_url }}">{{ row.leg_name }}</a>
            {% else %}
              {{ row.leg_name }}
            {% endif %}
          </td>
          <td data-label="Distance / Elevation">{{ row.leg_stats }}</td>
          <td class="leg-schedule" data-label="Schedule">
            {% if row.leg_start.value or row.leg_finish.value or row.leg_time.value %}
              {% set schedule_content %}
                {% if row.leg_start.value or row.leg_finish.value %}
                  <span class="leg-time{% if row.leg_start.type %} leg-time--{{ row.leg_start.type }}{% endif %}">{{ row.leg_start.value|default('—') }}</span>
                  <span class="leg-schedule-arrow">→</span>
                  <span class="leg-time{% if row.leg_finish.type %} leg-time--{{ row.leg_finish.type }}{% endif %}">{{ row.leg_finish.value|default('—') }}</span>
                {% endif %}
                {% if row.leg_time.value %}
                  <span class="leg-duration{% if row.leg_time.type %} leg-duration--{{ row.leg_time.type }}{% endif %}">({{ row.leg_time.value }})</span>
                {% endif %}
              {% endset %}
              {% if row.has_runner %}
                <a
                  href="{{ row.schedule_modal_url }}"
                  class="use-ajax leg-schedule-trigger"
                  data-dialog-type="modal"
                  data-dialog-options="{{ row.schedule_dialog_options }}"
                >{{ schedule_content }}</a>
              {% else %}
                {{ schedule_content }}
              {% endif %}
            {% else %}
              —
            {% endif %}
          </td>
          <td data-label="Runner">
            {% if row.has_runner %}
              {{ row.runner }}
              {% if row.can_remove %}
                <button
                  class="runner-remove-btn"
                  aria-label="Remove {{ row.runner }}"
                  data-paragraph-id="{{ row.paragraph_id }}"
                  data-url="{{ remove_url }}"
                  data-csrf-token="{{ remove_csrf_token }}"
                >✕</button>
              {% endif %}
            {% elseif is_captain_or_admin %}
              <select
                class="runner-assign-select"
                data-paragraph-id="{{ row.paragraph_id }}"
                data-url="{{ assign_url }}"
                data-csrf-token="{{ csrf_token }}"
              >
                <option value="">— Assign runner —</option>
                {% for uid, name in members %}
                  <option value="{{ uid }}">{{ name }}</option>
                {% endfor %}
              </select>
            {% elseif is_member %}
              <a
                href="#"
                class="runner-assign-me"
                data-paragraph-id="{{ row.paragraph_id }}"
                data-user-id="{{ current_user_id }}"
                data-url="{{ assign_url }}"
                data-csrf-token="{{ csrf_token }}"
              >Assign me</a>
            {% else %}
              —
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
