{#
/**
 * @file
 * Template for the Runner Assignments field on race_team groups.
 */
#}
<div{{ attributes.setAttribute('id', 'runner-assignments-' ~ group_id) }}>
  {% if not label_hidden %}
    <h2 class="field__label">{{ label }}</h2>
  {% endif %}
  <table class="runner-assignments">
    <thead>
      <tr>
        <th>#</th>
        <th>Leg Name</th>
        <th>Distance</th>
        <th>Elevation Gain</th>
        <th>Start</th>
        <th>Finish</th>
        <th>Time</th>
        <th>Runner</th>
      </tr>
    </thead>
    <tbody>
      {% for row in runner_assignment_rows %}
        <tr>
          <td>{{ row.leg_number }}</td>
          <td>
            {% if row.leg_url %}
              <a href="{{ row.leg_url }}">{{ row.leg_name }}</a>
            {% else %}
              {{ row.leg_name }}
            {% endif %}
          </td>
          <td>{{ row.leg_distance }}</td>
          <td>{{ row.leg_elevation_gain }}</td>
          <td class="leg-time{% if row.leg_start.type %} leg-time--{{ row.leg_start.type }}{% endif %}">{{ row.leg_start.value }}</td>
          <td class="leg-time{% if row.leg_finish.type %} leg-time--{{ row.leg_finish.type }}{% endif %}">{{ row.leg_finish.value }}</td>
          <td class="leg-time{% if row.leg_time.type %} leg-time--{{ row.leg_time.type }}{% endif %}">{{ row.leg_time.value }}</td>
          <td>
            {% if row.has_runner %}
              {{ row.runner }}
              {% if row.can_remove %}
                <button
                  class="runner-remove-btn"
                  aria-label="Remove {{ row.runner }}"
                  data-paragraph-id="{{ row.paragraph_id }}"
                  data-url="{{ remove_url }}"
                  data-csrf-token="{{ remove_csrf_token }}"
                >✕</button>
              {% endif %}
            {% elseif is_captain_or_admin %}
              <select
                class="runner-assign-select"
                data-paragraph-id="{{ row.paragraph_id }}"
                data-url="{{ assign_url }}"
                data-csrf-token="{{ csrf_token }}"
              >
                <option value="">— Assign runner —</option>
                {% for uid, name in members %}
                  <option value="{{ uid }}">{{ name }}</option>
                {% endfor %}
              </select>
            {% elseif is_member %}
              <a
                href="#"
                class="runner-assign-me"
                data-paragraph-id="{{ row.paragraph_id }}"
                data-user-id="{{ current_user_id }}"
                data-url="{{ assign_url }}"
                data-csrf-token="{{ csrf_token }}"
              >Assign me</a>
            {% else %}
              —
            {% endif %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
