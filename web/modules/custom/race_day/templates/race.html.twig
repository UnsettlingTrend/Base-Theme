{#
/**
 * @file
 * Default theme implementation for a Race entity.
 *
 * Available variables:
 * - content: All field items.
 * - race: The Race entity object.
 * - view_mode: View mode, e.g. 'full', 'teaser'.
 * - register_team_url: Url object for the "Register a Team" button, or null.
 */
#}
<article{{ attributes.addClass('race') }}>
  {% if register_team_url or waiver_modal_url %}
    <div class="race__register-action">
      {% if register_team_url %}
        <a href="{{ register_team_url }}" class="mdc-button mdc-button--raised">
          <span class="mdc-button__ripple"></span>
          <span class="mdc-button__label">{{ 'Register a Team'|t }}</span>
        </a>
      {% else %}
        <a href="{{ waiver_modal_url }}"
           class="mdc-button mdc-button--raised use-ajax"
           data-dialog-type="modal"
           data-dialog-options='{"width":720,"title":"{{ 'Participant Waiver'|t }}"}'>
          <span class="mdc-button__ripple"></span>
          <span class="mdc-button__label">{{ 'Register a Team'|t }}</span>
        </a>
      {% endif %}
    </div>
  {% endif %}
  {% if content %}
    {{ content }}
  {% endif %}
</article>

