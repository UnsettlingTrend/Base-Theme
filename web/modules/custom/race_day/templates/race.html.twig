{#
/**
 * @file
 * Default theme implementation for a Race entity.
 *
 * Available variables:
 * - content: All field items.
 * - race: The Race entity object.
 * - view_mode: View mode, e.g. 'full', 'teaser'.
 * - register_team_url: Url object for the "Register a Team" button, or null.
 */
#}
<article{{ attributes.addClass('race') }}>
  {% if register_team_url or join_team_url %}
    <div class="race__register-action">
      {# "Request to Join a Team" takes the primary (raised) spot and goes
         first whenever it's available; "Register a Team" only stays raised
         when it's the sole action on the page. #}
      {% if join_team_url %}
        <a href="{{ join_team_url }}" class="mdc-button mdc-button--raised">
          <span class="mdc-button__ripple"></span>
          <span class="mdc-button__label">{{ 'Request to Join a Team'|t }}</span>
        </a>
      {% endif %}
      {% if register_team_url %}
        <a href="{{ register_team_url }}" class="mdc-button {{ join_team_url ? 'mdc-button--outlined' : 'mdc-button--raised' }}">
          <span class="mdc-button__ripple"></span>
          <span class="mdc-button__label">{{ 'Register a Team'|t }}</span>
        </a>
      {% endif %}
    </div>
  {% endif %}
  {% if content %}
    {{ content }}
  {% endif %}
</article>

