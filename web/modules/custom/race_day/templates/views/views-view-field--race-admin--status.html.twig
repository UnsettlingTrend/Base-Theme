{#
/**
 * @file
 * Status field for the "Races - Admin" view (views.view.race_admin).
 *
 * Marks "Registration Open" with Gin's green success marker — the same
 * .marker.marker--published class Gin already styles green for the node
 * "Published" status on /admin/content (see
 * web/themes/contrib/gin/styles/components/status.scss) — rather than
 * inventing new CSS for it. Every other status renders exactly as Views
 * would by default.
 *
 * Available variables:
 * - view: The view that the field belongs to.
 * - field: The field handler that can process the input.
 * - row: The raw result of the database query that generated this field.
 * - output: The processed output that will normally be used.
 */
#}
{% if row._entity.status.value == 'registration_open' %}
  <span class="marker marker--published">{{ output -}}</span>
{% else %}
  {{ output -}}
{% endif %}
