{#
/**
 * @file
 * Template for the leg schedule modal opened from the Runner Assignments
 * table's Schedule column.
 *
 * `rows` is keyed by 'start'/'finish'/'time', each with: label,
 * expected_display / actual_display (formatted values or '—'), input_type
 * ('time' or 'text'), input_value (raw value to prefill the edit control,
 * from the current actual value), has_actual (whether that row's actual
 * field itself is set, i.e. whether Reset has anything to clear). Edit
 * controls only render when `can_edit` is true — LegScheduleController
 * decides that from the viewer's 'manage race day groups' or 'modify any
 * actual times' permission, not this template. Expected is always
 * read-only here — it's computed from pace, not directly editable.
 *
 * Four columns when can_edit (label, Expected, Actual, actions) so the
 * Edit/Reset/Save/Cancel controls line up in their own column rather than
 * crowding the Actual value; three (no actions column) otherwise.
 *
 * data-leg-name/data-runner-name: Drupal's dialog title is always plain
 * text (core strips HTML from it unconditionally), so leg-schedule-modal.js
 * reads these off this element to rebuild the titlebar with the leg name/
 * runner name as smaller sub-lines once the dialog chrome exists.
 */
#}
<div
  id="leg-schedule-modal-{{ paragraph_id }}"
  class="leg-schedule-modal"
  data-update-url="{{ update_url }}"
  data-paragraph-id="{{ paragraph_id }}"
  data-leg-name="{{ leg_name }}"
  data-runner-name="{{ runner_name }}"
>
  <table class="leg-schedule-table">
    <thead>
      <tr>
        <th></th>
        <th>Expected</th>
        <th>Actual</th>
        {% if can_edit %}
          <th></th>
        {% endif %}
      </tr>
    </thead>
    <tbody>
      {% for key, row in rows %}
        <tr class="leg-schedule-row" data-field="{{ key }}">
          <th class="leg-schedule-row__label" scope="row">{{ row.label }}</th>
          <td class="leg-schedule-row__expected">{{ row.expected_display }}</td>
          <td class="leg-schedule-row__actual">{{ row.actual_display }}</td>
          {% if can_edit %}
            <td class="leg-schedule-row__actions">
              <span class="leg-schedule-actual-actions">
                <button type="button" class="leg-schedule-edit-btn" data-field="{{ key }}">Edit</button>
                {% if row.has_actual %}
                  <button type="button" class="leg-schedule-reset-btn" data-field="{{ key }}" data-label="{{ row.label }}">Reset</button>
                {% endif %}
              </span>
              <span class="leg-schedule-edit-form" hidden>
                {% if row.input_type == 'time' %}
                  <input type="time" step="1" class="leg-schedule-input" value="{{ row.input_value }}">
                {% else %}
                  <input type="text" class="leg-schedule-input" value="{{ row.input_value }}" placeholder="H:MM:SS">
                {% endif %}
                <button type="button" class="leg-schedule-save-btn">Save</button>
                <button type="button" class="leg-schedule-cancel-btn">Cancel</button>
                <span class="leg-schedule-error"></span>
              </span>
            </td>
          {% endif %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
