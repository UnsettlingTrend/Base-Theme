<?php

declare(strict_types=1);

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * Add Strava-imported data fields to the strava_route paragraph type.
 */
function strava_api_update_10001(): void {
  $definitions = [
    'field_elevation_gain' => [
      'type' => 'integer',
      'label' => 'Elevation Gain',
      'settings' => ['unsigned' => TRUE, 'size' => 'normal'],
      'description' => 'Total elevation gain imported from Strava, in feet.',
    ],
    'field_start_lat' => [
      'type' => 'decimal',
      'label' => 'Start Latitude',
      'settings' => ['precision' => 10, 'scale' => 7],
      'description' => '',
    ],
    'field_start_lng' => [
      'type' => 'decimal',
      'label' => 'Start Longitude',
      'settings' => ['precision' => 10, 'scale' => 7],
      'description' => '',
    ],
    'field_end_lat' => [
      'type' => 'decimal',
      'label' => 'End Latitude',
      'settings' => ['precision' => 10, 'scale' => 7],
      'description' => '',
    ],
    'field_end_lng' => [
      'type' => 'decimal',
      'label' => 'End Longitude',
      'settings' => ['precision' => 10, 'scale' => 7],
      'description' => '',
    ],
    'field_route_data' => [
      'type' => 'string_long',
      'label' => 'Route Data',
      'settings' => ['case_sensitive' => FALSE],
      'description' => 'Full Strava route API payload (JSON).',
    ],
    'field_strava_polyline' => [
      'type' => 'string_long',
      'label' => 'Strava Polyline',
      'settings' => ['case_sensitive' => FALSE],
      'description' => 'Full encoded polyline from the Strava route payload.',
    ],
    'field_strava_summary_polyline' => [
      'type' => 'string_long',
      'label' => 'Strava Summary Polyline',
      'settings' => ['case_sensitive' => FALSE],
      'description' => 'Simplified encoded polyline (summary_polyline) from the Strava route payload.',
    ],
  ];

  foreach ($definitions as $field_name => $def) {
    if (!FieldStorageConfig::loadByName('paragraph', $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'paragraph',
        'type' => $def['type'],
        'settings' => $def['settings'],
        'cardinality' => 1,
        'translatable' => FALSE,
      ])->save();
    }

    if (!FieldConfig::loadByName('paragraph', 'strava_route', $field_name)) {
      FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'paragraph',
        'bundle' => 'strava_route',
        'label' => $def['label'],
        'description' => $def['description'],
        'required' => FALSE,
        'translatable' => FALSE,
      ])->save();
    }
  }
}

/**
 * Add a distance field to the strava_route paragraph type.
 *
 * Distance is moving off race_leg onto the route paragraph (see
 * race_day_update_10004()), so the route itself is now the single source of
 * truth for a leg's distance, whether populated from Strava or entered
 * manually (e.g. via CSV import for a leg without Strava data).
 */
function strava_api_update_10003(): void {
  $field_name = 'field_distance';

  if (!FieldStorageConfig::loadByName('paragraph', $field_name)) {
    FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'paragraph',
      'type' => 'decimal',
      'settings' => ['precision' => 10, 'scale' => 2],
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
  }

  if (!FieldConfig::loadByName('paragraph', 'strava_route', $field_name)) {
    FieldConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'paragraph',
      'bundle' => 'strava_route',
      'label' => 'Distance',
      'description' => 'Distance of this route in miles.',
      'required' => FALSE,
      'translatable' => FALSE,
    ])->save();
  }
}

/**
 * Add elevation high/low fields to the strava_route paragraph type.
 */
function strava_api_update_10002(): void {
  $definitions = [
    'field_elev_high' => [
      'type' => 'integer',
      'label' => 'Highest Elevation',
      'settings' => ['unsigned' => FALSE, 'size' => 'normal'],
      'description' => 'Highest elevation point along the route, imported from Strava, in feet.',
    ],
    'field_elev_low' => [
      'type' => 'integer',
      'label' => 'Lowest Elevation',
      'settings' => ['unsigned' => FALSE, 'size' => 'normal'],
      'description' => 'Lowest elevation point along the route, imported from Strava, in feet.',
    ],
  ];

  foreach ($definitions as $field_name => $def) {
    if (!FieldStorageConfig::loadByName('paragraph', $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'paragraph',
        'type' => $def['type'],
        'settings' => $def['settings'],
        'cardinality' => 1,
        'translatable' => FALSE,
      ])->save();
    }

    if (!FieldConfig::loadByName('paragraph', 'strava_route', $field_name)) {
      FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'paragraph',
        'bundle' => 'strava_route',
        'label' => $def['label'],
        'description' => $def['description'],
        'required' => FALSE,
        'translatable' => FALSE,
      ])->save();
    }
  }
}
