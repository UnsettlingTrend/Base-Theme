<?php

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;

/**
 * Implements hook_entity_presave().
 *
 * When a strava_route paragraph is saved with a valid route ID and the Strava
 * data fields are not yet populated (or the route ID has changed), fetch the
 * route from the Strava API and populate all "Imported from Strava" fields.
 *
 * This fires for every save path (inline paragraph in a parent form, or any
 * future standalone paragraph save). When RaceLegForm::populateFromStravaPayload()
 * already set the fields in memory, the polyline will be non-empty here and the
 * hook will exit early without a second API call.
 */
function strava_api_entity_presave(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'paragraph' || $entity->bundle() !== 'strava_route') {
    return;
  }

  $route_id = trim((string) ($entity->get('field_strava_route_id')->value ?? ''));
  if (!ctype_digit($route_id) || $route_id === '') {
    return;
  }

  // Determine whether the cached data is still valid for this route_id.
  $raw = trim((string) ($entity->get('field_route_data')->value ?? ''));
  $payload = _strava_api_decode_payload($raw);
  $cached_id = is_array($payload) ? (string) ($payload['id'] ?? '') : '';
  $polyline = trim((string) ($entity->get('field_strava_polyline')->value ?? ''));

  // Skip if already up-to-date (e.g. RaceLegForm pre-populated in memory).
  if ($cached_id === $route_id && $polyline !== '') {
    return;
  }

  if (!\Drupal::hasService('strava_api.route_client')) {
    return;
  }

  try {
    $payload = \Drupal::service('strava_api.route_client')->fetchRoute($route_id);
  }
  catch (\Throwable $e) {
    \Drupal::logger('strava_api')->warning('Failed to fetch Strava route @id: @message', [
      '@id' => $route_id,
      '@message' => $e->getMessage(),
    ]);
    return;
  }

  if (!is_array($payload)) {
    return;
  }

  // Cache the full payload.
  $encoded = json_encode($payload, JSON_UNESCAPED_SLASHES);
  if (is_string($encoded)) {
    $entity->set('field_route_data', $encoded);
  }

  $map = is_array($payload['map'] ?? NULL) ? $payload['map'] : [];
  $polyline = (string) ($map['polyline'] ?? '');
  $summary_polyline = (string) ($map['summary_polyline'] ?? '');

  if ($polyline !== '') {
    $entity->set('field_strava_polyline', $polyline);
  }
  if ($summary_polyline !== '') {
    $entity->set('field_strava_summary_polyline', $summary_polyline);
  }

  if (isset($payload['elevation_gain']) && is_numeric($payload['elevation_gain'])) {
    $feet = (int) round(((float) $payload['elevation_gain']) * 3.28084);
    $entity->set('field_elevation_gain', max(0, $feet));
  }

  if ($entity->hasField('field_elev_high') && $entity->hasField('field_elev_low')
    && \Drupal::hasService('strava_api.route_client')) {
    try {
      $streams = \Drupal::service('strava_api.route_client')->fetchRouteStreams($route_id);
    }
    catch (\Throwable $e) {
      \Drupal::logger('strava_api')->warning('Failed to fetch Strava route @id streams: @message', [
        '@id' => $route_id,
        '@message' => $e->getMessage(),
      ]);
      $streams = NULL;
    }

    $bounds = is_array($streams) ? _strava_api_extract_elevation_bounds($streams) : NULL;
    if ($bounds !== NULL) {
      $entity->set('field_elev_high', $bounds['high']);
      $entity->set('field_elev_low', $bounds['low']);
    }
  }

  $start = _strava_api_extract_latlng(
    $payload['start_latlng']
    ?? [$payload['start_latitude'] ?? NULL, $payload['start_longitude'] ?? NULL]
  );
  $end = _strava_api_extract_latlng(
    $payload['end_latlng']
    ?? [$payload['end_latitude'] ?? NULL, $payload['end_longitude'] ?? NULL]
  );

  // Strava's Routes endpoint omits discrete lat/lng fields; decode the polyline
  // and use the first and last points instead.
  if ($start === NULL || $end === NULL) {
    $points = _strava_api_decode_polyline($polyline !== '' ? $polyline : $summary_polyline);
    if (count($points) >= 2) {
      $start ??= $points[0];
      $end ??= $points[count($points) - 1];
    }
  }

  if ($start !== NULL) {
    $entity->set('field_start_lat', round($start[0], 7));
    $entity->set('field_start_lng', round($start[1], 7));
  }
  if ($end !== NULL) {
    $entity->set('field_end_lat', round($end[0], 7));
    $entity->set('field_end_lng', round($end[1], 7));
  }
}

/**
 * Implements hook_field_widget_single_element_form_alter().
 *
 * When a strava_route paragraph appears inline in any entity form, move the
 * Strava-imported data fields into a collapsed, disabled "Imported from Strava"
 * details group so editors can see the values but cannot change them.
 */
function strava_api_field_widget_single_element_form_alter(array &$element, FormStateInterface $form_state, array $context): void {
  // The subform key is present only when a paragraph widget is in edit mode.
  if (!isset($element['subform']['field_strava_route_id'])) {
    return;
  }

  $strava_fields = [
    'field_distance',
    'field_elevation_gain',
    'field_elev_high',
    'field_elev_low',
    'field_start_lat',
    'field_start_lng',
    'field_end_lat',
    'field_end_lng',
    'field_route_data',
    'field_strava_polyline',
    'field_strava_summary_polyline',
  ];

  // Decimal fields that are NULL in the DB render as '' in the number widget.
  // Drupal's entity constraint validator rejects '' as "not a valid number", so
  // we attach a validator that converts '' back to NULL before entity validation.
  $decimal_fields = [
    'field_distance',
    'field_elevation_gain',
    'field_elev_high',
    'field_elev_low',
    'field_start_lat',
    'field_start_lng',
    'field_end_lat',
    'field_end_lng',
  ];

  $subform = &$element['subform'];

  foreach ($decimal_fields as $field_name) {
    if (isset($subform[$field_name]['widget'][0]['value'])) {
      $subform[$field_name]['widget'][0]['value']['#element_validate'][] = '_strava_api_empty_decimal_to_null';
    }
  }

  $subform['group_strava_imported'] = [
    '#type' => 'details',
    '#title' => t('Imported from Strava'),
    '#open' => FALSE,
    '#weight' => 50,
  ];

  foreach ($strava_fields as $field_name) {
    if (!isset($subform[$field_name])) {
      continue;
    }
    $subform['group_strava_imported'][$field_name] = _strava_api_disable_element($subform[$field_name]);
    unset($subform[$field_name]);
  }
}

/**
 * Element validator: converts an empty string to NULL for decimal inputs.
 *
 * Disabled number widgets submit '' when the stored value is NULL. Drupal's
 * entity constraint validator rejects '' on decimal fields, so we normalise
 * it back to NULL here, before entity validation runs.
 */
function _strava_api_empty_decimal_to_null(array &$element, FormStateInterface $form_state, array &$complete_form): void {
  if ($element['#value'] === '') {
    $form_state->setValueForElement($element, NULL);
  }
}

/**
 * Recursively sets #disabled on a form element and all its children.
 */
function _strava_api_disable_element(array $element): array {
  $element['#disabled'] = TRUE;
  foreach (Element::children($element) as $key) {
    $element[$key] = _strava_api_disable_element($element[$key]);
  }
  return $element;
}

/**
 * Decodes stored route_data JSON, unwrapping nested payloads when present.
 */
function _strava_api_decode_payload(string $raw): ?array {
  if ($raw === '') {
    return NULL;
  }
  $payload = json_decode($raw, TRUE);
  if (!is_array($payload)) {
    return NULL;
  }
  if (isset($payload['route']) && is_array($payload['route'])) {
    return $payload['route'];
  }
  return $payload;
}

/**
 * Returns [lat, lng] when $value is a valid Strava coordinate pair.
 *
 * @return array{0: float, 1: float}|null
 */
function _strava_api_extract_latlng(mixed $value): ?array {
  if (!is_array($value) || !isset($value[0], $value[1])) {
    return NULL;
  }
  if (!is_numeric($value[0]) || !is_numeric($value[1])) {
    return NULL;
  }
  return [(float) $value[0], (float) $value[1]];
}

/**
 * Returns the highest/lowest elevation (in feet) from a route streams response.
 *
 * @param array $streams
 *   The decoded response from GET /routes/{id}/streams: a list of stream
 *   objects, each with a "type" (e.g. "altitude") and a "data" array.
 *
 * @return array{high: int, low: int}|null
 */
function _strava_api_extract_elevation_bounds(array $streams): ?array {
  $altitude = NULL;
  foreach ($streams as $stream) {
    if (is_array($stream) && ($stream['type'] ?? NULL) === 'altitude' && is_array($stream['data'] ?? NULL)) {
      $altitude = $stream['data'];
      break;
    }
  }

  if (empty($altitude)) {
    return NULL;
  }

  $meters = array_filter($altitude, 'is_numeric');
  if (empty($meters)) {
    return NULL;
  }

  return [
    'high' => (int) round(max($meters) * 3.28084),
    'low' => (int) round(min($meters) * 3.28084),
  ];
}

/**
 * Decodes a Google-encoded polyline string into an array of [lat, lng] pairs.
 *
 * @return array<int, array{0: float, 1: float}>
 */
function _strava_api_decode_polyline(string $encoded): array {
  $points = [];
  $index = 0;
  $len = strlen($encoded);
  $lat = 0;
  $lng = 0;

  while ($index < $len) {
    foreach ([&$lat, &$lng] as &$coord) {
      $result = 0;
      $shift = 0;
      do {
        if ($index >= $len) {
          return $points;
        }
        $b = ord($encoded[$index++]) - 63;
        $result |= ($b & 0x1F) << $shift;
        $shift += 5;
      } while ($b >= 0x20);
      $coord += ($result & 1) ? ~($result >> 1) : ($result >> 1);
    }
    unset($coord);
    $points[] = [$lat / 1e5, $lng / 1e5];
  }

  return $points;
}
