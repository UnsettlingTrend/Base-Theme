<?php

/**
 * @file
 * Hook implementations for the Tracking module.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityStorageInterface;

/**
 * Implements hook_page_attachments().
 *
 * Attaches the CSS that gives the "Tracking" toolbar item's icon (see
 * ut_tracking.links.menu.yml) a monochrome map-marker matching the style
 * Gin's own toolbar icons use. Gated on "access toolbar" so it's never
 * loaded for anonymous/toolbar-less requests.
 */
function ut_tracking_page_attachments(array &$attachments): void {
  if (\Drupal::currentUser()->hasPermission('access toolbar')) {
    $attachments['#attached']['library'][] = 'ut_tracking/toolbar_icon';
  }
}

/**
 * Implements hook_menu_links_discovered_alter().
 *
 * Bumps core's "Reports" toolbar item's weight by 1 so "Tracking" (weight
 * 5, tied with Race Day's own top-level item — see
 * ut_tracking.links.menu.yml) renders directly before it with nothing in
 * between.
 *
 * Tying "Tracking" at Reports' original weight alone isn't enough: the
 * toolbar's actual render path (ToolbarController::preRenderAdministrationTray())
 * re-sorts via DefaultMenuLinkTreeManipulators::generateIndexAndSort(),
 * which breaks weight ties by comparing "{weight} {title} {plugin id}" as
 * a plain string — title first, not plugin ID, despite MenuTreeStorage's
 * own SQL query separately ordering by id (that order gets discarded by
 * this re-sort). "Tracking" sorts after "Reports" alphabetically, so no
 * tied-weight choice of title or plugin ID could ever land it first.
 * Bumping Reports' own weight sidesteps the title comparison entirely — a
 * title tie-break only applies among links sharing the same weight, so
 * Race Day and Tracking still tie-break by title ("Race Day" <
 * "Tracking") for their own relative order, and Reports moves out of that
 * tier to render immediately after.
 */
function ut_tracking_menu_links_discovered_alter(array &$links): void {
  if (isset($links['system.admin_reports']['weight'])) {
    $links['system.admin_reports']['weight']++;
  }
}

/**
 * Implements hook_views_data_alter().
 *
 * Registers the "latest per user" pseudo-field so LatestPerUserFilter is
 * selectable as a gps_location filter in Views config — see
 * views.view.gps_location_map.yml and LatestPerUserFilter.php.
 */
function ut_tracking_views_data_alter(array &$data): void {
  $data['gps_location']['latest_per_user'] = [
    'title' => t('Latest per user'),
    'help' => t("Restricts results to each user's single most recent GPS location report."),
    'filter' => [
      'title' => t('Latest report per user'),
      'id' => 'latest_per_user',
    ],
  ];
}

/**
 * The retention period options shared by SettingsForm (site default) and
 * UserRetentionForm (per-user override) — kept in one place so the two
 * forms can't drift apart on wording.
 */
function ut_tracking_retention_period_labels(): array {
  return [
    'most_recent' => t('Only keep the most recent record per user'),
    '1_day' => t('1 day'),
    '5_days' => t('5 days'),
    '10_days' => t('10 days'),
    '1_month' => t('1 month'),
    '3_months' => t('3 months'),
    '6_months' => t('6 months'),
    '1_year' => t('1 year'),
    'forever' => t('Forever (never delete)'),
  ];
}

/**
 * Allowed-values callback for the field_ut_tracking_retention field (see
 * field.storage.user.field_ut_tracking_retention.yml).
 *
 * Adds a "Site default (@label)" option ahead of the fixed list, @label
 * being whatever ut_tracking.settings:retention_period currently is —
 * marked non-cacheable ($cacheable = FALSE) since that can change
 * independently of anything that would normally invalidate a field
 * definition's cached allowed-values list.
 *
 * @see options_allowed_values()
 */
function ut_tracking_user_retention_allowed_values($definition, $entity, &$cacheable): array {
  $cacheable = FALSE;

  $labels = ut_tracking_retention_period_labels();
  $site_default = \Drupal::config('ut_tracking.settings')->get('retention_period') ?: 'forever';
  $site_default_label = $labels[$site_default] ?? $labels['forever'];

  return [
    'default' => t('Site default (@label)', ['@label' => $site_default_label]),
  ] + $labels;
}

/**
 * Implements hook_cron().
 *
 * Deletes gps_location reports per each user's EFFECTIVE retention period
 * — their own field_ut_tracking_retention override if they've set one
 * (anything other than empty/"default"), otherwise the site default at
 * ut_tracking.settings:retention_period (set via SettingsForm at
 * /admin/tracking/settings). A user's own choice always wins, even when
 * stricter than the site default — this is *their* location history.
 *
 * Every setting, including a plain time cutoff, excludes each user's
 * single most recent report from deletion — see
 * _ut_tracking_latest_per_user_ids().
 */
function ut_tracking_cron(): void {
  $site_default = \Drupal::config('ut_tracking.settings')->get('retention_period') ?: 'forever';
  $effective_by_uid = _ut_tracking_effective_retention_periods($site_default);

  if (!$effective_by_uid) {
    return;
  }

  $uids_by_period = [];
  foreach ($effective_by_uid as $uid => $period) {
    $uids_by_period[$period][] = $uid;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('gps_location');
  $total_deleted = 0;

  foreach ($uids_by_period as $period => $uids) {
    if ($period === 'forever') {
      continue;
    }

    $ids = $period === 'most_recent'
      ? _ut_tracking_ids_older_than_most_recent($storage, $uids)
      : _ut_tracking_ids_older_than_cutoff($storage, $period, $uids);

    if ($ids) {
      $storage->delete($storage->loadMultiple($ids));
      $total_deleted += count($ids);
    }
  }

  if ($total_deleted) {
    \Drupal::logger('ut_tracking')->notice('Deleted @count GPS location report(s) during scheduled cleanup.', [
      '@count' => $total_deleted,
    ]);
  }
}

/**
 * Maps every uid that has at least one gps_location report to their
 * effective retention period: their own field_ut_tracking_retention
 * value if set to something other than "default" (or empty, which is
 * what an account created before this field existed will have), else
 * $site_default.
 */
function _ut_tracking_effective_retention_periods(string $site_default): array {
  $uids = \Drupal::database()->select('gps_location', 'gl')
    ->fields('gl', ['uid'])
    ->distinct()
    ->execute()
    ->fetchCol();

  if (!$uids) {
    return [];
  }

  $users = \Drupal::entityTypeManager()->getStorage('user')->loadMultiple($uids);

  $effective = [];
  foreach ($users as $uid => $user) {
    $override = $user->hasField('field_ut_tracking_retention')
      ? $user->get('field_ut_tracking_retention')->value
      : NULL;
    $effective[$uid] = (!$override || $override === 'default') ? $site_default : $override;
  }

  return $effective;
}

/**
 * IDs of each user's single most recent gps_location report.
 *
 * This is the "always keep" set: no retention setting is allowed to
 * delete these, so a user who stops reporting doesn't eventually lose
 * their only location entirely (and silently drop off the Full Map)
 * just because it aged past whatever cutoff is configured.
 *
 * Same "greatest-n-per-group" approach as LatestPerUserFilter: a
 * correlated MAX(recorded) subquery, tie-broken by MAX(id) so ties on the
 * exact same recorded timestamp still resolve to exactly one row per
 * user rather than zero or several.
 */
function _ut_tracking_latest_per_user_ids(): array {
  $connection = \Drupal::database();

  $latest = $connection->select('gps_location', 'gl2')
    ->fields('gl2', ['uid']);
  $latest->addExpression('MAX(recorded)', 'max_recorded');
  $latest->groupBy('gl2.uid');

  $keep = $connection->select('gps_location', 'gl');
  $keep->join($latest, 'latest', 'gl.uid = latest.uid AND gl.recorded = latest.max_recorded');
  $keep->addExpression('MAX(gl.id)', 'keep_id');
  $keep->groupBy('gl.uid');
  return $keep->execute()->fetchCol();
}

/**
 * IDs of every gps_location report except each user's single most recent
 * one — the "most_recent" retention setting.
 *
 * @param array $uids
 *   Restrict to these uids' reports. Empty means every user — used when
 *   every user shares the same effective retention period.
 */
function _ut_tracking_ids_older_than_most_recent(EntityStorageInterface $storage, array $uids = []): array {
  $keep_ids = _ut_tracking_latest_per_user_ids();

  $query = $storage->getQuery()->accessCheck(FALSE);
  if ($keep_ids) {
    $query->condition('id', $keep_ids, 'NOT IN');
  }
  if ($uids) {
    $query->condition('uid', $uids, 'IN');
  }
  return $query->execute();
}

/**
 * IDs of gps_location reports whose "recorded" timestamp is older than
 * the given retention period, e.g. "3_months" — excluding each user's
 * single most recent report regardless of its own age.
 *
 * Calendar-based periods (month/year) go through strtotime() rather than
 * a fixed day-count multiplication, so they land on the actual calendar
 * date a period like that implies instead of an approximation that drifts
 * across months of different lengths.
 *
 * @param array $uids
 *   Restrict to these uids' reports. Empty means every user — used when
 *   every user shares the same effective retention period.
 */
function _ut_tracking_ids_older_than_cutoff(EntityStorageInterface $storage, string $retention_period, array $uids = []): array {
  $now = \Drupal::time()->getRequestTime();
  $cutoff = match ($retention_period) {
    '1_day' => strtotime('-1 day', $now),
    '5_days' => strtotime('-5 days', $now),
    '10_days' => strtotime('-10 days', $now),
    '1_month' => strtotime('-1 month', $now),
    '3_months' => strtotime('-3 months', $now),
    '6_months' => strtotime('-6 months', $now),
    '1_year' => strtotime('-1 year', $now),
    default => NULL,
  };

  if ($cutoff === NULL) {
    return [];
  }

  $query = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('recorded', $cutoff, '<');

  $keep_ids = _ut_tracking_latest_per_user_ids();
  if ($keep_ids) {
    $query->condition('id', $keep_ids, 'NOT IN');
  }
  if ($uids) {
    $query->condition('uid', $uids, 'IN');
  }

  return $query->execute();
}
