<?php

/**
 * @file
 * Install, update, and uninstall functions for the Tracking module.
 */

declare(strict_types=1);

use Drupal\Component\Serialization\Yaml;
use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\group\Entity\GroupRelationshipType;
use Drupal\group\Entity\GroupRole;
use Drupal\group\Entity\GroupType;
use Drupal\views\Entity\View;

/**
 * Implements hook_schema().
 */
function ut_tracking_schema(): array {
  return [
    'ut_tracking_api_token' => [
      'description' => 'Bearer tokens issued after a verified Google sign-in (see LocationReportController::googleLogin()) — the credential the mobile app uses in place of a Drupal password, since Google sign-in never gives it one to send as Basic Auth.',
      'fields' => [
        'id' => [
          'type' => 'serial',
          'not null' => TRUE,
        ],
        'uid' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'token_hash' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => TRUE,
          'description' => 'SHA-256 hex hash of the token. The plaintext token is shown to the app exactly once, at issuance, and never itself stored.',
        ],
        'created' => [
          'type' => 'int',
          'not null' => TRUE,
        ],
      ],
      'primary key' => ['id'],
      'unique keys' => [
        'token_hash' => ['token_hash'],
      ],
      'indexes' => [
        'uid' => ['uid'],
      ],
    ],
  ];
}

/**
 * Installs the GPS Locations admin View (views.view.gps_location_admin).
 *
 * It ships as config/install/views.view.gps_location_admin.yml, so it's
 * present on any fresh install of this module — but this module was
 * already installed on this (and possibly other) environments before the
 * View existed, and config/install is only auto-imported at install
 * time. Create it explicitly here so it lands on already-installed sites
 * too, reading the same packaged YAML rather than duplicating its
 * content inline.
 */
function ut_tracking_update_10001(): void {
  if (\Drupal::entityTypeManager()->getStorage('view')->load('gps_location_admin')) {
    return;
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('ut_tracking');
  $data = Yaml::decode(file_get_contents($module_path . '/config/install/views.view.gps_location_admin.yml'));
  View::create($data)->save();
}

/**
 * Installs the Full Map View (views.view.gps_location_map), replacing the
 * old MapController/ut_tracking.map route.
 *
 * Same reasoning as ut_tracking_update_10001(): ships in config/install
 * for fresh installs, but must be created explicitly here for this and
 * any other already-installed site.
 */
function ut_tracking_update_10002(): void {
  if (\Drupal::entityTypeManager()->getStorage('view')->load('gps_location_map')) {
    return;
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('ut_tracking');
  $data = Yaml::decode(file_get_contents($module_path . '/config/install/views.view.gps_location_map.yml'));
  View::create($data)->save();
}

/**
 * Creates ut_tracking.settings (retention_period, default "forever").
 *
 * Ships as config/install/ut_tracking.settings.yml, which — same as the
 * two updates above — only auto-imports on a fresh module install, not on
 * this already-installed site. "Forever" as the default is deliberate:
 * enabling automatic deletion of a user's location history should be an
 * explicit opt-in on /admin/tracking/settings, not something that starts
 * happening silently the moment this update runs.
 */
function ut_tracking_update_10003(): void {
  \Drupal::configFactory()->getEditable('ut_tracking.settings')
    ->set('retention_period', 'forever')
    ->save();
}

/**
 * Creates the field_ut_tracking_retention field on the user entity, for
 * the per-user retention override on the account's new "Tracking" tab.
 *
 * Same reasoning as the updates above re: config/install only
 * auto-importing on a fresh install. Unlike the Views/settings config
 * created by those updates, a configurable field is two config entities
 * (storage + the bundle instance) — saving FieldStorageConfig triggers
 * Drupal to provision the field's dedicated database table itself, no
 * separate entityDefinitionUpdateManager step needed (that's specific to
 * base fields on content entities, not Field API configurable fields).
 */
function ut_tracking_update_10004(): void {
  if (\Drupal::entityTypeManager()->getStorage('field_storage_config')->load('user.field_ut_tracking_retention')) {
    return;
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('ut_tracking');

  $storage_data = Yaml::decode(file_get_contents($module_path . '/config/install/field.storage.user.field_ut_tracking_retention.yml'));
  FieldStorageConfig::create($storage_data)->save();

  $field_data = Yaml::decode(file_get_contents($module_path . '/config/install/field.field.user.user.field_ut_tracking_retention.yml'));
  FieldConfig::create($field_data)->save();
}

/**
 * Creates the ut_tracking_api_token table (see ut_tracking_schema()), for
 * Google-sign-in Bearer tokens.
 *
 * hook_schema() only runs automatically at module install time; this
 * module was already installed before this table existed, so — same
 * reasoning as every update above, applied to a plain DB table instead
 * of config — it must be created explicitly here too.
 */
function ut_tracking_update_10005(): void {
  $schema = \Drupal::database()->schema();
  if ($schema->tableExists('ut_tracking_api_token')) {
    return;
  }
  $schema->createTable('ut_tracking_api_token', ut_tracking_schema()['ut_tracking_api_token']);
}

/**
 * Switches the GPS Locations admin view's "Reported by" and "Device"
 * columns from unexposed to exposed, filterable select lists of real
 * users/devices, instead of the plain "type the raw target ID" textfield
 * Views falls back to for any int-typed column (which is what these two
 * entity_reference base fields got by default — see
 * ut_tracking_views_data_alter()).
 *
 * Same reasoning as every update above re: config/install only
 * auto-importing on a fresh install. The exact option values here (widget:
 * select, sub_handler: 'default:<target entity type>', etc.) were derived
 * by instantiating the real 'entity_reference' filter plugin
 * (\Drupal\views\Plugin\views\filter\EntityReference) via
 * ViewExecutable::initHandlers() and reading back its normalized
 * $options, rather than hand-guessed, since that plugin's option tree
 * (inherited through ManyToOne/InOperator/FilterPluginBase) is large
 * enough that a hand-typed array would risk missing keys Views expects at
 * runtime.
 */
function ut_tracking_update_10006(): void {
  $view = View::load('gps_location_admin');
  if (!$view) {
    return;
  }

  $display = &$view->getDisplay('default');
  $display['display_options']['filters']['uid'] = [
    'id' => 'uid',
    'table' => 'gps_location',
    'field' => 'uid',
    'relationship' => 'none',
    'group_type' => 'group',
    'admin_label' => '',
    'operator' => 'or',
    'value' => [],
    'group' => 1,
    'exposed' => TRUE,
    'expose' => [
      'operator_id' => FALSE,
      'label' => 'Reported by',
      'description' => '',
      'use_operator' => FALSE,
      'operator' => '',
      'operator_limit_selection' => FALSE,
      'operator_list' => [],
      'identifier' => 'uid',
      'required' => FALSE,
      'remember' => FALSE,
      'multiple' => FALSE,
      'remember_roles' => ['authenticated' => 'authenticated'],
      'reduce' => FALSE,
    ],
    'is_grouped' => FALSE,
    'group_info' => [
      'label' => '',
      'description' => '',
      'identifier' => '',
      'optional' => TRUE,
      'widget' => 'select',
      'multiple' => FALSE,
      'remember' => FALSE,
      'default_group' => 'All',
      'default_group_multiple' => [],
      'group_items' => [],
    ],
    'reduce_duplicates' => FALSE,
    'sub_handler' => 'default:user',
    'sub_handler_settings' => [],
    'widget' => 'select',
    'plugin_id' => 'entity_reference',
    'entity_type' => 'gps_location',
    'entity_field' => 'uid',
  ];
  $display['display_options']['filters']['device'] = [
    'id' => 'device',
    'table' => 'gps_location',
    'field' => 'device',
    'relationship' => 'none',
    'group_type' => 'group',
    'admin_label' => '',
    'operator' => 'or',
    'value' => [],
    'group' => 1,
    'exposed' => TRUE,
    'expose' => [
      'operator_id' => FALSE,
      'label' => 'Device',
      'description' => '',
      'use_operator' => FALSE,
      'operator' => '',
      'operator_limit_selection' => FALSE,
      'operator_list' => [],
      'identifier' => 'device',
      'required' => FALSE,
      'remember' => FALSE,
      'multiple' => FALSE,
      'remember_roles' => ['authenticated' => 'authenticated'],
      'reduce' => FALSE,
    ],
    'is_grouped' => FALSE,
    'group_info' => [
      'label' => '',
      'description' => '',
      'identifier' => '',
      'optional' => TRUE,
      'widget' => 'select',
      'multiple' => FALSE,
      'remember' => FALSE,
      'default_group' => 'All',
      'default_group_multiple' => [],
      'group_items' => [],
    ],
    'reduce_duplicates' => FALSE,
    'sub_handler' => 'default:gps_device',
    'sub_handler_settings' => [],
    'widget' => 'select',
    'plugin_id' => 'entity_reference',
    'entity_type' => 'gps_location',
    'entity_field' => 'device',
  ];
  $view->save();
}

/**
 * Creates the "Location Access" group type (config/install/group.type.
 * location_access.yml and its roles/relationship type/field/displays),
 * and backfills a Location Access group for every existing user account
 * — ut_tracking_user_insert() only auto-provisions one for accounts
 * created from now on.
 *
 * Same reasoning as every update above re: config/install only
 * auto-importing on a fresh install.
 */
function ut_tracking_update_10007(): void {
  $module_path = \Drupal::service('extension.list.module')->getPath('ut_tracking');
  $read = fn (string $filename) => Yaml::decode(file_get_contents("$module_path/config/install/$filename"));

  if (!GroupType::load('location_access')) {
    GroupType::create($read('group.type.location_access.yml'))->save();
  }
  if (!GroupRole::load('location_access-admin')) {
    GroupRole::create($read('group.role.location_access-admin.yml'))->save();
  }
  if (!GroupRole::load('location_access-member')) {
    GroupRole::create($read('group.role.location_access-member.yml'))->save();
  }
  if (!GroupRelationshipType::load('location_access-group_membership')) {
    GroupRelationshipType::create($read('group.relationship_type.location_access-group_membership.yml'))->save();
  }
  if (!FieldStorageConfig::loadByName('group', 'field_authorized_race_teams')) {
    FieldStorageConfig::create($read('field.storage.group.field_authorized_race_teams.yml'))->save();
  }
  if (!FieldConfig::loadByName('group', 'location_access', 'field_authorized_race_teams')) {
    FieldConfig::create($read('field.field.group.location_access.field_authorized_race_teams.yml'))->save();
  }
  if (!EntityFormDisplay::load('group.location_access.default')) {
    EntityFormDisplay::create($read('core.entity_form_display.group.location_access.default.yml'))->save();
  }
  if (!EntityViewDisplay::load('group.location_access.default')) {
    EntityViewDisplay::create($read('core.entity_view_display.group.location_access.default.yml'))->save();
  }

  $uids = \Drupal::entityQuery('user')
    ->condition('uid', 0, '>')
    ->accessCheck(FALSE)
    ->execute();
  $backfilled = 0;
  foreach (\Drupal::entityTypeManager()->getStorage('user')->loadMultiple($uids) as $user) {
    if (!_ut_tracking_get_location_access_group($user)) {
      _ut_tracking_ensure_location_access_group($user);
      $backfilled++;
    }
  }

  if ($backfilled) {
    \Drupal::logger('ut_tracking')->notice('Backfilled @count Location Access group(s) for existing users.', [
      '@count' => $backfilled,
    ]);
  }
}
