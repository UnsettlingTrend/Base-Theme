<?php

/**
 * @file
 * Functions to support theming in ut_base theme.
 */

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 *
 * Wraps the standard login fields in a collapsed "Local Account" fieldset so
 * the form is tidier when other login methods (e.g. SSO) are also present.
 */
function ut_base_form_user_login_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, string $form_id): void {
  // Embed the Social Auth Login block above the local account fieldset so its
  // position is tied to the form rather than the block region sort order.
  $block = \Drupal::entityTypeManager()
    ->getStorage('block')
    ->load('ut_base_socialauthlogin');

  $form['sso_message'] = [
    '#type' => 'html_tag',
    '#tag' => 'p',
    '#value' => t('Use one of the trusted Single Sign-On services below. This site will only receive validation of your identity, and the most basic info to create an account, such as email, name, and user icon. If you prefer, create/login using a local email/password login.'),
    '#weight' => -1,
  ];

  if ($block) {
    $form['social_auth'] = \Drupal::entityTypeManager()
      ->getViewBuilder('block')
      ->view($block);
    $form['social_auth']['#weight'] = 0;
  }

  $local_fields = ['name', 'pass', 'actions'];
  $fieldset = [
    '#type' => 'details',
    '#title' => t('Local Account'),
    '#open' => FALSE,
    '#weight' => 10,
  ];

  foreach ($local_fields as $key) {
    if (isset($form[$key])) {
      $fieldset[$key] = $form[$key];
      unset($form[$key]);
    }
  }

  $fieldset['actions']['#weight'] = 10;

  // Move CAPTCHA inside the fieldset at the very bottom.
  if (isset($form['captcha'])) {
    $fieldset['captcha'] = $form['captcha'];
    $fieldset['captcha']['#weight'] = 30;
    unset($form['captcha']);
  }

  $fieldset['account_links'] = [
    '#type' => 'container',
    '#attributes' => ['class' => ['local-account-links']],
    '#weight' => 20,
    'register' => [
      '#type' => 'link',
      '#title' => t('Create new account'),
      '#url' => \Drupal\Core\Url::fromRoute('user.register'),
    ],
    'reset' => [
      '#type' => 'link',
      '#title' => t('Reset your password'),
      '#url' => \Drupal\Core\Url::fromRoute('user.pass'),
    ],
  ];

  $form['local_account'] = $fieldset;

  // Hide the page tabs (Log in / Create new account / Reset your password).
  $form['#attached']['html_head'][] = [
    [
      '#tag' => 'style',
      '#value' => '.path-user .tabs { display: none; }',
    ],
    'hide_user_tabs',
  ];
}

/**
 * Implements hook_preprocess_HOOK() for region templates.
 *
 * Exposes the branding, main menu, and account menu blocks in the navbar
 * region as separate variables so region--navbar.html.twig can lay them out
 * as stacked/side-by-side rows (collapsing title bar + sticky menu, with the
 * account menu right-aligned in its own navbar__section) instead of the
 * single side-by-side row the base theme renders. `content` is already a
 * flattened HTML string by this point (see
 * ThemePreprocess::preprocessRegion()), so the individual block render
 * arrays have to be pulled from `elements` before that happens.
 *
 * Also exposes the site logo URL directly (independent of the branding
 * block above, which no longer renders it — see the
 * block--navbar--system-branding-block.html.twig override) so
 * region--navbar.html.twig can place it next to the main menu's first link,
 * shown only once the title bar has scrolled fully out of view. Same
 * approach material_base itself uses for the logo elsewhere
 * (material_base.theme's own hook_preprocess_region()).
 */
function ut_base_preprocess_region(array &$variables): void {
  if ($variables['elements']['#region'] !== 'navbar') {
    return;
  }
  $variables['branding_block'] = $variables['elements']['ut_base_branding'] ?? NULL;
  $variables['menu_block'] = $variables['elements']['ut_base_main_menu'] ?? NULL;
  $variables['site_logo_url'] = \Drupal::service('file_url_generator')->generateString(theme_get_setting('logo.url'));
  $variables['account_menu_block'] = $variables['elements']['ut_base_account_menu'] ?? NULL;
}

/**
 * Implements hook_preprocess_HOOK() for page--front.html.twig.
 *
 * Exposes the front page's field_image, run through the header_image image
 * style, as header_image_url/header_image_alt — page--front.html.twig
 * previously rendered the field's original, un-styled file directly.
 */
function ut_base_preprocess_page__front(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof \Drupal\node\NodeInterface || $node->get('field_image')->isEmpty()) {
    return;
  }

  $media = $node->get('field_image')->entity;
  if (!$media instanceof \Drupal\media\MediaInterface || $media->get('field_media_image')->isEmpty()) {
    return;
  }

  $image_item = $media->get('field_media_image')->first();
  $file = $image_item->entity;
  if (!$file instanceof \Drupal\file\FileInterface) {
    return;
  }

  $style = \Drupal\image\Entity\ImageStyle::load('header_image');
  if (!$style) {
    return;
  }

  $variables['header_image_url'] = $style->buildUrl($file->getFileUri());
  $variables['header_image_alt'] = $image_item->alt;
}

/**
 * Implements hook_preprocess_HOOK().
 */
function ut_base_preprocess_html(array &$variables): void {
  foreach ($variables['page']['#attached']['html_head'] as $key => $attachment) {
    switch ($attachment[1]) {

      // Unset preloading Roboto font.
      case 'preload_font_roboto':
        unset($variables['page']['#attached']['html_head'][$key]);
        break;

      // Unset preloading Material icons font.
      /*
      case 'preload_font_material_icons':
      unset($variables['page']['#attached']['html_head'][$key]);
      break;
       */
    }
  }

  // Preload Montserrat and Roboto fonts.
  $preload_font_montserrat_roboto = [
    '#tag' => 'link',
    '#attributes' => [
      'rel' => 'preload',
      'href' => 'https://fonts.googleapis.com/css?family=Montserrat:300,400,500,700|Roboto:300,400,500,700&display=swap',
      'as' => 'style',
    ],
  ];

  $variables['page']['#attached']['html_head'][] = [
    $preload_font_montserrat_roboto,
    'preload_font_montserrat_roboto',
  ];
}
