{
    "name": "unsettlingtrend/tf",
    "description": "Project template ",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "authors": [
        {
            "name": "Chris Feragotti",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "package",
            "package": {
                "name": "noli42/chosen",
                "version": "3.0.0",
                "type": "drupal-library",
                "dist": {
                    "url": "https://github.com/noli42/chosen/releases/download/3.0.0/chosen-assets-v3.0.0.zip",
                    "type": "zip"
                }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "bower-asset/photoswipe": "^5.4",
        "composer/installers": "^1.9",
        "cweagans/composer-patches": "^1.7",
        "drupal/address": "^2.0",
        "drupal/admin_toolbar": "^3.0",
        "drupal/ai": "^1.2",
        "drupal/ajax_comments": "^1.0@beta",
        "drupal/background_image_formatter": "^2.0",
        "drupal/better_exposed_filters": "^7.1@beta",
        "drupal/block_content_template": "^1.5",
        "drupal/book": "^2.0@alpha",
        "drupal/chosen": "^5.0",
        "drupal/clientside_validation": "^4.0",
        "drupal/components": "^3.1",
        "drupal/config_filter": "^2.4",
        "drupal/config_split": "^2.0@RC",
        "drupal/cookies": "^2.0@alpha",
        "drupal/core-composer-scaffold": "^10",
        "drupal/core-project-message": "^10",
        "drupal/core-recommended": "^10",
        "drupal/devel": "^5.0",
        "drupal/devel_debug_log": "^2.0",
        "drupal/devel_entity_updates": "^4.1",
        "drupal/devel_kint_extras": "^1.1",
        "drupal/diff": "^2.0@beta",
        "drupal/disable_html5_validation": "^2.0",
        "drupal/dynamic_entity_reference": "^4.0@alpha",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/entity_browser": "^2.6",
        "drupal/entity_usage": "^2.0@beta",
        "drupal/environment_indicator": "^4.1@beta",
        "drupal/facets": "^3.0@beta",
        "drupal/feeds": "^3.0@beta",
        "drupal/field_group": "^4.0@alpha",
        "drupal/flexible_permissions": "^2.0",
        "drupal/focal_point": "^2.0",
        "drupal/fullcalendar_view": "^5.2",
        "drupal/geocoder": "^4.23",
        "drupal/geofield": "^1.35",
        "drupal/geolocation": "^4.0@alpha",
        "drupal/gin": "^4.0",
        "drupal/gin_toolbar": "^2.0",
        "drupal/group": "^3.3",
        "drupal/honeypot": "^2.2",
        "drupal/image_widget_crop": "^3.0",
        "drupal/inline_entity_form": "^3.0@RC",
        "drupal/jquery_ui": "^1.7",
        "drupal/jquery_ui_button": "^2.1",
        "drupal/jquery_ui_datepicker": "^2.1",
        "drupal/jquery_ui_slider": "^2.1",
        "drupal/jquery_ui_touch_punch": "^1.1",
        "drupal/layout_paragraphs": "^3.0@alpha",
        "drupal/leaflet": "^10.0",
        "drupal/leaflet_more_maps": "^2.1",
        "drupal/leaflet_more_markers": "^1.1",
        "drupal/login_emailusername": "^3.0",
        "drupal/maillog": "^1.0",
        "drupal/material_base": "^3.1",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_tools": "^6.0",
        "drupal/module_filter": "^5.0",
        "drupal/name": "^1.0@RC",
        "drupal/node_view_permissions": "^2.0",
        "drupal/oauth_login_oauth2": "^3.0",
        "drupal/paragraphs": "^1.12",
        "drupal/pathauto": "^1.8",
        "drupal/photoswipe": "^5.0",
        "drupal/physical": "^1.3",
        "drupal/pirate": "^1.2",
        "drupal/private_message": "^4.0@alpha",
        "drupal/recaptcha": "^3.0",
        "drupal/redirect": "^1.6",
        "drupal/search_api": "^1.35",
        "drupal/search_api_autocomplete": "^1.9",
        "drupal/search_api_block": "^1.1",
        "drupal/search_api_location": "^1.0@alpha",
        "drupal/search_api_solr": "^4.3",
        "drupal/search_api_sorts": "^1.2",
        "drupal/select2": "^2.0",
        "drupal/selective_better_exposed_filters": "^3.0",
        "drupal/smart_date": "^4.1",
        "drupal/smart_date_calendar_kit": "^2.2",
        "drupal/smart_trim": "^2.0",
        "drupal/smsframework": "^2.3",
        "drupal/social_api": "^4.1@beta",
        "drupal/social_auth": "^4.2@beta",
        "drupal/social_auth_google": "^4.0",
        "drupal/svg_image": "^3.0",
        "drupal/twig_field_value": "^2.0",
        "drupal/twig_tweak": "^3.1",
        "drupal/upgrade_status": "^4.0",
        "drupal/uswds_templates": "3.0.x-dev@dev",
        "drupal/variationcache": "^1.5",
        "drupal/views_bulk_operations": "^4.0",
        "drupal/views_dependent_filters": "^1.2",
        "drupal/viewsreference": "^2.0@beta",
        "drupal/webform": "^6.3@beta",
        "drupal/workbench": "^1.6",
        "drush/drush": "^12",
        "gasparesganga/php-shapefile": "^3.4",
        "geocoder-php/google-maps-provider": "^4.6",
        "kint-php/kint": "^5.1",
        "league/oauth2-google": "^4.0",
        "noli42/chosen": "^3.0",
        "npm-asset/photoswipe-dynamic-caption-plugin": "^1.2",
        "npm-asset/select2": "^4.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "platformsh/config-reader": "^2.4",
        "unsettlingtrend/trend_personal": "^1.0",
        "unsettlingtrend/ut_base": "^1.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    }
    ,
    "require-dev": {
        "drupal/core-dev": "^10.4"
    },
    "scripts": {
        "post-drupal-scaffold-cmd": [
            "patch -p1 < patches/enable_twig_debugging.patch"
        ]
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/console-extend-plugin": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "patches-file": "patches/composer.patches.json",
        "merge-plugin": {
            "include": [
                "web/modules/contrib/chosen/composer.libraries.json"
            ]
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "installer-types": ["bower-asset", "npm-asset"],
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    }
}
