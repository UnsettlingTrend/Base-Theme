{
    "name": "drupal-composer/drupal-project",
    "description": "Project template for Drupal 8 projects with composer",
    "type": "project",
    "license": "GPL-2.0+",
    "authors": [
        {
            "name": "Chris Feragotti",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "package",
            "package": {
                "name": "enyo/dropzone",
                "version": "4.3.0",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/enyo/dropzone",
                    "type": "git",
                    "reference": "origin/master"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "kenwheeler/slick",
                "version": "1.9.0",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/kenwheeler/slick",
                    "type": "git",
                    "reference": "origin/master"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "jackmoore/colorbox",
                "version": "1.6.4",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/jackmoore/colorbox",
                    "type": "git",
                    "reference": "origin/master"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "fengyuanchen/cropper",
                "version": "4.0.0",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/fengyuanchen/cropper",
                    "type": "git",
                    "reference": "origin/master"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "dinbror/blazy",
                "version": "1.8.2",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/dinbror/blazy",
                    "type": "git",
                    "reference": "origin/master"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "cure53/dompurify",
                "version": "3",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/cure53/DOMPurify",
                    "type": "git",
                    "reference": "origin/main"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "ckeditor/codesnippet",
                "version": "4.11.4",
                "type": "drupal-library",
                "dist": {
                    "url": "https://download.ckeditor.com/codesnippet/releases/codesnippet_4.11.4.zip",
                    "type": "zip"
                }
            }
        },
        {
            "type": "package",
                "package": {
                    "name": "simeydotme/jquery-ui-slider-pips",
                    "version": "1.11.4",
                    "type": "drupal-library",
                    "source": {
                        "url": "https://github.com/simeydotme/jQuery-ui-Slider-Pips",
                        "type": "git",
                        "reference": "origin/master"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "google/charts",
                "version": "45",
                "type": "drupal-library",
                "extra": {
                    "installer-name": "google_charts"
                },
                "dist": {
                    "url": "https://www.gstatic.com/charts/loader.js",
                    "type": "file"
                },
                "require": {
                    "composer/installers": "~1.0"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "recurser/jquery-simple-color",
                "version": "master",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/recurser/jquery-simple-color.git",
                    "type": "git",
                    "reference": "master"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "bgrins/spectrum",
                "version": "1.8.0",
                "type": "drupal-library",
                "source": {
                    "url": "https://github.com/bgrins/spectrum.git",
                    "type": "git",
                    "reference": "1.8.0"
                }
            }
        }
    ],
    "require": {
        "ext-dom": "20031129",
        "ext-json": "*",
        "ext-zip": "^1.15",
        "bgrins/spectrum": "^1.8",
        "ckeditor/codesnippet": "^4.11",
        "composer/installers": "^1.2",
        "cure53/dompurify": "^3.0",
        "cweagans/composer-patches": "^1.6",
        "dinbror/blazy": "^1.8",
        "drupal/address": "^2.0@beta",
        "drupal/admin_toolbar": "^3.0",
        "drupal/adminimal_admin_toolbar": "^1.5",
        "drupal/allowed_formats": "^2.0",
        "drupal/auto_entitylabel": "^3.0@beta",
        "drupal/better_exposed_filters": "^6.0",
        "drupal/bg_image_formatter": "^1.14",
        "drupal/blazy": "^2.0",
        "drupal/captcha": "1.9",
        "drupal/charts": "^5.0",
        "drupal/coder": "^8.3",
        "drupal/coffee": "^1.0@beta",
        "drupal/color_field": "^3.0",
        "drupal/colorbox": "^2.0",
        "drupal/components": "^3.0",
        "drupal/config_filter": "^2.2",
        "drupal/config_split": "^2",
        "drupal/console": "^1.9",
        "drupal/core-composer-scaffold": "^9.0",
        "drupal/core-project-message": "^9.0",
        "drupal/core-recommended": "^9.0",
        "drupal/crop": "^2.0",
        "drupal/ctools": "^4.0",
        "drupal/devel": "^5.1",
        "drupal/devel_debug_log": "^2.0",
        "drupal/devel_entity_updates": "^4.1",
        "drupal/devel_php": "^1.3",
        "drupal/diff": "^1.0",
        "drupal/disable_html5_validation": "1.x-dev@dev",
        "drupal/draggableviews": "^2.0@RC",
        "drupal/dropzonejs": "^2.0@alpha",
        "drupal/embed": "^1.0",
        "drupal/entity_browser": "^2.0",
        "drupal/entity_embed": "1.x-dev@dev",
        "drupal/entity_usage": "^2.0@alpha",
        "drupal/environment_indicator": "^4.0",
        "drupal/exif_orientation": "^1.0",
        "drupal/facets": "^3.0@beta",
        "drupal/flexible_permissions": "^1.0",
        "drupal/geofield": "^1.3",
        "drupal/geolocation": "^3.0",
        "drupal/group": "^1.4",
        "drupal/image_effects": "^3.1",
        "drupal/image_widget_crop": "^2.1",
        "drupal/inline_entity_form": "^1.0@RC",
        "drupal/jira_rest": "^4.x-dev",
        "drupal/jquery_ui_checkboxradio": "^2.0",
        "drupal/jquery_ui_datepicker": "^2.0",
        "drupal/jquery_ui_slider": "^2.0",
        "drupal/jsonapi_extras": "^3.4",
        "drupal/leaflet": "^10.0",
        "drupal/leaflet_more_maps": "^2.0",
        "drupal/maillog": "^1.0",
        "drupal/media_entity_browser": "^2.0",
        "drupal/media_entity_instagram": "^3.0",
        "drupal/media_entity_twitter": "^2.0",
        "drupal/metatag": "^1.11",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_tools": "^6.0",
        "drupal/moderation_sidebar": "^1.2",
        "drupal/module_filter": "^4.0",
        "drupal/paragraphs": "^1.2",
        "drupal/pathauto": "^1.0",
        "drupal/physical": "^1.1",
        "drupal/publication_date": "^2.0@beta",
        "drupal/qrcode": "^1.0@alpha",
        "drupal/recaptcha": "^3.0",
        "drupal/redirect": "^1.0@beta",
        "drupal/restui": "^1.16",
        "drupal/rules": "^3.x-dev",
        "drupal/s3fs": "^3.0@alpha",
        "drupal/search_api": "^1.15",
        "drupal/search_api_autocomplete": "^1.4",
        "drupal/search_api_location": "^1.0@alpha",
        "drupal/search_api_sorts": "^1.0",
        "drupal/slick": "^2.7@beta",
        "drupal/slick_views": "^2.7@beta",
        "drupal/smart_date": "^4.0@beta",
        "drupal/smart_trim": "^2.0",
        "drupal/svg_image": "^3.0",
        "drupal/token": "^1.1",
        "drupal/tokenuuid": "^2.0",
        "drupal/twig_field_value": "^2.0",
        "drupal/twig_tweak": "^3.0",
        "drupal/upgrade_status": "^4.0",
        "drupal/views_bulk_operations": "^4.0",
        "drupal/views_infinite_scroll": "^2.0",
        "drupal/votingapi": "^3.0@beta",
        "drupal/webform": "^6.2@beta",
        "drupal/workbench": "^1.1",
        "drush/drush": "^11",
        "enyo/dropzone": "~4.3",
        "fengyuanchen/cropper": "^4.0",
        "gasparesganga/php-shapefile": "^3.4",
        "google/charts": "45",
        "jackmoore/colorbox": "~1",
        "kenwheeler/slick": "~1.9.0",
        "michaeldrennen/robinhood": "^1.1",
        "mnsami/composer-custom-directory-installer": "^2.0",
        "php-http/httplug": "^2.0",
        "phpunit/phpunit": "^8.0",
        "recurser/jquery-simple-color": "master",
        "simeydotme/jquery-ui-slider-pips": "^1.11",
        "squizlabs/php_codesniffer": "^3.3",
        "webflo/drupal-finder": "^1.0.0",
        "webmozart/path-util": "^2.3"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "behat/mink-goutte-driver": "~1.2",
        "jcalderonzumba/gastonjs": "~1.0.2",
        "jcalderonzumba/mink-phantomjs-driver": "~0.3.1",
        "mikey179/vfsstream": "~1.2",
        "symfony/css-selector": "~4.0",
        "bex/behat-screenshot": "^2.1",
        "drupal/core-dev": "^9.0",
        "phpstan/extension-installer": "^1.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/console-extend-plugin": true,
            "drupal-composer/drupal-scaffold": true,
            "m7sk/composer-svn-export-plugin": true,
            "wikimedia/composer-merge-plugin": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "mnsami/composer-custom-directory-installer": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
        "classmap": [
            "scripts/composer/ScriptHandler.php"
        ]
    },
    "scripts": {
        "pre-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "pre-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "post-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ],
        "post-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
        ],
        "post-drupal-scaffold-cmd": [
            "patch -p1 < patches/enable_twig_debugging.patch"
        ]
    },
    "extra": {
        "patches-file": "patches/composer.patches.json",
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/robinhood" : ["michaeldrennen/robinhood"],
            "web/libraries/DOMPurify" : ["cure53/dompurify"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/contrib/{$name}": ["type:drupal-drush"]
        },
        "drupal-scaffold": {
            "initial": {
                ".editorconfig": "../.editorconfig",
                ".gitattributes": "../.gitattributes"
            },
            "locations": {
                "web-root": "./web"
            }
        },
        "merge-plugin": {
            "include": [
                "web/modules/contrib/ckeditor_codemirror/composer.libraries.json",
                "web/modules/contrib/webform/composer.libraries.json"
            ]
        }
    }
}
